{
  "name": "hora-astro",
  "version": "1.0.0",
  "description": "Thai-first auspicious, horoscope, calendar, and spiritual knowledge website built with Astro.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "nfr:data": "node scripts/validate-runtime-data.mjs",
    "nfr:visit-info": "node scripts/validate-temple-visit-info.mjs",
    "nfr:performance": "node scripts/check-performance-budget.mjs",
    "nfr:seo": "node scripts/validate-seo.mjs",
    "nfr:vercel": "node scripts/validate-vercel-config.mjs",
    "nfr": "npm run nfr:data && npm run nfr:visit-info && npm run nfr:performance && npm run nfr:seo && npm run nfr:vercel",
    "smoke:production": "node scripts/smoke-production.mjs",
    "db:seed": "node scripts/seed-supabase.mjs",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/e2e/visual.spec.ts --project=chromium-desktop",
    "test:regression": "npm run check && npm run build && npm run nfr && npm run test:e2e"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/purichw/hora-astro.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/purichw/hora-astro/issues"
  },
  "homepage": "https://github.com/purichw/hora-astro#readme",
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "astro": "^6.4.4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "yaml": "^2.8.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0"
  }
}
