---
import { brandAssets } from "../../config/site.js";

type BrandAssetKey = "mark" | "emblem" | "lockup";

const {
  class: className = "brand-mark",
  variant = "mark",
  decorative = false,
  loading = "eager",
  fetchpriority,
} = Astro.props as {
  class?: string;
  variant?: BrandAssetKey;
  decorative?: boolean;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
};

const asset = brandAssets[variant] || brandAssets.mark;
---

<img
  class:list={[className, `brand-mark--${variant}`]}
  src={asset.src}
  width={asset.width}
  height={asset.height}
  alt={decorative ? "" : brandAssets.alt}
  aria-hidden={decorative ? "true" : undefined}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
/>
