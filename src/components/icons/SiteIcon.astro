---
import { Image } from "astro:assets";
import SearchIcon from "./SearchIcon.astro";
import { iconAttributes } from "../../lib/ui-markup.js";
import lotus from "../../assets/loading/lotus.png";
import temple from "../../assets/loading/temple.png";
import stupa from "../../assets/loading/stupa.png";
import altar from "../../assets/loading/altar.png";

export interface Props {
  name: "lotus" | "temple" | "stupa" | "altar" | "route" | "map-pin" | "calendar-days" | "arrow-right" | "chevron-left" | "chevron-right" | "pause" | "play" | "quote" | "search" | "coins" | "sprout" | "sunrise" | "flame" | "hand" | "scroll-text" | "layers-2" | "arrow-left" | "chevron-down" | "leaf" | "ban" | "lightbulb" | "book-open" | "compass" | "orbit" | "moon-star" | "maximize-2";
  class?: string;
}
const { name, class: className } = Astro.props;
const heritage = { lotus, temple, stupa, altar };
const raster = name in heritage ? heritage[name as keyof typeof heritage] : null;
const opticalScale = name === "stupa" ? 1.4 : name === "altar" ? 1.65 : 1.8;
---

<span class:list={["site-icon", className]} aria-hidden="true">
  {raster ? <Image src={raster} width={128} height={128} format="webp" alt="" style={{ "--icon-optical-scale": opticalScale }} />
    : name === "search" ? <SearchIcon />
    : <span {...iconAttributes(name, "site-icon-mask")}></span>}
</span>

<style>
  .site-icon { position: relative; display: inline-grid; place-items: center; flex: none; width: 32px; height: 32px; overflow: hidden; color: var(--site-icon-color, #996b24); }
  .site-icon img { display: block; width: 100%; height: 100%; max-width: none; object-fit: contain; transform: scale(var(--icon-optical-scale)); filter: var(--site-icon-filter, brightness(0) saturate(100%) invert(44%) sepia(57%) saturate(545%) hue-rotate(359deg) brightness(94%) contrast(88%)); }
  .site-icon-mask { width: 100%; height: 100%; }
  .site-icon :global(svg) { width: 100%; height: 100%; }
</style>
