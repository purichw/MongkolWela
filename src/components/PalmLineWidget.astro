      career:      { text: 'นักฝัน มีจินตนาการสูง เหมาะงานสร้างสรรค์ นักเขียน นักดนตรี', level: 'good' },
      personality: { text: 'ลึกซึ้ง ชอบจินตนาการ บางครั้งอยู่ในโลกของตัวเอง มีความไวทางอารมณ์', level: 'neutral' },
