---
// PalmLineWidget.astro
// Interactive palm line reading widget
// Usage: <PalmLineWidget /> — images served from /public/images/lines/
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<div id="plw">
  <div class="plw-header">
    <h2 class="plw-title">ลักษณะเส้นลายมือ</h2>
    <p class="plw-subtitle">รวม 45 ลักษณะจากเส้นหลักและเส้นรอง เลือกเฉพาะลักษณะที่เห็นชัดบนมือ</p>
  </div>
  <div class="plw-body">
    <nav id="plw-sidebar" class="plw-sidebar"></nav>
    <div class="plw-main">
      <div id="plw-grid" class="plw-grid"></div>
      <aside id="plw-detail" class="plw-detail"></aside>
    </div>
  </div>
</div>

<style is:global>
#plw {
  font-family: 'Noto Sans Thai', system-ui, sans-serif;
  background: #0d0d1a;
  color: #e0d8c8;
  border-radius: 16px;
  overflow: hidden;
  max-width: 1100px;
  margin: 0 auto;
  box-shadow: 0 8px 40px rgba(0,0,0,0.6);
}
#plw .plw-header {
  padding: 22px 28px 14px;
  border-bottom: 1px solid #1e1e32;
  background: linear-gradient(135deg, #161628 0%, #0d0d1a 100%);
}
#plw .plw-title {
  font-size: 1.35rem;
  font-weight: 700;
  color: #c9a227;
  margin: 0 0 4px;
}
#plw .plw-subtitle {
  font-size: 0.82rem;
  color: #aaa4b8;
  margin: 0;
}
#plw .plw-body {
  display: flex;
  min-height: 540px;
}

/* ── SIDEBAR ─────────────────────────────── */
#plw .plw-sidebar {
  width: 172px;
  flex-shrink: 0;
  background: #0b0b16;
  border-right: 1px solid #1e1e32;
  padding: 10px 0 20px;
  overflow-y: auto;
}
#plw .plw-group-label {
  font-size: 0.65rem;
  font-weight: 700;
  color: #aaa4b8;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  padding: 16px 16px 5px;
}
#plw .plw-line-btn {
  display: block;
  width: 100%;
  text-align: left;
  padding: 9px 16px;
  font-family: 'Noto Sans Thai', sans-serif;
  font-size: 0.85rem;
  color: #b7b1c2;
  background: none;
  border: none;
  border-left: 3px solid transparent;
  cursor: pointer;
  transition: color 0.12s, background 0.12s, border-color 0.12s;
  line-height: 1.4;
}
#plw .plw-line-btn:hover {
  color: #ccc;
  background: #13132a;
}
#plw .plw-line-btn.plw-active {
  color: #c9a227;
  border-left-color: #c9a227;
  background: #13132a;
  font-weight: 600;
}

/* ── MAIN AREA ───────────────────────────── */
#plw .plw-main {
  flex: 1;
  display: flex;
  min-width: 0;
}

/* ── IMAGE GRID ──────────────────────────── */
#plw .plw-grid {
  flex: 1;
  padding: 16px;
  overflow-y: auto;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(118px, 1fr));
  gap: 10px;
  align-content: start;
}
#plw .plw-card {
  background: #13132a;
  border: 2px solid transparent;
  border-radius: 10px;
  overflow: hidden;
  cursor: pointer;
  transition: border-color 0.18s, transform 0.18s, box-shadow 0.18s;
}
#plw .plw-card:hover {
  border-color: #2e2e50;
  transform: translateY(-2px);
}
#plw .plw-card.plw-active {
  border-color: #c9a227;
  box-shadow: 0 0 18px rgba(201,162,39,0.22);
}
#plw .plw-card img {
  width: 100%;
  aspect-ratio: 3/4;
  object-fit: contain;
  background: #1c1c32;
  display: block;
}
#plw .plw-card-no-img {
  width: 100%;
  aspect-ratio: 3/4;
  background: #181828;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2a2a40;
  font-size: 1.4rem;
}
#plw .plw-card-label {
  font-size: 0.71rem;
  padding: 5px 6px 8px;
  text-align: center;
  color: #bcb6c7;
  line-height: 1.35;
}
#plw .plw-card.plw-active .plw-card-label {
  color: #c9a227;
}

/* ── DETAIL PANEL ────────────────────────── */
#plw .plw-detail {
  width: 276px;
  flex-shrink: 0;
  background: #0b0b16;
  border-left: 1px solid #1e1e32;
  overflow-y: auto;
  padding: 20px 16px 24px;
}
#plw .plw-placeholder {
  color: #aaa4b8;
  font-size: 0.85rem;
  text-align: center;
  margin-top: 60px;
  line-height: 2.2;
}
#plw .plw-detail-img {
  width: 100%;
  max-width: 160px;
  display: block;
  margin: 0 auto 14px;
  border-radius: 8px;
  border: 1px solid #1e1e32;
  background: #1c1c32;
}
#plw .plw-detail-line {
  font-size: 0.95rem;
  font-weight: 700;
  color: #c9a227;
  margin: 0 0 2px;
}
#plw .plw-detail-variant {
  font-size: 0.78rem;
  color: #aaa4b8;
  margin: 0 0 14px;
}
#plw .plw-divider {
  height: 1px;
  background: #1e1e32;
  margin: 0 0 14px;
}
#plw .plw-reading-block {
  margin-bottom: 9px;
  padding: 10px 12px;
  background: #13132a;
  border-radius: 8px;
  border-left: 3px solid #2a2a40;
}
#plw .plw-reading-block.good  { border-left-color: #4caf50; }
#plw .plw-reading-block.warning { border-left-color: #ef5350; }
#plw .plw-reading-block.neutral { border-left-color: #ffc107; }
#plw .plw-reading-cat {
  font-size: 0.7rem;
  font-weight: 700;
  margin: 0 0 5px;
  display: flex;
  align-items: center;
  gap: 5px;
}
#plw .plw-reading-cat.good    { color: #4caf50; }
#plw .plw-reading-cat.warning { color: #ef5350; }
#plw .plw-reading-cat.neutral { color: #ffc107; }
#plw .plw-reading-text {
  font-size: 0.81rem;
  color: #c8c2cc;
  line-height: 1.65;
  margin: 0;
}
#plw .plw-no-reading {
  font-size: 0.78rem;
  color: #aaa4b8;
  text-align: center;
  padding: 16px 0;
  font-style: italic;
}
#plw .plw-disclaimer {
  margin-top: 16px;
  padding: 10px 12px;
  background: #080810;
  border-radius: 6px;
  font-size: 0.68rem;
  color: #aaa4b8;
  text-align: center;
  line-height: 1.8;
  border: 1px solid #13132a;
}

/* ── RESPONSIVE ──────────────────────────── */
@media (max-width: 768px) {
  #plw .plw-body { flex-direction: column; }
  #plw .plw-sidebar {
    width: 100%;
    height: auto;
    border-right: none;
    border-bottom: 1px solid #1e1e32;
    display: flex;
    flex-direction: row;
    overflow-x: auto;
    padding: 8px;
    gap: 4px;
  }
  #plw .plw-group-label { display: none; }
  #plw .plw-line-btn {
    white-space: nowrap;
    border-left: none;
    border-bottom: 2px solid transparent;
    border-radius: 6px;
    flex-shrink: 0;
    padding: 7px 14px;
  }
  #plw .plw-line-btn.plw-active {
    border-left-color: transparent;
    border-bottom-color: #c9a227;
    background: #13132a;
  }
  #plw .plw-main { flex-direction: column; }
  #plw .plw-detail {
    width: 100%;
    border-left: none;
    border-top: 1px solid #1e1e32;
  }
  #plw .plw-grid {
    grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
  }
}
</style>

<script>
// ─────────────────────────────────────────────────────────────
//  DATA
// ─────────────────────────────────────────────────────────────

const LINE_TYPES = [
  {
    id: 'life_line', nameTh: 'เส้นชีวิต', group: 'main',
    variants: [
      { id: 'long_clear',    nameTh: 'ยาวชัดเจน' },
      { id: 'short',         nameTh: 'สั้น' },
      { id: 'broken',        nameTh: 'ขาดตอน' },
      { id: 'chained',       nameTh: 'เป็นลูกโซ่' },
      { id: 'double_mars',   nameTh: 'คู่ขนาน (Line of Mars)' },
