---
// Interactive palm line reading widget. Images are served from /public/images/lines/.
import SiteIcon from "./icons/SiteIcon.astro";
import PalmLineMap from "./PalmLineMap.astro";
import { iconAttributes } from "../lib/ui-markup.js";
---

<section id="plw" class="plw-shell" aria-labelledby="plw-title">
  <div class="plw-intro">
  <div class="plw-settings">
  <header class="plw-header">
    <div>
      <p data-cms-field="9b26a46d-1" class="section-kicker">ตั้งค่าการอ่าน</p>
      <h2 data-cms-field="9b26a46d-2" id="plw-title" class="plw-title">เลือกมือที่ต้องการอ่าน</h2>
      <p data-cms-field="9b26a46d-3" class="plw-subtitle">
        สังเกตเส้นที่เห็นชัด แล้วเทียบกับตัวอย่าง พร้อมอ่านความหมายตามบริบทของมือ
      </p>
    </div>

    <div class="plw-controls">
      <fieldset class="plw-control-group">
        <legend data-cms-field="9b26a46d-4">มือที่ถนัด</legend>
        <div class="plw-segmented" data-plw-handedness>
          <button data-cms-field="9b26a46d-5" type="button" data-handedness="right" aria-pressed="true">ถนัดขวา</button>
          <button data-cms-field="9b26a46d-6" type="button" data-handedness="left" aria-pressed="false">ถนัดซ้าย</button>
        </div>
      </fieldset>

      <fieldset class="plw-control-group">
        <legend data-cms-field="9b26a46d-7">รูปแบบการอ่าน</legend>
        <div class="plw-segmented plw-segmented--mode" data-plw-mode>
          <button data-cms-field="9b26a46d-8" type="button" data-mode="dominant" aria-pressed="true">มือถนัด</button>
          <button data-cms-field="9b26a46d-9" type="button" data-mode="nonDominant" aria-pressed="false">มือไม่ถนัด</button>
          <button data-cms-field="9b26a46d-10" type="button" data-mode="compare" aria-pressed="false">เทียบสองมือ</button>
        </div>
      </fieldset>
    </div>
  </header>

  <div class="plw-context" data-plw-context aria-live="polite"></div>
  <button data-cms-field="9b26a46d-11" class="plw-start-reading" type="button" data-plw-start>เริ่มอ่านลายมือ<SiteIcon name="arrow-right" /></button>
  <p data-cms-field="9b26a46d-12" class="plw-settings-note"><SiteIcon name="shield-check" />ใช้ประกอบการทบทวนตัวเอง ไม่ใช่คำทำนายที่ตายตัว</p>
  </div>
  <PalmLineMap />
  </div>

  <section class="plw-photos" aria-labelledby="plw-photos-title">
    <div class="plw-photos-head">
      <div>
        <h3 data-cms-field="9b26a46d-13" id="plw-photos-title">รูปฝ่ามือของคุณ <small data-cms-field="9b26a46d-14">(ไม่บังคับ)</small></h3>
      </div>
      <p data-cms-field="9b26a46d-15"><SiteIcon name="shield-check" />รูปใช้เทียบด้วยตัวเอง ไม่วิเคราะห์อัตโนมัติและไม่ส่งขึ้นเซิร์ฟเวอร์</p>
    </div>

    <div class="plw-photo-grid">
      {
        (["left", "right"] as const).map((side) => {
          const sideLabel = side === "left" ? "มือซ้าย" : "มือขวา";
          return (
            <article class="plw-photo-card" data-photo-card={side}>
              <div class="plw-photo-card-head">
                <strong data-cms-field="9b26a46d-16">{sideLabel}</strong>
                <span data-cms-field="9b26a46d-17" data-photo-state={side}>ยังไม่มีรูป</span>
              </div>

              <div class="plw-photo-stage" data-photo-dropzone={side} data-photo-empty="true">
                <div class="plw-photo-empty" data-photo-empty-state={side}>
                  <span aria-hidden="true"><SiteIcon name="plus" /></span>
                  <strong data-cms-field="9b26a46d-18">วางไฟล์ที่นี่หรือเลือกไฟล์</strong>
                  <small data-cms-field="9b26a46d-19">JPG, PNG หรือ WebP ไม่เกิน 10 MB</small>
                </div>
                <img data-cms-field="9b26a46d-20"
                  data-photo-preview={side}
                  alt={`รูปฝ่ามือ${sideLabel.replace("มือ", "")}ที่เลือกจากเครื่อง`}
                  hidden
                />
              </div>

              <div class="plw-photo-primary-actions">
                <button data-cms-field="9b26a46d-21" type="button" data-photo-trigger={side} data-photo-source="camera">
                  <span {...iconAttributes("camera")}></span>ถ่ายรูป
                </button>
                <button data-cms-field="9b26a46d-22" type="button" data-photo-trigger={side} data-photo-source="library">
                  <span {...iconAttributes("image")}></span>เลือกไฟล์
                </button>
              </div>

              <div class="plw-photo-edit-actions" data-photo-tools={side} hidden>
                <label>
                  <span data-cms-field="9b26a46d-23">ซูม</span>
                  <input data-cms-field="9b26a46d-24"
                    type="range"
                    min="1"
                    max="2.4"
                    step="0.05"
                    value="1"
                    data-photo-zoom={side}
                  />
                </label>
                <button type="button" data-photo-rotate={side} aria-label={`หมุนรูป${sideLabel}`} title="หมุนรูป"><span {...iconAttributes("rotate-ccw")}></span></button>
                <button type="button" data-photo-remove={side} aria-label={`ลบรูป${sideLabel}`} title="ลบรูป"><span {...iconAttributes("trash")}></span></button>
              </div>

              <input data-cms-field="9b26a46d-25"
                class="plw-photo-input"
                type="file"
                accept="image/*"
                capture="environment"
                data-photo-input={side}
                data-photo-source="camera"
                aria-label={`ถ่ายรูป${sideLabel}`}
                tabindex="-1"
              />
              <input data-cms-field="9b26a46d-26"
                class="plw-photo-input"
                type="file"
                accept="image/jpeg,image/png,image/webp"
                data-photo-input={side}
                data-photo-source="library"
                aria-label={`เลือกไฟล์รูป${sideLabel}`}
                tabindex="-1"
              />
              <p class="plw-photo-message" data-photo-message={side} aria-live="polite"></p>
            </article>
          );
        })
      }
    </div>

    <div class="plw-camera-panel" data-camera-panel hidden>
      <div class="plw-camera-dialog" role="dialog" aria-modal="true" aria-labelledby="plw-camera-title">
        <div class="plw-camera-head">
          <div>
            <p data-cms-field="9b26a46d-27" class="section-kicker">ถ่ายรูปฝ่ามือ</p>
            <h4 data-cms-field="9b26a46d-28" id="plw-camera-title" data-camera-title>ถ่ายรูปฝ่ามือ</h4>
          </div>
          <button type="button" data-camera-close aria-label="ปิดกล้อง" title="ปิดกล้อง"><SiteIcon name="x" /></button>
        </div>
        <div class="plw-camera-frame">
          <video data-camera-video autoplay playsinline muted></video>
          <canvas data-camera-canvas hidden></canvas>
        </div>
        <p class="plw-camera-message" data-camera-message aria-live="polite"></p>
        <div class="plw-camera-actions">
          <button data-cms-field="9b26a46d-29" type="button" data-camera-capture disabled>ใช้รูปนี้</button>
          <button data-cms-field="9b26a46d-30" type="button" data-camera-cancel>ยกเลิก</button>
        </div>
      </div>
    </div>
  </section>
  <p class="plw-photo-tip"><SiteIcon name="lightbulb" /><span data-cms-field="9b26a46d-31">ถ่ายในแสงสว่าง ให้เห็นทั้งฝ่ามือและแนวเส้นชัด ไม่ใช้ฟิลเตอร์</span></p>

  <div class="plw-body">
    <nav id="plw-sidebar" class="plw-sidebar" aria-label="ประเภทเส้นลายมือ"></nav>
    <div class="plw-main">
      <section class="plw-picker" aria-labelledby="plw-picker-title">
        <div class="plw-picker-head">
          <div>
            <h3 data-cms-field="9b26a46d-32" id="plw-picker-title" data-plw-line-title>เส้นชีวิต</h3>
            <p class="plw-picker-description" data-plw-line-description></p>
          </div>
          <div class="plw-hand-key" data-plw-hand-key></div>
        </div>
        <div id="plw-grid" class="plw-grid"></div>
        <button data-cms-field="9b26a46d-33" class="plw-show-all" type="button" data-plw-show-all aria-expanded="false" aria-controls="plw-grid">ดูรูปแบบทั้งหมด<SiteIcon name="chevron-down" /></button>
      </section>
      <aside id="plw-detail" class="plw-detail" aria-live="polite"></aside>
    </div>
  </div>
</section>

<script>
import { sitePlaceholderImage } from "../lib/image-placeholder.js";
import { renderIcon } from "../lib/ui-markup.js";
// ─────────────────────────────────────────────────────────────
//  DATA
// ─────────────────────────────────────────────────────────────

import { LINE_TYPES, IMG_INDEX, READINGS, CATEGORIES, GROUP_LABELS } from "../data/palm-reader-content.js";

const COMPARISON_PROFILES = {
  life_line: {
    long_clear: { dimension: 'ความชัดและความต่อเนื่อง', rank: 3 },
    chained: { dimension: 'ความชัดและความต่อเนื่อง', rank: 1 },
    broken: { dimension: 'ความชัดและความต่อเนื่อง', rank: 0 },
  },
  head_line: {
    straight_long: { dimension: 'ความต่อเนื่องของแนวคิด', rank: 3 },
    broken: { dimension: 'ความต่อเนื่องของแนวคิด', rank: 0 },
  },
  heart_line: {
    long_curved: { dimension: 'ความต่อเนื่องทางอารมณ์', rank: 3 },
    long_straight: { dimension: 'ความต่อเนื่องทางอารมณ์', rank: 3 },
    wavy: { dimension: 'ความต่อเนื่องทางอารมณ์', rank: 1 },
    broken: { dimension: 'ความต่อเนื่องทางอารมณ์', rank: 0 },
  },
  fate_line: {
    clear_from_wrist: { dimension: 'ความชัดของแกนชีวิต', rank: 3 },
    broken: { dimension: 'ความชัดของแกนชีวิต', rank: 1 },
    absent: { dimension: 'ความชัดของแกนชีวิต', rank: 0 },
  },
  sun_line: {
    clear_present: { dimension: 'ความชัดของเส้นอาทิตย์', rank: 3 },
    short: { dimension: 'ความชัดของเส้นอาทิตย์', rank: 2 },
    absent: { dimension: 'ความชัดของเส้นอาทิตย์', rank: 0 },
  },
  mercury_line: {
    clear_straight: { dimension: 'ความชัดของเส้นพุธ', rank: 2 },
    wavy: { dimension: 'ความชัดของเส้นพุธ', rank: 1 },
  },
  marriage_line: {},
};

type LineTypeId = keyof typeof IMG_INDEX;
type Reading = { text: string; level: string };
type HandRole = 'dominant' | 'nonDominant';
type ReadingMode = HandRole | 'compare';
type PhysicalHandSide = 'left' | 'right';
type PalmPhotoState = {
  url: string | null;
  name: string;
  rotation: number;
  zoom: number;
};

let activeLine: LineTypeId = 'life_line';
let handedness: 'right' | 'left' = 'right';
let readingMode: ReadingMode = 'dominant';
const PALM_LINE_IMAGE_VERSION = '20260612-06';
const MAX_PALM_PHOTO_BYTES = 10 * 1024 * 1024;
const ALLOWED_PALM_PHOTO_TYPES = new Set(['image/jpeg', 'image/png', 'image/webp']);
const selections: Record<HandRole, Partial<Record<LineTypeId, string>>> = {
  dominant: {},
  nonDominant: {},
};
const palmPhotos: Record<PhysicalHandSide, PalmPhotoState> = {
  left: { url: null, name: '', rotation: 0, zoom: 1 },
  right: { url: null, name: '', rotation: 0, zoom: 1 },
};
let activeCameraSide: PhysicalHandSide | null = null;
let palmCameraStream: MediaStream | null = null;

function imgSrc(lineType: LineTypeId, variantId: string) {
  const variants = IMG_INDEX[lineType] as Record<string, string>;
  const filename = variants[variantId];
  return filename ? `/images/lines/${filename}?v=${PALM_LINE_IMAGE_VERSION}` : null;
}

function physicalHandSide(role: HandRole) {
  if (role === 'dominant') return handedness === 'right' ? 'right' : 'left';
  return handedness === 'right' ? 'left' : 'right';
}

function physicalHand(role: HandRole) {
  return physicalHandSide(role) === 'right' ? 'มือขวา' : 'มือซ้าย';
}

function handLabel(role: HandRole) {
  return `${physicalHand(role)} · ${role === 'dominant' ? 'มือถนัด' : 'มือไม่ถนัด'}`;
}

function handImageClass(role?: HandRole) {
  const side = role ? physicalHandSide(role) : 'right';
  return `plw-hand-image plw-hand-image--${side}`;
}

function renderHandImage(src: string | null, alt: string, role?: HandRole) {
  return `<img src="${src || sitePlaceholderImage}" alt="${src ? escapeHtml(alt) : "ภาพประกอบแทนรูปที่ยังไม่มี"}" loading="lazy" class="${handImageClass(role)}" data-fallback-src="${sitePlaceholderImage}" />`;
}

function getLineType(lineId: LineTypeId) {
  return LINE_TYPES.find(line => line.id === lineId);
}

function getVariant(lineId: LineTypeId, variantId?: string) {
  return getLineType(lineId)?.variants.find(variant => variant.id === variantId);
}

function getReadings(lineId: LineTypeId, variantId?: string) {
  if (!variantId) return {};
  const lineReadings = READINGS[lineId] as Record<string, Record<string, Reading>>;
  return lineReadings[variantId] ?? {};
}

function contextText(role: HandRole) {
  if (role === 'dominant') {
    return 'เมื่อพบในมือถนัด ความหมายนี้เน้นสิ่งที่กำลังแสดงออกผ่านการตัดสินใจ พฤติกรรม และวิถีชีวิตปัจจุบัน';
  }
  return 'เมื่อพบในมือไม่ถนัด ความหมายนี้เน้นพื้นฐานเดิม ธรรมชาติภายใน และแนวโน้มที่ติดตัวมาก่อนการปรับตัว';
}

function comparisonResult(nonDominantId: string, dominantId: string) {
  if (nonDominantId === dominantId) {
    return {
      state: 'same',
      title: 'พื้นฐานและการแสดงออกไปในทิศเดียวกัน',
      text: 'ลักษณะเดียวกันปรากฏทั้งสองมือ จึงใช้เป็นสัญญาณยืนยันว่าธรรมชาติภายในกับสิ่งที่แสดงออกในปัจจุบันค่อนข้างสอดคล้องกัน',
    };
  }

  const lineProfiles = COMPARISON_PROFILES[activeLine] as
    | Record<string, { dimension: string; rank: number }>
    | undefined;
  const before = lineProfiles?.[nonDominantId];
  const current = lineProfiles?.[dominantId];

  if (before && current && before.dimension === current.dimension) {
    if (current.rank > before.rank) {
      return {
        state: 'stronger',
        title: `${before.dimension}เด่นขึ้นในมือถนัด`,
        text: 'เมื่อเทียบกับพื้นฐานเดิม มือถนัดแสดงความชัดหรือความต่อเนื่องมากขึ้น ตำราจึงอ่านเป็นพัฒนาการที่เกิดจากการใช้ชีวิตและการปรับตัว',
      };
    }
    if (current.rank < before.rank) {
      return {
        state: 'weaker',
        title: `${before.dimension}อ่อนลงในมือถนัด`,
        text: 'มือถนัดมีความชัดหรือความต่อเนื่องน้อยกว่าพื้นฐานเดิม ควรอ่านเป็นจุดที่ต้องทบทวนบริบทชีวิต ไม่ใช่คำตัดสินว่าจะเกิดเรื่องร้าย',
      };
    }
  }

  return {
    state: 'changed',
    title: 'รูปแบบเปลี่ยนไปจากพื้นฐานเดิม',
    text: 'ลักษณะสองมือเป็นคนละรูปแบบและไม่อยู่บนสเกลเดียวกัน จึงควรอ่านว่าแนวทางการแสดงออกเปลี่ยนไป โดยไม่ตัดสินว่าดีกว่าหรือแย่กว่า',
  };
}

function escapeHtml(value: unknown) {
  return String(value)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

function renderSidebar() {
  const sidebar = document.getElementById('plw-sidebar');
  if (!sidebar) return;

  let html = '';
  for (const [groupId, groupLabel] of Object.entries(GROUP_LABELS)) {
    html += `<div class="plw-group-label">${groupLabel}</div>`;
    LINE_TYPES.filter(l => l.group === groupId).forEach(l => {
      const active = l.id === activeLine ? ' plw-active' : '';
      const dominantDone = Boolean(selections.dominant[l.id as LineTypeId]);
      const nonDominantDone = Boolean(selections.nonDominant[l.id as LineTypeId]);
      const complete =
        readingMode === 'compare'
          ? dominantDone && nonDominantDone
          : Boolean(selections[readingMode][l.id as LineTypeId]);
      html += `
        <button class="plw-line-btn${active}" type="button" data-line="${l.id}" aria-pressed="${l.id === activeLine}">
          <span>${l.nameTh}</span>
          ${complete ? '<b aria-label="เลือกแล้ว">เลือกแล้ว</b>' : ''}
        </button>`;
    });
  }
  sidebar.innerHTML = html;
  sidebar.querySelectorAll<HTMLButtonElement>('.plw-line-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      activeLine = btn.dataset.line as LineTypeId;
      renderAll();
    });
  });
}

function renderContext() {
  const context = document.querySelector<HTMLElement>('[data-plw-context]');
  const handKey = document.querySelector<HTMLElement>('[data-plw-hand-key]');
  const lineTitle = document.querySelector<HTMLElement>('[data-plw-line-title]');
  if (!context || !handKey || !lineTitle) return;

  lineTitle.textContent = getLineType(activeLine)?.nameTh ?? 'เส้นลายมือ';
  const description = document.querySelector<HTMLElement>('[data-plw-line-description]');
  const descriptions: Record<string, string> = {
    life_line: 'พื้นฐานพลังและจังหวะชีวิต ไม่ใช่การบอกอายุขัย',
    head_line: 'แนวคิด การตัดสินใจ และมุมมองต่อสิ่งต่าง ๆ',
    heart_line: 'อารมณ์ ความผูกพัน และความสัมพันธ์',
    fate_line: 'เส้นทางชีวิต หน้าที่ และการงาน',
    sun_line: 'ผลงาน การแสดงออก และการยอมรับ',
    mercury_line: 'การสื่อสารและการปรับตัวตามตำรา',
    marriage_line: 'แนวทางความผูกพันตามความเชื่อ',
  };
  if (description) description.textContent = descriptions[activeLine] || '';

  if (readingMode === 'compare') {
    context.innerHTML = `
      <strong>เทียบสองมือ</strong>
      <span>${escapeHtml(handLabel('nonDominant'))} ใช้อ่านพื้นฐานเดิม</span>
      <span>${escapeHtml(handLabel('dominant'))} ใช้อ่านสิ่งที่พัฒนาและชีวิตปัจจุบัน</span>
    `;
    handKey.innerHTML = `
      <span class="plw-key plw-key--base">${escapeHtml(physicalHand('nonDominant'))} · พื้นฐาน</span>
      <span class="plw-key plw-key--current">${escapeHtml(physicalHand('dominant'))} · ปัจจุบัน</span>
    `;
    return;
  }

  context.innerHTML = `
    <strong>${escapeHtml(handLabel(readingMode))}</strong>
    <span>${escapeHtml(contextText(readingMode))}</span>
  `;
  handKey.innerHTML = `<span class="plw-key">${escapeHtml(handLabel(readingMode))}</span>`;
}

function renderGrid() {
  const grid = document.getElementById('plw-grid');
  if (!grid) return;

  const lineType = getLineType(activeLine);
  if (!lineType) return;

  grid.innerHTML = lineType.variants.map(v => {
    const src = imgSrc(activeLine, v.id);
    const dominantActive = selections.dominant[activeLine] === v.id;
    const nonDominantActive = selections.nonDominant[activeLine] === v.id;
    const singleActive = readingMode !== 'compare' && selections[readingMode][activeLine] === v.id;
    const active = (readingMode === 'compare' ? dominantActive || nonDominantActive : singleActive) ? ' plw-active' : '';

    if (readingMode === 'compare') {
      return `
        <article class="plw-card${active}" data-variant="${v.id}">
          <div class="plw-card-compare-images" aria-label="ตัวอย่าง${escapeHtml(v.nameTh)}บนฝ่ามือทั้งสองข้าง">
            ${renderHandImage(src, `${v.nameTh}บน${physicalHand('nonDominant')}`, 'nonDominant')}
            ${renderHandImage(src, `${v.nameTh}บน${physicalHand('dominant')}`, 'dominant')}
          </div>
          <div class="plw-card-label">${v.nameTh}</div>
          <div class="plw-card-actions">
            <button class="${nonDominantActive ? 'is-selected' : ''}" type="button" data-select-hand="nonDominant" aria-pressed="${nonDominantActive}">
              ${escapeHtml(physicalHand('nonDominant'))}
            </button>
            <button class="${dominantActive ? 'is-selected' : ''}" type="button" data-select-hand="dominant" aria-pressed="${dominantActive}">
              ${escapeHtml(physicalHand('dominant'))}
            </button>
          </div>
        </article>`;
    }

    return `
      <button class="plw-card plw-card--single${active}" type="button" data-variant="${v.id}" data-select-hand="${readingMode}" aria-pressed="${singleActive}">
        ${renderHandImage(src, `${v.nameTh}บน${physicalHand(readingMode)}`, readingMode)}
        <div class="plw-card-label">${v.nameTh}</div>
      </button>`;
  }).join('');

  grid.querySelectorAll<HTMLButtonElement>('[data-select-hand]').forEach(button => {
    button.addEventListener('click', () => {
      const card = button.closest<HTMLElement>('[data-variant]');
      const role = button.dataset.selectHand as HandRole;
      const variantId = card?.dataset.variant;
      if (!variantId || !role) return;
      selections[role][activeLine] = variantId;
      renderAll();
    });
  });
}

function renderDetail() {
  const detail = document.getElementById('plw-detail');
  if (!detail) return;

  if (readingMode === 'compare') {
    renderComparison(detail);
    return;
  }

  const selectedId = selections[readingMode][activeLine];
  if (!selectedId) {
    detail.innerHTML = `
      <div class="plw-placeholder">
        ${renderIcon('hand')}
        <strong>เลือกภาพที่ตรงกับมือ</strong>
        <span>คำอ่านจะประกอบจากความหมายพื้นฐานของเส้น และบริบทของ${readingMode === 'dominant' ? 'มือถนัด' : 'มือไม่ถนัด'}</span>
      </div>`;
    return;
  }

  detail.innerHTML = renderSingleReading(readingMode, selectedId);
}

function renderSingleReading(role: HandRole, variantId: string) {
  const lineType = getLineType(activeLine);
  const variant = getVariant(activeLine, variantId);
  const readings = getReadings(activeLine, variantId);
  const src = imgSrc(activeLine, variantId);
  const readingBlocks = CATEGORIES.map(category => {
    const reading = readings[category.id];
    if (!reading) return '';
    return `
      <div class="plw-reading-block ${reading.level}">
        <div class="plw-reading-cat">${category.nameTh}</div>
        <p class="plw-reading-text">${escapeHtml(reading.text)}</p>
        <p class="plw-reading-context">${escapeHtml(contextText(role))}</p>
      </div>`;
  }).join('');

  return `
    <div class="plw-detail-heading">
      ${src ? `<img src="${src}" alt="${escapeHtml(`${variant?.nameTh ?? ''}บน${physicalHand(role)}`)}" class="plw-detail-img ${handImageClass(role)}" />` : ''}
      <div>
        <span>${escapeHtml(lineType?.nameTh)}</span>
        <h3>${escapeHtml(variant?.nameTh)}</h3>
        <small>${escapeHtml(handLabel(role))}</small>
      </div>
    </div>
    <div class="plw-formula" aria-label="วิธีประกอบคำอ่าน">
      <span>ความหมายพื้นฐาน</span><b>+</b><span>บริบทของมือ</span>
    </div>
    ${readingBlocks || '<div class="plw-no-reading">ยังไม่มีคำอ่านสำหรับลักษณะนี้</div>'}
    ${renderDisclaimer()}
  `;
}

function renderComparison(detail: HTMLElement) {
  const baseId = selections.nonDominant[activeLine];
  const currentId = selections.dominant[activeLine];

  if (!baseId || !currentId) {
    const missing = !baseId && !currentId
      ? 'เลือกหนึ่งลักษณะให้มือทั้งสองข้าง'
      : `เหลือเลือก${!baseId ? handLabel('nonDominant') : handLabel('dominant')}`;
    detail.innerHTML = `
      <div class="plw-placeholder">
        <strong>${escapeHtml(missing)}</strong>
        <span>ใช้ปุ่มใต้ภาพเพื่อกำหนดลักษณะของแต่ละมือ แล้วระบบจะเทียบพื้นฐานเดิมกับสิ่งที่แสดงออกในปัจจุบัน</span>
      </div>`;
    return;
  }

  const lineType = getLineType(activeLine);
  const baseVariant = getVariant(activeLine, baseId);
  const currentVariant = getVariant(activeLine, currentId);
  const comparison = comparisonResult(baseId, currentId);

  detail.innerHTML = `
    <div class="plw-comparison-pair">
      ${renderComparisonHand('nonDominant', baseId)}
      ${renderComparisonHand('dominant', currentId)}
    </div>
    <section class="plw-comparison-result plw-comparison-result--${comparison.state}">
      <p class="section-kicker">ผลการเปรียบเทียบ</p>
      <h3>${escapeHtml(comparison.title)}</h3>
      <p>${escapeHtml(comparison.text)}</p>
    </section>
    <div class="plw-formula" aria-label="วิธีประกอบคำอ่าน">
      <span>${escapeHtml(baseVariant?.nameTh)}</span><b>+</b>
      <span>${escapeHtml(currentVariant?.nameTh)}</span><b>=</b>
      <span>พัฒนาการของ${escapeHtml(lineType?.nameTh)}</span>
    </div>
    <div class="plw-compare-readings">
      ${renderBaseMeaning('พื้นฐานเดิม', baseId)}
      ${baseId === currentId ? renderSameCurrentMeaning(currentId) : renderBaseMeaning('การแสดงออกปัจจุบัน', currentId)}
    </div>
    ${renderDisclaimer()}
  `;
}

function renderComparisonHand(role: HandRole, variantId: string) {
  const variant = getVariant(activeLine, variantId);
  const src = imgSrc(activeLine, variantId);
  return `
    <article>
      ${src ? `<img src="${src}" alt="${escapeHtml(`${variant?.nameTh ?? ''}บน${physicalHand(role)}`)}" class="${handImageClass(role)}" />` : ''}
      <span>${escapeHtml(handLabel(role))}</span>
      <strong>${escapeHtml(variant?.nameTh)}</strong>
    </article>`;
}

function renderBaseMeaning(label: string, variantId: string) {
  const variant = getVariant(activeLine, variantId);
  const readings = getReadings(activeLine, variantId);
  const items = CATEGORIES.map(category => {
    const reading = readings[category.id];
    if (!reading) return '';
    return `<li><b>${category.nameTh}</b><span>${escapeHtml(reading.text)}</span></li>`;
  }).join('');

  return `
    <section class="plw-base-meaning">
      <span>${escapeHtml(label)}</span>
      <h4>${escapeHtml(variant?.nameTh)}</h4>
      <ul>${items || '<li><span>ยังไม่มีคำอ่านสำหรับลักษณะนี้</span></li>'}</ul>
    </section>`;
}

function renderSameCurrentMeaning(variantId: string) {
  const variant = getVariant(activeLine, variantId);
  return `
    <section class="plw-base-meaning plw-base-meaning--same-current">
      <span>การแสดงออกปัจจุบัน</span>
      <h4>${escapeHtml(variant?.nameTh)}</h4>
      <p>
        ลักษณะเดียวกับพื้นฐานเดิม ความหมายหลักจึงเหมือนกัน
        แต่เมื่ออยู่ในมือถนัดจะเน้นสิ่งที่กำลังแสดงผ่านพฤติกรรม
        การตัดสินใจ และวิถีชีวิตตอนนี้
      </p>
    </section>`;
}

function renderDisclaimer() {
  return `
    <div class="plw-disclaimer">
      ใช้เพื่อสำรวจตนเองตามความเชื่อด้านหัตถศาสตร์ ไม่ใช่คำวินิจฉัยสุขภาพหรือคำทำนายที่แน่นอน
    </div>`;
}

function photoSideLabel(side: PhysicalHandSide) {
  return side === 'left' ? 'มือซ้าย' : 'มือขวา';
}

function setPhotoMessage(side: PhysicalHandSide, message: string, isError = false) {
  const element = document.querySelector<HTMLElement>(`[data-photo-message="${side}"]`);
  if (!element) return;
  element.textContent = message;
  element.classList.toggle('is-error', isError);
}

function setCameraMessage(message: string, isError = false) {
  const element = document.querySelector<HTMLElement>('[data-camera-message]');
  if (!element) return;
  element.textContent = message;
  element.classList.toggle('is-error', isError);
}

function setCameraCaptureEnabled(enabled: boolean) {
  const button = document.querySelector<HTMLButtonElement>('[data-camera-capture]');
  if (button) button.disabled = !enabled;
}

function renderPalmPhoto(side: PhysicalHandSide) {
  const state = palmPhotos[side];
  const card = document.querySelector<HTMLElement>(`[data-photo-card="${side}"]`);
  const stage = document.querySelector<HTMLElement>(`[data-photo-dropzone="${side}"]`);
  const empty = document.querySelector<HTMLElement>(`[data-photo-empty-state="${side}"]`);
  const preview = document.querySelector<HTMLImageElement>(`[data-photo-preview="${side}"]`);
  const tools = document.querySelector<HTMLElement>(`[data-photo-tools="${side}"]`);
  const status = document.querySelector<HTMLElement>(`[data-photo-state="${side}"]`);
  const zoom = document.querySelector<HTMLInputElement>(`[data-photo-zoom="${side}"]`);
  if (!card || !stage || !empty || !preview || !tools || !status || !zoom) return;

  const hasPhoto = Boolean(state.url);
  stage.dataset.photoEmpty = String(!hasPhoto);
  card.classList.toggle('has-photo', hasPhoto);
  empty.hidden = hasPhoto;
  preview.hidden = !hasPhoto;
  tools.hidden = !hasPhoto;
  status.textContent = hasPhoto ? state.name : 'ยังไม่มีรูป';
  zoom.value = String(state.zoom);

  if (state.url) {
    preview.src = state.url;
    preview.style.transform = `scale(${state.zoom}) rotate(${state.rotation}deg)`;
  } else {
    preview.removeAttribute('src');
    preview.style.removeProperty('transform');
  }
}

function clearPalmPhoto(side: PhysicalHandSide, message = '') {
  const state = palmPhotos[side];
  if (state.url) URL.revokeObjectURL(state.url);
  palmPhotos[side] = { url: null, name: '', rotation: 0, zoom: 1 };
  document
    .querySelectorAll<HTMLInputElement>(`[data-photo-input="${side}"]`)
    .forEach(input => {
      input.value = '';
    });
  renderPalmPhoto(side);
  setPhotoMessage(side, message);
}

function usePalmPhoto(side: PhysicalHandSide, file?: File) {
  if (!file) return;

  if (!ALLOWED_PALM_PHOTO_TYPES.has(file.type)) {
    setPhotoMessage(side, 'ใช้ไฟล์ JPG, PNG หรือ WebP เท่านั้น', true);
    return;
  }

  if (file.size > MAX_PALM_PHOTO_BYTES) {
    setPhotoMessage(side, 'รูปต้องมีขนาดไม่เกิน 10 MB', true);
    return;
  }

  const previousUrl = palmPhotos[side].url;
  palmPhotos[side] = {
    url: URL.createObjectURL(file),
    name: file.name || `รูป${photoSideLabel(side)}`,
    rotation: 0,
    zoom: 1,
  };
  if (previousUrl) URL.revokeObjectURL(previousUrl);
  renderPalmPhoto(side);
  setPhotoMessage(side, `พร้อมใช้เป็นภาพอ้างอิง${photoSideLabel(side)}`);
}

function canUseLiveCamera() {
  return Boolean(window.isSecureContext && navigator.mediaDevices?.getUserMedia);
}

function stopPalmCamera() {
  palmCameraStream?.getTracks().forEach(track => track.stop());
  palmCameraStream = null;
  const video = document.querySelector<HTMLVideoElement>('[data-camera-video]');
  if (video) video.srcObject = null;
}

function closePalmCamera(message = '') {
  stopPalmCamera();
  const panel = document.querySelector<HTMLElement>('[data-camera-panel]');
  const side = activeCameraSide;
  activeCameraSide = null;
  if (panel) panel.hidden = true;
  setCameraMessage('');
  setCameraCaptureEnabled(false);
  if (side && message) setPhotoMessage(side, message);
}

async function openPalmCamera(side: PhysicalHandSide) {
  if (!canUseLiveCamera()) {
    const input = document.querySelector<HTMLInputElement>(
      `[data-photo-input="${side}"][data-photo-source="camera"]`,
    );
    input?.click();
    return;
  }

  const panel = document.querySelector<HTMLElement>('[data-camera-panel]');
  const title = document.querySelector<HTMLElement>('[data-camera-title]');
  const video = document.querySelector<HTMLVideoElement>('[data-camera-video]');
  if (!panel || !title || !video) return;

  activeCameraSide = side;
  panel.hidden = false;
  title.textContent = `ถ่ายรูป${photoSideLabel(side)}`;
  setCameraMessage('กำลังขอสิทธิ์เปิดกล้อง...');
  setCameraCaptureEnabled(false);
  stopPalmCamera();

  try {
    const stream = await navigator.mediaDevices.getUserMedia({
      video: { facingMode: { ideal: 'environment' } },
      audio: false,
    });
    if (activeCameraSide !== side) {
      stream.getTracks().forEach(track => track.stop());
      return;
    }
    palmCameraStream = stream;
    video.srcObject = stream;
    await video.play().catch(() => undefined);
    setCameraCaptureEnabled(true);
    setCameraMessage('จัดฝ่ามือให้อยู่ในกรอบ แล้วกดใช้รูปนี้');
  } catch {
    setCameraCaptureEnabled(false);
    setCameraMessage('เปิดกล้องไม่ได้ ลองอนุญาตกล้องในเบราว์เซอร์ หรือใช้ปุ่มเลือกรูปแทน', true);
    setPhotoMessage(side, 'เปิดกล้องไม่ได้ ใช้ปุ่มเลือกรูปแทนได้', true);
  }
}

function capturePalmCameraPhoto() {
  const side = activeCameraSide;
  const video = document.querySelector<HTMLVideoElement>('[data-camera-video]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-camera-canvas]');
  if (!side || !video || !canvas || !palmCameraStream) return;

  const width = video.videoWidth || 1280;
  const height = video.videoHeight || 960;
  canvas.width = width;
  canvas.height = height;
  const context = canvas.getContext('2d');
  if (!context) {
    setCameraMessage('จับภาพไม่ได้ ลองใช้ปุ่มเลือกรูปแทน', true);
    return;
  }

  context.drawImage(video, 0, 0, width, height);
  canvas.toBlob(blob => {
    if (!blob) {
      setCameraMessage('จับภาพไม่ได้ ลองใช้ปุ่มเลือกรูปแทน', true);
      return;
    }
    const timestamp = new Date().toISOString().replace(/[:.]/g, '-');
    const file = new File([blob], `รูป${photoSideLabel(side)}-${timestamp}.jpg`, { type: 'image/jpeg' });
    usePalmPhoto(side, file);
    closePalmCamera('ถ่ายรูปแล้ว ใช้เป็นภาพอ้างอิงในหน้านี้เท่านั้น');
  }, 'image/jpeg', 0.92);
}

function initPalmPhotos() {
  document.querySelectorAll<HTMLButtonElement>('[data-photo-trigger]').forEach(button => {
    button.addEventListener('click', () => {
      const side = button.dataset.photoTrigger as PhysicalHandSide;
      const source = button.dataset.photoSource;
      if (source === 'camera') {
        void openPalmCamera(side);
        return;
      }
      const input = document.querySelector<HTMLInputElement>(
        `[data-photo-input="${side}"][data-photo-source="${source}"]`,
      );
      input?.click();
    });
  });

  document.querySelectorAll<HTMLInputElement>('[data-photo-input]').forEach(input => {
    input.addEventListener('change', () => {
      const side = input.dataset.photoInput as PhysicalHandSide;
      usePalmPhoto(side, input.files?.[0]);
    });
  });

  document.querySelectorAll<HTMLInputElement>('[data-photo-zoom]').forEach(input => {
    input.addEventListener('input', () => {
      const side = input.dataset.photoZoom as PhysicalHandSide;
      palmPhotos[side].zoom = Number(input.value);
      renderPalmPhoto(side);
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-photo-rotate]').forEach(button => {
    button.addEventListener('click', () => {
      const side = button.dataset.photoRotate as PhysicalHandSide;
      palmPhotos[side].rotation = (palmPhotos[side].rotation + 90) % 360;
      renderPalmPhoto(side);
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-photo-remove]').forEach(button => {
    button.addEventListener('click', () => {
      clearPalmPhoto(button.dataset.photoRemove as PhysicalHandSide, 'ลบรูปออกแล้ว');
    });
  });

  document.querySelectorAll<HTMLElement>('[data-photo-dropzone]').forEach(dropzone => {
    const side = dropzone.dataset.photoDropzone as PhysicalHandSide;
    dropzone.addEventListener('dragover', event => {
      event.preventDefault();
      dropzone.classList.add('is-dragging');
    });
    dropzone.addEventListener('dragleave', () => dropzone.classList.remove('is-dragging'));
    dropzone.addEventListener('drop', event => {
      event.preventDefault();
      dropzone.classList.remove('is-dragging');
      usePalmPhoto(side, event.dataTransfer?.files[0]);
    });
  });

  document.querySelector<HTMLButtonElement>('[data-camera-capture]')?.addEventListener('click', () => {
    capturePalmCameraPhoto();
  });
  document.querySelectorAll<HTMLButtonElement>('[data-camera-close], [data-camera-cancel]').forEach(button => {
    button.addEventListener('click', () => closePalmCamera('ปิดกล้องแล้ว'));
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && activeCameraSide) closePalmCamera('ปิดกล้องแล้ว');
  });

  window.addEventListener('pagehide', () => {
    stopPalmCamera();
    (Object.keys(palmPhotos) as PhysicalHandSide[]).forEach(side => {
      if (palmPhotos[side].url) URL.revokeObjectURL(palmPhotos[side].url);
    });
  }, { once: true });
}

function renderAll() {
  const focused = document.activeElement as HTMLElement | null;
  const focusedLine = focused?.dataset.line;
  const focusedRole = focused?.dataset.selectHand;
  const focusedVariant = focused?.closest<HTMLElement>('[data-variant]')?.dataset.variant;
  renderSidebar();
  renderContext();
  renderGrid();
  renderDetail();
  renderMap();
  if (focusedLine) document.querySelector<HTMLButtonElement>(`[data-line="${focusedLine}"]`)?.focus({ preventScroll: true });
  else if (focusedRole && focusedVariant) document.querySelector<HTMLButtonElement>(`[data-variant="${focusedVariant}"][data-select-hand="${focusedRole}"], [data-variant="${focusedVariant}"] [data-select-hand="${focusedRole}"]`)?.focus({ preventScroll: true });
}

let mapHand: 'left' | 'right' = 'right';

function renderMap() {
  if (readingMode !== 'compare') mapHand = readingMode === 'dominant' ? handedness : handedness === 'right' ? 'left' : 'right';
  document.querySelector('[data-map-palm]')?.setAttribute('transform', mapHand === 'left' ? 'translate(700 0) scale(-1 1)' : 'translate(-20 0)');
  document.querySelectorAll<HTMLElement>('[data-map-hand]').forEach(button => button.setAttribute('aria-pressed', String(button.dataset.mapHand === mapHand)));
  document.querySelectorAll<HTMLElement>('.plw-map-label').forEach(button => button.setAttribute('aria-pressed', String(button.dataset.mapSelect === activeLine)));
  document.querySelectorAll<SVGElement>('[data-map-path]').forEach(path => path.classList.toggle('is-selected', path.dataset.mapPath === activeLine));
  const stage = document.querySelector<HTMLElement>('.plw-map-stage');
  const drawing = stage?.querySelector('svg');
  const stageHeight = stage ? 720 * stage.clientHeight / stage.clientWidth : 435;
  const verticalInset = (stageHeight - 435) / 2;
  drawing?.setAttribute('viewBox', `0 ${-verticalInset} 720 ${stageHeight}`);
  document.querySelectorAll<SVGElement>('[data-map-leader]').forEach(leader => {
    const [originalX, y] = leader.dataset.point!.split(',').map(Number);
    const x = (mapHand === 'left' ? 720 - originalX : originalX) - 20;
    const isLeft = leader.dataset.side === 'left';
    const endX = isLeft ? 142 : 530;
    const endY = Number(leader.dataset.y) / 100 * stageHeight - verticalInset + 10;
    const elbowX = isLeft ? Math.min(x - 28, 244) : Math.max(x + 26, 492);
    leader.setAttribute('d', `M${x} ${y} L${elbowX} ${endY} H${endX}`);
  });
}

const mapStage = document.querySelector('.plw-map-stage');
if (mapStage) new ResizeObserver(renderMap).observe(mapStage);

document.querySelectorAll<HTMLElement | SVGElement>('[data-map-select]').forEach(control => {
  control.addEventListener('click', () => {
    activeLine = control.dataset.mapSelect as LineTypeId;
    renderAll();
    document.querySelector('.plw-picker')?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth', block: 'start' });
    document.querySelector<HTMLButtonElement>(`.plw-line-btn[data-line="${activeLine}"]`)?.focus({ preventScroll: true });
  });
});

document.querySelectorAll<HTMLButtonElement>('[data-map-hand]').forEach(button => {
  button.addEventListener('click', () => {
    mapHand = button.dataset.mapHand as 'left' | 'right';
    if (readingMode !== 'compare') readingMode = mapHand === handedness ? 'dominant' : 'nonDominant';
    document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach(item => item.setAttribute('aria-pressed', String(item.dataset.mode === readingMode)));
    renderAll();
  });
});

document.querySelector('[data-plw-start]')?.addEventListener('click', () => {
  document.querySelector('.plw-picker')?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth', block: 'start' });
  document.querySelector<HTMLButtonElement>('.plw-card button, button.plw-card')?.focus({ preventScroll: true });
});

document.querySelector<HTMLButtonElement>('[data-plw-show-all]')?.addEventListener('click', event => {
  const button = event.currentTarget as HTMLButtonElement;
  const expanded = button.getAttribute('aria-expanded') !== 'true';
  button.setAttribute('aria-expanded', String(expanded));
  button.innerHTML = `${expanded ? 'แสดงแบบเลื่อน' : 'ดูรูปแบบทั้งหมด'}${renderIcon('chevron-down')}`;
  document.querySelector('#plw-grid')?.classList.toggle('is-expanded', expanded);
});

document.querySelectorAll<HTMLButtonElement>('[data-handedness]').forEach(button => {
  button.addEventListener('click', () => {
    handedness = button.dataset.handedness as 'right' | 'left';
    document.querySelectorAll<HTMLButtonElement>('[data-handedness]').forEach(item => {
      item.setAttribute('aria-pressed', String(item === button));
    });
    renderAll();
  });
});

document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach(button => {
  button.addEventListener('click', () => {
    readingMode = button.dataset.mode as ReadingMode;
    document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach(item => {
      item.setAttribute('aria-pressed', String(item === button));
    });
    renderAll();
  });
});

initPalmPhotos();
import { onCmsContent } from "../scripts/content-ready.js";
onCmsContent(renderAll);
</script>
