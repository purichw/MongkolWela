---
// Interactive palm line reading widget. Images are served from /public/images/lines/.
---

<section id="plw" class="plw-shell" aria-labelledby="plw-title">
  <header class="plw-header">
    <div>
      <p class="section-kicker">อ่านแบบสองชั้น</p>
      <h2 id="plw-title" class="plw-title">อ่านลายมือจากพื้นฐานและบริบทของมือ</h2>
      <p class="plw-subtitle">
        เลือกลักษณะจากภาพ แล้วระบบจะรวมความหมายของเส้นเข้ากับมือถนัด มือไม่ถนัด
        หรือพัฒนาการระหว่างสองมือ
      </p>
    </div>

    <div class="plw-controls">
      <fieldset class="plw-control-group">
        <legend>มือที่ถนัด</legend>
        <div class="plw-segmented" data-plw-handedness>
          <button type="button" data-handedness="right" aria-pressed="true">ถนัดขวา</button>
          <button type="button" data-handedness="left" aria-pressed="false">ถนัดซ้าย</button>
        </div>
      </fieldset>

      <fieldset class="plw-control-group">
        <legend>รูปแบบการอ่าน</legend>
        <div class="plw-segmented plw-segmented--mode" data-plw-mode>
          <button type="button" data-mode="dominant" aria-pressed="true">มือถนัด</button>
          <button type="button" data-mode="nonDominant" aria-pressed="false">มือไม่ถนัด</button>
          <button type="button" data-mode="compare" aria-pressed="false">เทียบสองมือ</button>
        </div>
      </fieldset>
    </div>
  </header>

  <div class="plw-context" data-plw-context aria-live="polite"></div>

  <div class="plw-body">
    <nav id="plw-sidebar" class="plw-sidebar" aria-label="ประเภทเส้นลายมือ"></nav>
    <div class="plw-main">
      <section class="plw-picker" aria-labelledby="plw-picker-title">
        <div class="plw-picker-head">
          <div>
            <p class="section-kicker">เลือกลักษณะที่เห็นชัด</p>
            <h3 id="plw-picker-title" data-plw-line-title>เส้นชีวิต</h3>
          </div>
          <div class="plw-hand-key" data-plw-hand-key></div>
        </div>
        <div id="plw-grid" class="plw-grid"></div>
      </section>
      <aside id="plw-detail" class="plw-detail" aria-live="polite"></aside>
    </div>
  </div>
</section>

