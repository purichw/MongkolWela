// Category definitions
const CATEGORIES = [
  { id: 'love',        nameTh: 'ความรัก',     icon: '❤️' },
  { id: 'career',      nameTh: 'การงาน',      icon: '💼' },
  { id: 'health',      nameTh: 'สุขภาพ',      icon: '🌿' },
  { id: 'fate',        nameTh: 'โชคชะตา',     icon: '✨' },
  { id: 'personality', nameTh: 'บุคลิกภาพ',   icon: '🧠' },
];

const GROUP_LABELS = { main: 'เส้นหลัก', minor: 'เส้นรอง' };

// ─────────────────────────────────────────────────────────────
//  STATE
// ─────────────────────────────────────────────────────────────

type LineTypeId = keyof typeof IMG_INDEX;
type Reading = { text: string; level: string };

let activeLine: LineTypeId = 'life_line';
let activeVariant: string | null = null;

// ─────────────────────────────────────────────────────────────
//  HELPERS
// ─────────────────────────────────────────────────────────────

function imgSrc(lineType: LineTypeId, variantId: string) {
  const variants = IMG_INDEX[lineType] as Record<string, string>;
  const filename = variants[variantId];
  return filename ? `/images/lines/${filename}` : null;
}

// ─────────────────────────────────────────────────────────────
//  RENDER
// ─────────────────────────────────────────────────────────────

function renderSidebar() {
  const sidebar = document.getElementById('plw-sidebar');
  if (!sidebar) return;

  let html = '';
  for (const [groupId, groupLabel] of Object.entries(GROUP_LABELS)) {
    html += `<div class="plw-group-label">${groupLabel}</div>`;
    LINE_TYPES.filter(l => l.group === groupId).forEach(l => {
      const active = l.id === activeLine ? ' plw-active' : '';
      html += `<button class="plw-line-btn${active}" data-line="${l.id}">${l.nameTh}</button>`;
    });
  }
  sidebar.innerHTML = html;
  sidebar.querySelectorAll<HTMLButtonElement>('.plw-line-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      activeLine = btn.dataset.line as LineTypeId;
      activeVariant = null;
      renderSidebar();
      renderGrid();
      renderDetail();
    });
  });
}

function renderGrid() {
  const grid = document.getElementById('plw-grid');
  if (!grid) return;

  const lineType = LINE_TYPES.find(l => l.id === activeLine);
  if (!lineType) return;

  grid.innerHTML = lineType.variants.map(v => {
    const src = imgSrc(activeLine, v.id);
    const active = v.id === activeVariant ? ' plw-active' : '';
    const imgHtml = src
      ? `<img src="${src}" alt="${v.nameTh}" loading="lazy" />`
      : `<div class="plw-card-no-img">☯</div>`;
    return `
      <div class="plw-card${active}" data-variant="${v.id}">
        ${imgHtml}
        <div class="plw-card-label">${v.nameTh}</div>
      </div>`;
  }).join('');

  grid.querySelectorAll<HTMLElement>('.plw-card').forEach(card => {
    card.addEventListener('click', () => {
      activeVariant = card.dataset.variant ?? null;
      renderGrid();
      renderDetail();
    });
  });
}

function renderDetail() {
  const detail = document.getElementById('plw-detail');
  if (!detail) return;

  if (!activeVariant) {
    detail.innerHTML = `<div class="plw-placeholder">← เลือกลักษณะเส้น<br>เพื่อดูคำทำนาย</div>`;
    return;
  }

  const lineType = LINE_TYPES.find(l => l.id === activeLine);
  const variant  = lineType?.variants.find(v => v.id === activeVariant);
  const lineReadings = READINGS[activeLine] as Record<string, Record<string, Reading>>;
  const readings = lineReadings[activeVariant] ?? {};
  const src      = imgSrc(activeLine, activeVariant);

  let html = '';

  // Selected image preview
  if (src) {
    html += `<img src="${src}" alt="${variant?.nameTh}" class="plw-detail-img" />`;
  }

  // Title
  html += `
    <div class="plw-detail-line">${lineType?.nameTh}</div>
    <div class="plw-detail-variant">${variant?.nameTh}</div>
    <div class="plw-divider"></div>
  `;

  // Readings by category
  const hasReadings = Object.keys(readings).length > 0;
  if (hasReadings) {
    CATEGORIES.forEach(cat => {
      const r = readings[cat.id];
      if (!r) return;
      html += `
        <div class="plw-reading-block ${r.level}">
          <div class="plw-reading-cat ${r.level}">${cat.icon} ${cat.nameTh}</div>
          <p class="plw-reading-text">${r.text}</p>
        </div>`;
    });
  } else {
    html += `<div class="plw-no-reading">ยังไม่มีคำทำนายสำหรับลักษณะนี้</div>`;
  }

  // Disclaimer
  html += `
    <div class="plw-disclaimer">
      ลายมือเปลี่ยนได้ตามกรรมและการกระทำ<br>
      เพื่อการสำรวจตนเอง ไม่ใช่คำทำนายที่แน่นอน
    </div>`;

  detail.innerHTML = html;
}

// ─────────────────────────────────────────────────────────────
//  INIT
// ─────────────────────────────────────────────────────────────

renderSidebar();
renderGrid();
renderDetail();
</script>
