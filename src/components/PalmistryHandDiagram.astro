---
const mountLabels = [
  ["1", "พฤหัสบดี"],
  ["2", "เสาร์"],
  ["3", "อาทิตย์"],
  ["4", "พุธ"],
  ["5", "ศุกร์"],
  ["6", "อังคารต่ำ"],
  ["7", "อังคารสูง"],
  ["8", "จันทร์"],
  ["9", "เกตุ"],
];
---

<aside class="palm-diagram-card" data-palm-diagram>
  <div class="palm-view-switcher" aria-label="เปลี่ยนมุมมองแผนภาพฝ่ามือ">
    <button type="button" data-palm-view="main" aria-pressed="true">เส้นหลัก</button>
    <button type="button" data-palm-view="minor" aria-pressed="false">เส้นรอง</button>
    <button type="button" data-palm-view="mounts" aria-pressed="false">เนินมือ</button>
  </div>

  <div class="palm-hand-stage">
    <svg
      class="palm-hand-map"
      viewBox="0 0 420 400"
      role="img"
      aria-labelledby="palm-map-title palm-map-desc"
    >
      <title id="palm-map-title">แผนภาพตำแหน่งเส้นและเนินบนฝ่ามือ</title>
      <desc id="palm-map-desc">
        เปลี่ยนมุมมองเพื่อดูเส้นหลัก เส้นรอง หรือเนินทั้งเก้าตำแหน่งตามหลักหัตถศาสตร์
      </desc>
      <defs>
        <radialGradient id="palm-skin" cx="45%" cy="38%" r="72%">
          <stop offset="0%" stop-color="#fff8ec" />
          <stop offset="58%" stop-color="#f4d7b5" />
          <stop offset="100%" stop-color="#dba77c" />
        </radialGradient>
        <filter id="palm-shadow" x="-30%" y="-20%" width="170%" height="170%">
          <feDropShadow dx="0" dy="10" stdDeviation="9" flood-color="#4d3829" flood-opacity=".16" />
        </filter>
      </defs>

      <g class="palm-hand-base" transform="translate(20 2)" filter="url(#palm-shadow)">
        <path
          d="M86 352 C80 332 76 310 78 290 C66 276 50 250 42 222 C38 208 38 192 46 184 C54 176 64 182 67 194 C72 212 80 232 90 248 C87 220 88 192 92 166 C92 130 93 92 98 56 C100 47 116 47 118 56 C123 92 124 130 126 158 C128 165 132 165 134 158 C135 118 137 70 140 36 C142 27 158 27 160 36 C163 70 165 120 166 158 C168 165 172 165 174 158 C175 120 177 84 180 50 C182 41 196 41 198 50 C201 84 203 124 204 158 C206 165 209 166 211 160 C212 134 214 106 216 82 C218 73 231 73 233 82 C235 110 238 138 240 162 C248 185 250 220 246 255 C242 290 232 325 220 348 C180 358 120 358 86 352 Z"
          fill="url(#palm-skin)"
          stroke="#b77f58"
          stroke-width="2.4"
          stroke-linejoin="round"
        />
        <g class="palm-natural-creases">
          <path d="M100 100 Q108 104 116 100 M99 130 Q108 134 117 130" />
          <path d="M142 84 Q150 88 158 84 M141 118 Q150 122 159 118" />
          <path d="M182 96 Q190 100 197 96 M181 126 Q190 130 198 126" />
          <path d="M218 116 Q224 119 231 116" />
          <path d="M96 160 Q109 166 124 158 M136 158 Q150 164 165 158" />
          <path d="M176 158 Q189 164 203 158 M213 160 Q224 165 238 162" />
          <path d="M60 196 Q66 206 70 216 M96 346 Q150 356 214 344" />
        </g>
        <g class="palm-nails">
          <ellipse cx="108" cy="60" rx="7.5" ry="9" />
          <ellipse cx="150" cy="40" rx="7.5" ry="9" />
          <ellipse cx="189" cy="54" rx="7" ry="9" />
          <ellipse cx="224" cy="88" rx="6.5" ry="8" />
          <ellipse cx="52" cy="197" rx="7" ry="8" transform="rotate(-32 52 197)" />
        </g>
      </g>

      <g class="palm-map-layer is-active" data-palm-layer="main">
        <path class="palm-map-line palm-map-line--heart" d="M262 207 C222 198 179 188 146 170" />
        <path class="palm-map-line palm-map-line--head" d="M118 212 C160 222 202 231 241 244" />
        <path class="palm-map-line palm-map-line--life" d="M118 197 C106 229 106 270 119 303 C127 323 139 337 151 345" />

        <path class="palm-map-leader" d="M239 198 C285 183 312 169 329 158" />
        <path class="palm-map-leader" d="M225 238 C277 237 305 228 328 217" />
        <path class="palm-map-leader" d="M120 288 C82 292 61 302 44 316" />
        <g class="palm-map-label" transform="translate(324 139)">
          <rect width="88" height="34" rx="6" />
          <text x="44" y="22">เส้นหัวใจ</text>
        </g>
        <g class="palm-map-label" transform="translate(324 200)">
          <rect width="88" height="34" rx="6" />
          <text x="44" y="22">เส้นสมอง</text>
        </g>
        <g class="palm-map-label" transform="translate(0 300)">
          <rect width="88" height="34" rx="6" />
          <text x="44" y="22">เส้นชีวิต</text>
        </g>
      </g>

      <g class="palm-map-layer is-hidden" data-palm-layer="minor" aria-hidden="true">
        <path class="palm-map-line palm-map-line--fate" d="M172 341 C169 300 167 244 164 177" />
        <path class="palm-map-line palm-map-line--sun" d="M212 313 C210 270 208 228 206 199" />
        <path class="palm-map-line palm-map-line--mercury" d="M143 333 C170 305 199 270 242 211" />
        <path class="palm-map-line palm-map-line--marriage" d="M265 181 C254 182 247 183 241 184" />

        <path class="palm-map-leader" d="M166 273 C114 273 77 267 48 255" />
        <path class="palm-map-leader" d="M209 250 C281 256 311 273 331 289" />
        <path class="palm-map-leader" d="M221 263 C281 245 309 230 331 214" />
        <path class="palm-map-leader" d="M259 181 C300 178 322 164 340 149" />
        <g class="palm-map-label" transform="translate(0 238)">
          <rect width="92" height="34" rx="6" />
          <text x="46" y="22">เส้นวาสนา</text>
        </g>
        <g class="palm-map-label" transform="translate(324 272)">
          <rect width="88" height="34" rx="6" />
          <text x="44" y="22">เส้นอาทิตย์</text>
        </g>
        <g class="palm-map-label" transform="translate(324 197)">
          <rect width="88" height="34" rx="6" />
          <text x="44" y="22">เส้นพุธ</text>
        </g>
        <g class="palm-map-label" transform="translate(324 132)">
          <rect width="88" height="34" rx="6" />
          <text x="44" y="22">เส้นสมรส</text>
        </g>
      </g>

      <g class="palm-map-layer palm-mount-layer is-hidden" data-palm-layer="mounts" aria-hidden="true">
        <ellipse cx="137" cy="177" rx="22" ry="17" />
        <ellipse cx="174" cy="173" rx="21" ry="16" />
        <ellipse cx="212" cy="177" rx="21" ry="16" />
        <ellipse cx="249" cy="185" rx="19" ry="16" />
        <ellipse cx="116" cy="263" rx="34" ry="53" />
        <ellipse cx="136" cy="213" rx="20" ry="19" />
        <ellipse cx="249" cy="238" rx="21" ry="27" />
        <ellipse cx="240" cy="298" rx="27" ry="39" />
        <ellipse cx="171" cy="276" rx="28" ry="31" />

        <g class="palm-mount-marker" transform="translate(137 177)"><circle r="12" /><text y="5">1</text></g>
        <g class="palm-mount-marker" transform="translate(174 173)"><circle r="12" /><text y="5">2</text></g>
        <g class="palm-mount-marker" transform="translate(212 177)"><circle r="12" /><text y="5">3</text></g>
        <g class="palm-mount-marker" transform="translate(249 185)"><circle r="12" /><text y="5">4</text></g>
        <g class="palm-mount-marker" transform="translate(116 263)"><circle r="12" /><text y="5">5</text></g>
        <g class="palm-mount-marker" transform="translate(136 213)"><circle r="12" /><text y="5">6</text></g>
        <g class="palm-mount-marker" transform="translate(249 238)"><circle r="12" /><text y="5">7</text></g>
        <g class="palm-mount-marker" transform="translate(240 298)"><circle r="12" /><text y="5">8</text></g>
        <g class="palm-mount-marker" transform="translate(171 276)"><circle r="12" /><text y="5">9</text></g>
      </g>
    </svg>
  </div>

  <div class="palm-mount-legend" data-palm-mount-legend hidden>
    {mountLabels.map(([number, label]) => (
      <span><b>{number}</b>{label}</span>
    ))}
  </div>

  <p class="palm-view-note" data-palm-view-note>
    เส้นหลักใช้เริ่มอ่านโครงเรื่องใหญ่ของชีวิต: หัวใจ สมอง และชีวิต
  </p>
</aside>

<script>
  const notes = {
    main: "เส้นหลักใช้เริ่มอ่านโครงเรื่องใหญ่ของชีวิต: หัวใจ สมอง และชีวิต",
    minor: "เส้นรองอ่านประกอบบริบท: วาสนา อาทิตย์ พุธ และสมรส บางคนอาจเห็นไม่ชัดหรือไม่มีเส้น",
    mounts: "ตำแหน่งเนินอ่านจากความนูน ความแน่น และสัญลักษณ์ที่เกิดร่วมกัน ไม่ดูจากตำแหน่งอย่างเดียว",
  };

  document.querySelectorAll("[data-palm-diagram]").forEach((diagram) => {
    const buttons = diagram.querySelectorAll("[data-palm-view]");
    const layers = diagram.querySelectorAll("[data-palm-layer]");
    const note = diagram.querySelector("[data-palm-view-note]");
    const mountLegend = diagram.querySelector("[data-palm-mount-legend]");

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const view = button.getAttribute("data-palm-view");
        if (!view || !(view in notes)) return;

        buttons.forEach((item) => {
          item.setAttribute("aria-pressed", String(item === button));
        });
        layers.forEach((layer) => {
          const isActive = layer.getAttribute("data-palm-layer") === view;
          layer.classList.toggle("is-active", isActive);
          layer.classList.toggle("is-hidden", !isActive);
          layer.setAttribute("aria-hidden", String(!isActive));
        });
        mountLegend?.toggleAttribute("hidden", view !== "mounts");
        if (note) note.textContent = notes[view as keyof typeof notes];
      });
    });
  });
</script>
