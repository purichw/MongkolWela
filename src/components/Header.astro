---
import { getImage } from "astro:assets";
import { siteConfig } from "../config/site.js";
import BrandMark from "./icons/BrandMark.astro";
import MenuIcon from "./icons/MenuIcon.astro";
import SiteIcon from "./icons/SiteIcon.astro";
import Topbar from "./Topbar.astro";
import { navigationModel, navigationUtilities, drawerUtilities, renderDesktopNavigation, renderMobileNavigation, renderMobileHub, renderUtilityNavigation, findNavigationLink } from "../lib/site-navigation.js";
import temple from "../assets/loading/temple.png";
import lotus from "../assets/loading/lotus.png";
import liveContent from "../../public/admin/content/live.json" with { type: "json" };
import defaultContent from "../../public/admin/content/default.json" with { type: "json" };

const config = siteConfig.th;
const navigation = Array.isArray(liveContent.navigation?.tabs) ? liveContent.navigation : defaultContent.navigation;
const model = navigationModel(navigation);
const templeImage = await getImage({ src: temple, width: 256, format: "webp" });
const lotusImage = await getImage({ src: lotus, width: 128, format: "webp" });
const assets = { temple: templeImage.src, lotus: lotusImage.src };
const options = { location: Astro.url.pathname, assets };
const utility = navigationUtilities(model, config.topbar);
const planner = findNavigationLink(model.tabs, "/temples/planner/");
---

<Topbar items={utility} options={options} />
<header class="site-header mw-header" data-header-mode="compact" data-header-assets={JSON.stringify(assets)} style={`--mw-temple-art: url('${templeImage.src}'); --mw-lotus-art: url('${lotusImage.src}')`}>
  <div class="mw-header-row">
    <a class="mw-brand" href="/" aria-label={config.brandLabel}>
      <BrandMark decorative fetchpriority="high" />
      <span><strong data-cms-field="cef92c86-1">{config.brandName}</strong><small data-cms-field="cef92c86-2">{config.brandSubtitle}</small></span>
    </a>
    <nav class="mw-desktop-nav" data-header-desktop aria-label={config.navLabel} set:html={renderDesktopNavigation(model, options)} />
    <div class="mw-header-actions">
      <a class="mw-search mw-round-control" data-header-search href="/search/" aria-haspopup="dialog" aria-controls="temple-search-dialog" aria-label="ค้นหาวัดและสถานที่" title="ค้นหาวัดและสถานที่"><SiteIcon name="search" /></a>
      <div data-header-cta>
        {planner && <a class="mw-planner-cta" data-nav-key="planner-cta" data-nav-cta="temple-planner" href={planner.href!} aria-label={planner.label}>
          <span data-cms-field="cef92c86-3" class="mw-cta-full">{planner.label}</span><span data-cms-field="cef92c86-4" class="mw-cta-short" aria-hidden="true">วางแผน</span><SiteIcon name="arrow-right" />
        </a>}
      </div>
      <button class="mw-menu-toggle mw-round-control" type="button" aria-expanded="false" aria-controls="mw-navigation-dialog" aria-label="เปิดเมนู"><MenuIcon /></button>
    </div>
  </div>
  <details class="mw-fallback">
    <summary data-cms-field="cef92c86-5">เมนูหลัก</summary>
    <div class="mw-drawer-content" data-header-drawer-content>
      <div class="mw-drawer-intro">
        <div class="mw-drawer-eyebrow"><span data-cms-field="cef92c86-6" class="mw-eyebrow">MONGKOL WELA</span><div data-header-mobile-hub set:html={renderMobileHub(model, options)} /></div>
        <h2 data-cms-field="cef92c86-7" id="mw-drawer-title">เดินทางสายบุญ<br />ให้ทุกก้าวมีความหมาย</h2>
        <p data-cms-field="cef92c86-8">ค้นหาวัดและเส้นทางมงคล วางแผนการเดินทางได้ง่าย ๆ</p>
      </div>
      <a class="mw-drawer-search mw-mobile-row" data-header-search href="/search/" aria-haspopup="dialog" aria-controls="temple-search-dialog"><SiteIcon name="search" /><span data-cms-field="cef92c86-9">ค้นหาวัดและสถานที่</span><SiteIcon name="chevron-right" /></a>
      <nav data-header-mobile aria-label="เมนูหลักบนมือถือ" set:html={renderMobileNavigation(model, options)} />
      <nav class="mw-drawer-utility" data-header-mobile-utility aria-label="ลิงก์เพิ่มเติม" set:html={renderUtilityNavigation(drawerUtilities(model, utility), options)} />
      <div class="mw-drawer-quote" aria-hidden="true"><SiteIcon name="sparkles" /><p data-cms-field="cef92c86-10">“ เพราะทุกการเดินทาง<br />คือการเติมพลังใจให้ชีวิต ”</p></div>
    </div>
  </details>
  <dialog class="mw-drawer" id="mw-navigation-dialog" aria-labelledby="mw-drawer-title">
    <div class="mw-drawer-shell">
      <button class="mw-drawer-close mw-round-control" type="button" aria-label="ปิดเมนู"><SiteIcon name="x" /></button>
      <div class="mw-drawer-scroll"></div>
    </div>
  </dialog>
</header>
