---
import readiness from "../scripts/page-readiness.js?raw";
const { cms = true, runtime = true } = Astro.props;
---
<style is:inline>
  html.page-fonts-pending body > :not([data-page-loader]):not([data-page-recovery]):not(script):not(style) {
    opacity: 0;
    visibility: hidden;
  }
  html.page-fonts-pending { background: #fbf7ed; }
  html.page-fonts-pending body { overflow: hidden; }
  html:not(.page-styles-ready).is-font-loading [data-page-loader] {
    position: fixed; inset: 0; z-index: 10000; height: 100dvh !important;
    display: grid; place-items: center; opacity: 1 !important; visibility: visible;
    background: #fbf7ed; color: #174637; font: 16px/1.7 sans-serif; text-align: center;
  }
  html:not(.page-styles-ready) [data-page-loader] .loader-skeleton,
  html:not(.page-styles-ready) [data-page-loader] .loader-icon-stage,
  html:not(.page-styles-ready) [data-page-loader] .loader-timeout { display: none; }
  [data-page-recovery] { display: none; }
  html.page-load-stalled [data-page-recovery] {
    position: fixed; inset: 0; z-index: 10002; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 16px; padding: 28px;
    box-sizing: border-box; background: #fbf7ed; color: #174637;
    font: 16px/1.7 "Noto Sans Thai", sans-serif; text-align: center;
  }
  [data-page-recovery] h1 { margin: 0; font-size: 24px; line-height: 1.5; }
  [data-page-recovery] p { margin: 0; max-width: 34em; }
  [data-page-recovery] button {
    font: inherit; padding: 10px 24px; min-height: 44px; border: 0; border-radius: 6px;
    background: #9e2b24; color: #fff; cursor: pointer;
  }
  [data-page-recovery] button:focus-visible { outline: 3px solid #b98936; outline-offset: 4px; }
</style>
<script is:inline data-cms={String(cms)} data-runtime={String(runtime)} set:html={readiness} />
