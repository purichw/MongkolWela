---
import PageBanner from "./PageBanner.astro";

type BreadcrumbItem = {
  label: string;
  href?: string;
};

type BannerConfig = {
  adminKey: string;
  imageUrl: string;
  imageAlt: string;
  imageSourceLabel?: string;
  imageSourceUrl?: string;
  focalPoint?: string;
};

interface Props {
  banner: BannerConfig;
  breadcrumbs: BreadcrumbItem[];
  kicker: string;
  title: string;
  description?: string;
}

const { banner, breadcrumbs, kicker, title, description } = Astro.props as Props;
const hasPanel = Astro.slots.has("panel");
---

<PageBanner titleId="temple-page-title" adminKey={banner.adminKey}>
  <img slot="media" class="temple-page-hero-image" src={banner.imageUrl} alt="" style={`object-position: ${banner.focalPoint || "center"}`} loading="eager" decoding="async" fetchpriority="high" />
    <nav class="page-banner__breadcrumb" aria-label="เส้นทางนำทาง">
      {breadcrumbs.map((item, index) => (
        <>
          {index > 0 && <span>/</span>}
          {item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>}
        </>
      ))}
    </nav>
    <div class="page-banner__copy">
      <p class="page-banner__kicker">{kicker}</p>
      <h1 id="temple-page-title">{title}</h1>
      {description && <p class="page-banner__description">{description}</p>}
    </div>
  {Astro.slots.has("quote") && <Fragment slot="quote"><slot name="quote" /></Fragment>}
</PageBanner>
{hasPanel && <div class="page-banner-search"><slot name="panel" /></div>}
