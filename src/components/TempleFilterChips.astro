---
interface Props {
  regions: string[];
  purposes: string[];
  mode?: "directory" | "planner";
  allLabel?: string;
  regionLabel?: string;
  provinceLabel?: string;
  purposeLabel?: string;
  regionAriaLabel?: string;
  provinceAriaLabel?: string;
  purposeAriaLabel?: string;
}

const {
  regions,
  purposes,
  mode = "directory",
  allLabel = "ทั้งหมด",
  regionLabel = "ภาค",
  provinceLabel = "จังหวัด",
  purposeLabel = "วัตถุประสงค์",
  regionAriaLabel = "กรองตามภาค",
  provinceAriaLabel = "กรองตามจังหวัด",
  purposeAriaLabel = "กรองตามวัตถุประสงค์",
} = Astro.props;

const isPlanner = mode === "planner";
---

<div class={`temple-filter-chips temple-filter-chips--${mode}`} data-temple-filter-chips>
  <div class="popular-temple-region-filter">
    <span>{regionLabel}</span>
    <div class="popular-temple-region-tags" aria-label={regionAriaLabel}>
      <button
        type="button"
        class="is-active"
        data-popular-region-tag={isPlanner ? undefined : ""}
        data-planner-region-tag={isPlanner ? "" : undefined}
        value=""
      >{allLabel}</button>
      {regions.map((region) => (
        <button
          type="button"
          data-popular-region-tag={isPlanner ? undefined : ""}
          data-planner-region-tag={isPlanner ? "" : undefined}
          value={region}
        >{region}</button>
      ))}
    </div>
  </div>

  <details
    class="popular-temple-province-filter temple-province-accordion"
    data-popular-province-filter={isPlanner ? undefined : ""}
    data-planner-province-filter={isPlanner ? "" : undefined}
  >
    <summary>
      <span>{provinceLabel}</span>
      <small data-temple-province-summary>{allLabel}</small>
    </summary>
    <div
      class="popular-temple-province-tags"
      aria-label={provinceAriaLabel}
      data-popular-province-tags={isPlanner ? undefined : ""}
      data-planner-province-tags={isPlanner ? "" : undefined}
    ></div>
  </details>

  <details class="popular-temple-purpose-filter temple-purpose-accordion">
    <summary>
      <span>{purposeLabel}</span>
      <small data-temple-purpose-summary>{allLabel}</small>
    </summary>
    <div
      class="popular-temple-purpose-tags"
      aria-label={purposeAriaLabel}
      data-popular-purpose-tags={isPlanner ? undefined : ""}
      data-planner-purpose-tags={isPlanner ? "" : undefined}
    >
      <button
        type="button"
        class="is-active"
        data-popular-purpose-tag={isPlanner ? undefined : ""}
        data-planner-purpose-tag={isPlanner ? "" : undefined}
        value=""
      >{allLabel}</button>
      {purposes.map((purpose) => (
        <button
          type="button"
          data-popular-purpose-tag={isPlanner ? undefined : ""}
          data-planner-purpose-tag={isPlanner ? "" : undefined}
          value={purpose}
        >{purpose}</button>
      ))}
    </div>
  </details>
</div>
