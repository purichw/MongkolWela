---
import { getTempleDetailUrl } from "../data/temple-slugs.js";
import { templeMapItems } from "../lib/temple-map-content.js";

interface TempleMapItem {
  rank: number;
  name: string;
  region: string;
  province: string;
  district?: string;
  imageUrl?: string;
  imageMobileUrl?: string;
  mapImageUrl?: string;
  mapImageMobileUrl?: string;
  imageAlt?: string;
  latitude?: number | null;
  longitude?: number | null;
  placeType?: string;
}

interface Props {
  collection: "popular" | "mu" | "sacred";
  title: string;
  searchPlaceholder: string;
  temples: TempleMapItem[];
  placeholderImage: string;
}

const { collection, title, searchPlaceholder, temples, placeholderImage } = Astro.props as Props;
const mapId = `templeMap-${collection}`;
const modalId = `templeMapModal-${collection}`;
const payloadId = `templeMapData-${collection}`;
const mapItems = temples
  .map((temple) => {
    const cardImage = temple.imageUrl || "";
    const cardMobileImage = temple.imageMobileUrl ?? cardImage;
    return {
      rank: temple.rank,
      name: temple.name,
      region: temple.region,
      province: temple.province,
      district: temple.district || "",
      latitude: temple.latitude ?? null,
      longitude: temple.longitude ?? null,
      detailUrl: getTempleDetailUrl(collection, temple),
      imageAlt: temple.imageAlt ?? `${temple.name} ${temple.province}`,
      imageUrl: temple.mapImageUrl ?? cardImage,
      imageMobileUrl: temple.mapImageMobileUrl ?? temple.mapImageUrl ?? cardMobileImage,
    };
  });
const mappedCount = templeMapItems(mapItems, {}, collection).length;
const payload = JSON.stringify({
  collection,
  title,
  placeholderImage,
  totalCount: temples.length,
  mappedCount,
  items: mapItems,
}).replace(/</g, "\\u003c");
---

<div
  class="temple-map-widget"
  data-temple-map-root
  data-temple-map-modal={modalId}
  data-temple-map-id={mapId}
  data-temple-map-payload={payloadId}
>
  <button class="temple-map-float-button" type="button" data-temple-map-open aria-label={`เปิดแผนที่${title}`}>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 21s7-5.2 7-11a7 7 0 1 0-14 0c0 5.8 7 11 7 11Z"></path>
      <circle cx="12" cy="10" r="2.4"></circle>
    </svg>
    <span>แผนที่</span>
  </button>

  <div class="temple-map-modal" id={modalId} aria-hidden="true" data-temple-map-modal-element>
    <button class="temple-map-modal__overlay" type="button" data-temple-map-close aria-label="ปิดแผนที่"></button>
    <div class="temple-map-modal__panel" role="dialog" aria-modal="true" aria-labelledby={`${modalId}-title`}>
      <h2 class="sr-only" id={`${modalId}-title`}>แผนที่{title}</h2>
      <div class="temple-map-search">
        <label class="sr-only" for={`${mapId}-search`}>ค้นหาพิกัดในแผนที่</label>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m21 21-4.3-4.3m2.3-5.2a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z"></path>
        </svg>
        <input
          id={`${mapId}-search`}
          type="search"
          placeholder={searchPlaceholder}
          autocomplete="off"
          aria-expanded="false"
          aria-controls={`${mapId}-results`}
          data-temple-map-search
        />
        <div
          class="temple-map-search__dropdown"
          id={`${mapId}-results`}
          role="listbox"
          aria-label="ผลการค้นหาในแผนที่"
          data-temple-map-search-results
        ></div>
      </div>
      <button class="temple-map-modal__close" type="button" data-temple-map-close aria-label="ปิดแผนที่">×</button>
      <div class="temple-map-canvas" id={mapId} role="application" aria-label={`แผนที่${title}`} tabindex="0">
        <p class="sr-only">แผนที่จะแสดงเมื่อโหลดข้อมูลสำเร็จ หากแผนที่โหลดไม่ได้ยังสามารถใช้ปุ่มเปิดใน Google Maps ในหน้ารายละเอียดได้</p>
      </div>
      <div class="temple-map-status" role="status" aria-live="polite" data-temple-map-status>
        แสดง {mappedCount.toLocaleString("th-TH")} จาก {temples.length.toLocaleString("th-TH")} พิกัด
      </div>
    </div>
  </div>

  <script is:inline type="application/json" id={payloadId} set:html={payload}></script>
</div>
