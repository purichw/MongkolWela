---
import { Image } from "astro:assets";
import temple from "../assets/loading/temple.png";
import stupa from "../assets/loading/stupa.png";
import incense from "../assets/loading/incense.png";
import lotus from "../assets/loading/lotus.png";
import amulet from "../assets/loading/amulet.png";
import altar from "../assets/loading/altar.png";
import gate from "../assets/loading/gate.png";
import sacredThread from "../assets/loading/sacred-thread.png";
import candle from "../assets/loading/candle.png";
import templeMap from "../assets/loading/temple-map.png";

const icons = [temple, stupa, incense, lotus, amulet, altar, gate, sacredThread, candle, templeMap];
---

<div
  class="site-loader"
  data-page-loader
  aria-hidden="true"
  role="progressbar"
  aria-label="กำลังโหลด"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
  style="position:fixed;inset:0;width:100%;height:0;overflow:hidden;opacity:0;pointer-events:none;"
>
  <div class="loader-veil" aria-hidden="true"></div>

  <div class="loader-panel">
    <div class="loader-skeleton" aria-hidden="true">
      <span class="loader-skeleton-line loader-skeleton-line-short"></span>
      <span class="loader-skeleton-line loader-skeleton-line-wide"></span>
      <span class="loader-skeleton-card"></span>
      <span class="loader-skeleton-line"></span>
    </div>

    <div class="loader-core">
      <div class="loader-icon-stage" aria-hidden="true">
        {icons.map((src, index) => (
          <Image
            src={src}
            class={`loader-vector-icon loader-vector-icon-${index + 1}`}
            alt=""
            width={384}
            height={384}
            format="webp"
            quality={90}
            loading="eager"
            decoding="async"
          />
        ))}
      </div>

      <p class="loader-kicker">กำลังโหลด</p>
      <p class="loader-title">มงคลเวลา</p>
      <p class="loader-status" data-loader-status aria-live="polite">กำลังเตรียมข้อมูลมงคล</p>
      <p class="loader-timeout" data-loader-timeout aria-live="polite">
        โหลดนานกว่าปกติเล็กน้อย กำลังรอสัญญาณให้พร้อม
      </p>

      <span class="loader-progress-track">
        <span data-loader-progress></span>
      </span>
    </div>
  </div>
</div>
