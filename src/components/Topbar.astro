---
import { renderUtilityNavigation } from "../lib/site-navigation.js";
const { items = [], options = {} } = Astro.props;
---
<div class="mw-utility" data-header-utility aria-label="ลิงก์ด่วน" style={options.assets?.lotus ? `--mw-lotus-art: url('${options.assets.lotus}')` : undefined}>
  <div class="mw-utility-inner" data-header-utility-links set:html={renderUtilityNavigation(items, options)} />
</div>
