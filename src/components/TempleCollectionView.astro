---
import BaseLayout from "../layouts/BaseLayout.astro";
import TempleMapOverlay from "./TempleMapOverlay.astro";
import TempleResponsiveImage from "./TempleResponsiveImage.astro";
import PageBanner from "./PageBanner.astro";
import CmsImage from "./CmsImage.astro";
import PopularFilters from "./PopularFilters.astro";
import templePageBanners from "../data/temple-page-banners.json";
import { templePlaceholderImage } from "../data/temple-images.js";
import { getTempleDetailUrl } from "../data/temple-slugs.js";

type TempleCard = {
  rank: number;
  name: string;
  region: string;
  province: string;
  district?: string;
  imageUrl?: string;
  imageMobileUrl?: string;
  imageAlt?: string;
  placeType?: string;
  blessings?: string;
  objectHero?: string;
  latitude?: number;
  longitude?: number;
};

type CollectionMeta = {
  key: "popular" | "sacred" | "mu";
  label: string;
  shortLabel: string;
  kicker: string;
  title: string;
  description: string;
  intro: string;
  accent: string;
  heroBg: string;
  mapTitle: string;
  mapSearchPlaceholder: string;
  searchLabel: string;
  searchPlaceholder: string;
  gridLabel: string;
  emptyText: string;
  imageAlt: string;
};

type Breadcrumb = {
  label: string;
  href?: string;
};

const {
  collection,
  pageKey,
  pageTitle,
  pageDescription,
  canonicalPath,
  breadcrumbs,
  meta,
  rankedTemples,
  regions,
  purposes,
  structuredData,
  initialCount = 8,
  batchSize = 8,
} = Astro.props as {
  collection: "popular" | "sacred" | "mu";
  pageKey: string;
  pageTitle: string;
  pageDescription: string;
  canonicalPath: string;
  breadcrumbs: Breadcrumb[];
  meta: CollectionMeta;
  rankedTemples: TempleCard[];
  regions: string[];
  purposes: string[];
  structuredData: Record<string, unknown> | Record<string, unknown>[];
  initialCount?: number;
  batchSize?: number;
};

const collectionTabs = [
  { key: "popular", label: "วัดดังน่าไป", href: "/temples/popular/" },
  { key: "sacred", label: "วัดเด่นขอพร", href: "/temples/sacred/" },
  { key: "mu", label: "พิกัดสายมู", href: "/temples/mu/" },
];
const supportingLinks = [
  { label: "พิกัดสายมู", href: "/temples/mu/" },
  { label: "คู่มือวางแผนไหว้พระ", href: "/temples/" },
  { label: "วัดดังน่าไป", href: "/temples/popular/" },
  { label: "วัดเด่นขอพร", href: "/temples/sacred/" },
  { label: "วัดทั่วประเทศไทย", href: "/temples/thailand/" },
];
const thaiNumber = (value: number) => value.toLocaleString("th-TH-u-nu-thai");
const splitTags = (value?: string) =>
  String(value || "")
    .split(";")
    .map((item) => item.trim())
    .filter((item) => item && item !== "0" && item.toLowerCase() !== "nan" && item.toLowerCase() !== "null");
const plannerHrefFor = (temple: TempleCard) =>
  `/temples/planner/?start=${encodeURIComponent(temple.name)}&province=${encodeURIComponent(temple.province)}`;
const collectionDataSrc = `/assets/data/temple-collections/${collection}.json`;
const initialTemples = rankedTemples.slice(0, initialCount);
const banner = templePageBanners[collection];
const cardKeyFor = (temple: TempleCard) => `${collection}:${temple.rank}`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  lang="th"
  locale="th"
  page={pageKey}
  bodyClass={`temples-hub-page temples-collection-v2-page temples-collection-v2-page--${collection}`}
  canonicalPath={canonicalPath}
  image="/assets/images/hero-temple-red.jpg"
  imageAlt={meta.imageAlt}
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
>
  <main
    class="temples-collection-v2"
    style={`--collection-accent: ${meta.accent}; --collection-hero-bg: ${meta.heroBg};`}
  >
    <TempleMapOverlay
      collection={collection}
      title={meta.mapTitle}
      searchPlaceholder={meta.mapSearchPlaceholder}
      temples={rankedTemples}
      placeholderImage={templePlaceholderImage}
    />

    <PageBanner titleId="temple-collection-title" adminKey={banner.adminKey}>
      <CmsImage slot="media" mediaId={`temple-${collection}-banner`} image={{ src: banner.imageUrl, alt: banner.imageAlt, position: banner.focalPoint, credit: banner.imageSourceLabel, sourceUrl: banner.imageSourceUrl }} width={1920} height={1080} loading="eager" fetchpriority="high" />
      <div class="page-banner__copy">
        <nav class="page-banner__breadcrumb" aria-label="เส้นทางนำทาง">
          {breadcrumbs.map((item, index) => (
            <>
              {item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>}
              {index < breadcrumbs.length - 1 && <span aria-hidden="true">/</span>}
            </>
          ))}
        </nav>

        <div class="temple-collection-v2-tabs" aria-label="หมวดวัด">
          {collectionTabs.map((tab) => (
            <a class={tab.key === collection ? "is-active" : undefined} href={tab.href}>{tab.label}</a>
          ))}
        </div>

        <p class="page-banner__kicker">{meta.kicker}</p>
        <h1 id="temple-collection-title">{meta.title}</h1>
        <p class="page-banner__description">{meta.description}</p>
        <p class="temple-collection-v2-total">
          พบ {thaiNumber(rankedTemples.length)} สถานที่ในหมวดนี้ · แสดงรายการเด่นก่อน แล้วค่อยแสดงเพิ่มเติม
        </p>
      </div>
    </PageBanner>

    <PopularFilters regions={regions} purposes={purposes} />

    <section class="temples-section temple-collection-v2-results">
      <div class="temple-collection-v2-results-head">
        <h2 class="sr-only">{meta.gridLabel}</h2>
        <p class="popular-temple-count" data-popular-temple-count></p>
      </div>

      <div
        class="popular-temple-grid temple-collection-v2-grid"
        aria-label={meta.gridLabel}
        data-popular-temple-grid
        data-collection={collection}
        data-collection-data-src={collectionDataSrc}
        data-initial-count={initialCount}
        data-batch-size={batchSize}
        data-count-mode="visible-filtered"
        data-placeholder-src={templePlaceholderImage}
      >
        {initialTemples.map((temple) => {
          const hasTempleImage = Boolean(temple.imageUrl) && temple.imageUrl !== templePlaceholderImage;
          const imageUrl = hasTempleImage ? String(temple.imageUrl) : templePlaceholderImage;
          const imageAlt = temple.imageAlt || `${temple.name} ${temple.province}`;
          const intent = splitTags(temple.blessings)[0] || splitTags(temple.objectHero)[0] || temple.placeType || "สิริมงคล";
          const detailHref = getTempleDetailUrl(collection, temple);

          return (
            <article
              class={`popular-temple-card temple-collection-v2-card${hasTempleImage ? "" : " is-placeholder"}`}
              data-rank={temple.rank}
              data-name={temple.name}
              data-region={temple.region}
              data-province={temple.province}
              data-district={temple.district}
              data-blessings={temple.blessings ?? ""}
              data-place-type={temple.placeType ?? ""}
              data-search-text={`${temple.name} ${temple.region} ${temple.province} ${temple.district || ""} ${temple.blessings || ""} ${temple.objectHero || ""}`}
              data-latitude={temple.latitude}
              data-longitude={temple.longitude}
              data-card-key={cardKeyFor(temple)}
              data-popular-temple-card
              data-image-placeholder={hasTempleImage ? undefined : "true"}
            >
              <figure>
                <TempleResponsiveImage
                  desktopSrc={imageUrl}
                  mobileSrc={temple.imageMobileUrl || imageUrl}
                  alt={imageAlt}
                  loading="lazy"
                  decoding="async"
                  fallbackSrc={templePlaceholderImage}
                />
                <figcaption>{thaiNumber(temple.rank)}</figcaption>
              </figure>
              <div class="popular-temple-card-body">
                <span>{temple.province}</span>
                <h3>{temple.name}</h3>
                <p>{temple.province}{temple.district ? ` / ${temple.district}` : ""}</p>
                <strong>{intent}</strong>
                <div class="temple-collection-v2-card-meta">
                  <small>ข้อมูลชุดปัจจุบัน</small>
                  <a href="/contact/#corrections">แจ้งแก้ไขข้อมูล</a>
                </div>
                <div class="temple-collection-v2-card-actions">
                  <a class="temple-collection-v2-card-plan" href={plannerHrefFor(temple)}>เพิ่มลงแผน</a>
                  <a class="temple-collection-v2-card-detail" href={detailHref} data-popular-temple-detail>รายละเอียด</a>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <p class="popular-temple-empty" data-popular-temple-empty hidden>{meta.emptyText}</p>
      <button class="popular-temple-load-more" type="button" data-popular-temple-more hidden>
        แสดงเพิ่มเติม
      </button>

      <aside class="temple-collection-v2-planner" aria-label="วางแผนเส้นทางจากสถานที่ที่เลือก">
        <div>
          <p>วางแผนการเดินทาง</p>
          <h2>จัดลำดับเส้นทางจากสถานที่ที่เลือก</h2>
          <span>เพิ่มวัดจากหน้าค้นหา แล้วเปิดเครื่องมือวางแผนเพื่อจัดเส้นทางที่ต่อเนื่องตามพิกัดและเวลาเปิดของสถานที่</span>
        </div>
        <a href="/temples/planner/">วางแผนเส้นทาง</a>
      </aside>

      <nav class="temple-collection-v2-supporting" aria-label="หมวดอื่น">
        <span>หมวดอื่น</span>
        {supportingLinks.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>

      <div class="popular-temple-sentinel" data-popular-temple-sentinel aria-hidden="true"></div>
    </section>
  </main>

  <script>
    import "../scripts/temple-directory.js";
    import "../scripts/temple-map.js";
  </script>
</BaseLayout>
