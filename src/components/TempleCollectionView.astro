---
import BaseLayout from "../layouts/BaseLayout.astro";
import TempleMapOverlay from "./TempleMapOverlay.astro";
import SiteIcon from "./icons/SiteIcon.astro";
import BrandOrnament from "./BrandOrnament.astro";
import { renderTempleCollectionCard } from "../lib/temple-collection-card.js";
import "../styles/temple-collection.css";
import PageBanner from "./PageBanner.astro";
import CmsImage from "./CmsImage.astro";
import PopularFilters from "./PopularFilters.astro";
import templePageBanners from "../data/temple-page-banners.json";
import { templePlaceholderImage } from "../data/temple-images.js";
import { getTempleDetailUrl } from "../data/temple-slugs.js";

type TempleCard = {
  rank: number;
  name: string;
  region: string;
  province: string;
  district?: string;
  imageUrl?: string;
  imageMobileUrl?: string;
  imageAlt?: string;
  placeType?: string;
  blessings?: string;
  objectHero?: string;
  latitude?: number;
  longitude?: number;
};

type CollectionMeta = {
  key: "popular" | "sacred" | "mu";
  label: string;
  shortLabel: string;
  kicker: string;
  title: string;
  description: string;
  intro: string;
  accent: string;
  heroBg: string;
  mapTitle: string;
  mapSearchPlaceholder: string;
  searchLabel: string;
  searchPlaceholder: string;
  gridLabel: string;
  emptyText: string;
  imageAlt: string;
};

type Breadcrumb = {
  label: string;
  href?: string;
};

const {
  collection,
  pageKey,
  pageTitle,
  pageDescription,
  canonicalPath,
  breadcrumbs,
  meta,
  rankedTemples,
  regions,
  purposes,
  structuredData,
  initialCount = 16,
  batchSize = 16,
} = Astro.props as {
  collection: "popular" | "sacred" | "mu";
  pageKey: string;
  pageTitle: string;
  pageDescription: string;
  canonicalPath: string;
  breadcrumbs: Breadcrumb[];
  meta: CollectionMeta;
  rankedTemples: TempleCard[];
  regions: string[];
  purposes: string[];
  structuredData: Record<string, unknown> | Record<string, unknown>[];
  initialCount?: number;
  batchSize?: number;
};

const collectionTabs = [
  { key: "popular", label: "วัดดังน่าไป", href: "/temples/popular/" },
  { key: "sacred", label: "วัดเด่นขอพร", href: "/temples/sacred/" },
  { key: "mu", label: "พิกัดสายมู", href: "/temples/mu/" },
];
const supportingLinks = [
  { label: "พิกัดสายมู", href: "/temples/mu/" },
  { label: "คู่มือวางแผนไหว้พระ", href: "/temples/" },
  { label: "วัดดังน่าไป", href: "/temples/popular/" },
  { label: "วัดเด่นขอพร", href: "/temples/sacred/" },
  { label: "วัดทั่วประเทศไทย", href: "/temples/thailand/" },
];
const plannerHrefFor = (temple: TempleCard) =>
  `/temples/planner/?start=${encodeURIComponent(temple.name)}&province=${encodeURIComponent(temple.province)}`;
const collectionDataSrc = `/assets/data/temple-collections/${collection}.json`;
const initialTemples = rankedTemples.slice(0, initialCount);
const banner = templePageBanners[collection];
const cardKeyFor = (temple: TempleCard) => `${collection}:${temple.rank}`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  lang="th"
  locale="th"
  page={pageKey}
  bodyClass={`temples-hub-page temples-collection-v2-page temples-collection-v2-page--${collection}`}
  canonicalPath={canonicalPath}
  image="/assets/images/hero-temple-red.jpg"
  imageAlt={meta.imageAlt}
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
>
  <main
    class="temples-collection-v2"
  >
    <PageBanner titleId="temple-collection-title" class="collection-banner" adminKey={banner.adminKey}>
      <CmsImage slot="media" mediaId={`temple-${collection}-banner`} image={{ src: banner.imageUrl, alt: banner.imageAlt, position: banner.focalPoint, credit: banner.imageSourceLabel, sourceUrl: banner.imageSourceUrl }} width={1920} height={1080} loading="eager" fetchpriority="high" />
      <div class="page-banner__copy">
        <nav class="page-banner__breadcrumb" aria-label="เส้นทางนำทาง">
          {breadcrumbs.map((item, index) => (
            <>
              {item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>}
              {index < breadcrumbs.length - 1 && <span aria-hidden="true">/</span>}
            </>
          ))}
        </nav>

        <div class="temple-collection-v2-tabs" aria-label="หมวดวัด">
          {collectionTabs.map((tab) => (
            <a class={tab.key === collection ? "is-active" : undefined} aria-current={tab.key === collection ? "page" : undefined} href={tab.href}>{tab.label}</a>
          ))}
        </div>

        <p class="page-banner__kicker" data-cms-field="collection-kicker">{meta.kicker}</p>
        <h1 id="temple-collection-title" data-cms-field="collection-heading">{meta.title}</h1>
        <p class="page-banner__description" data-cms-field="collection-description">{meta.description}</p>
        <p class="collection-quote"><SiteIcon name="quote" /><span data-cms-field="collection-quote">พบวัดดี สถานที่เป็นมงคล และวางแผนเส้นทางได้ในที่เดียว</span></p>

      </div>
    </PageBanner>

    <PopularFilters regions={regions} purposes={purposes} />

    <section class="temples-section temple-collection-v2-results">
      <div class="temple-collection-v2-results-head">
        <h2 class="sr-only">{meta.gridLabel}</h2>
        <p class="collection-result-total" data-collection-total>พบ {rankedTemples.length} {collection === "popular" ? "วัด" : "สถานที่"}</p>
        <div class="collection-result-tools">
          <TempleMapOverlay
            collection={collection}
            title={meta.mapTitle}
            searchPlaceholder={meta.mapSearchPlaceholder}
            temples={rankedTemples}
            placeholderImage={templePlaceholderImage}
          />
          <p class="popular-temple-count" data-popular-temple-count></p>
          <label class="collection-sort">
            <span class="sr-only">เรียงตาม</span>
            <select data-collection-sort aria-label="เรียงตาม">
              <option value="rank">อันดับแนะนำ</option>
              <option value="name">ชื่อ ก–ฮ</option>
              <option value="province">จังหวัด ก–ฮ</option>
              <option value="nearby" disabled>ใกล้ฉัน</option>
            </select>
          </label>
        </div>
      </div>

      <div
        class="popular-temple-grid temple-collection-v2-grid"
        aria-label={meta.gridLabel}
        data-popular-temple-grid
        data-collection={collection}
        data-collection-data-src={collectionDataSrc}
        data-result-unit={collection === "popular" ? "วัด" : "สถานที่"}
        data-mobile-count="6"
        data-initial-count={initialCount}
        data-batch-size={batchSize}
        data-count-mode="visible-filtered"
        data-placeholder-src={templePlaceholderImage}
      >
        {initialTemples.map(temple => <Fragment set:html={renderTempleCollectionCard({
          ...temple,
          key: cardKeyFor(temple),
          detailUrl: getTempleDetailUrl(collection, temple),
          plannerUrl: plannerHrefFor(temple),
        }, templePlaceholderImage)} />)}
      </div>

      <p class="popular-temple-empty" data-popular-temple-empty hidden>{meta.emptyText}</p>
      <button class="popular-temple-load-more" type="button" data-popular-temple-more hidden>
        แสดงเพิ่มเติม <SiteIcon name="chevron-down" />
      </button>

      <aside class="temple-collection-v2-planner" aria-label="วางแผนเส้นทางจากสถานที่ที่เลือก">
        <BrandOrnament /><BrandOrnament mirrored />
        <SiteIcon name="route" class="collection-planner-icon" />
        <div class="collection-planner-copy">
          <p data-cms-field="collection-planner-kicker">วางแผนการเดินทาง</p>
          <h2 data-cms-field="collection-planner-heading">จัดลำดับเส้นทางจากสถานที่ที่เลือก</h2>
          <span data-cms-field="collection-planner-description">เพิ่มวัดจากหน้าค้นหา แล้วเปิดเครื่องมือวางแผนเพื่อจัดเส้นทางที่ต่อเนื่องตามพิกัดและเวลาเปิดของสถานที่</span>
        </div>
        <a href="/temples/planner/">วางแผนเส้นทาง <SiteIcon name="arrow-right" /></a>
      </aside>

      <nav class="temple-collection-v2-supporting" aria-label="หมวดอื่น">
        <span>หมวดอื่น</span>
        <a href="/contact/#corrections">แจ้งแก้ไขข้อมูล</a>
        {supportingLinks.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>

      <div class="popular-temple-sentinel" data-popular-temple-sentinel aria-hidden="true"></div>
    </section>
  </main>

  <script>
    import "../scripts/temple-directory.js";
    import "../scripts/temple-map.js";
  </script>
</BaseLayout>
