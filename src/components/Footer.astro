---
import { siteConfig } from "../config/site.js";
import BrandMark from "./icons/BrandMark.astro";
import BrandOrnament from "./BrandOrnament.astro";
import SiteIcon from "./icons/SiteIcon.astro";
import "../styles/public-footer.css";

type FooterLink = {
  label: string;
  href: string;
};
type PageConfig = {
  footerLinks?: FooterLink[];
  footerVariant?: string;
};

const { locale = "th", page = "home" } = Astro.props as {
  locale?: "th";
  page?: string;
};
const config = siteConfig[locale] || siteConfig.th;
const footerCopy = config.copy?.footer || {};
const pages = config.pages as Record<string, PageConfig>;
const pageConfig = pages[page] || pages.home;

function resolveHref(href = "") {
  if (!href) return "/";
  if (/^(https?:|mailto:|tel:)/.test(href)) return href;
  if (href.startsWith("#")) return `/${href}`;
  if (href.startsWith("/")) return href;
  return `/${href}`;
}

const footerLinks = pageConfig.footerLinks || [];
const templeRouteLinks = footerCopy.templeRoutes || [
  { label: "วางแผนไหว้พระ", href: "/temples/planner/" },
  { label: "วัดดังน่าไป", href: "/temples/popular/" },
  { label: "วัดเด่นขอพร", href: "/temples/sacred/" },
  { label: "พิกัดสายมู", href: "/temples/mu/" },
];
const toolLinks = footerCopy.tools || [
  { label: "ปฏิทินไทย", href: "/calendar/" },
  { label: "คำเซียมซี", href: "/horoscope/seamsi/" },
  { label: "ไพ่ยิปซีรายวัน", href: "/tarot/daily/" },
];
---

  <footer class:list={["site-footer", "site-footer--home-v2", { "site-footer--ivory": page === "calendarDay" }]} id="consult">
    <BrandOrnament /><BrandOrnament mirrored />
    <div class="site-footer-home-grid">
      <div class="site-footer-home-brand">
        <BrandMark class="site-footer-brand-lockup" variant="lockup" loading="lazy" />
        <p data-cms-field="9f7d7eae-1">{footerCopy.homeDescription || config.footer.description}</p>
      </div>
      <details class="site-footer-home-links" data-home-footer-links open>
        <summary data-cms-field="9f7d7eae-2">เส้นทางและเครื่องมือ <SiteIcon name="chevron-right" /></summary>
        <div class="site-footer-home-navs">
          <nav aria-label={footerCopy.templeRoutesLabel || "เส้นทางและสถานที่"}>
            <strong data-cms-field="9f7d7eae-3">{footerCopy.templeRoutesLabel || "เส้นทางและสถานที่"}</strong>
            {templeRouteLinks.map((item: FooterLink) => (
              <a data-cms-field="9f7d7eae-4" href={resolveHref(item.href)}>{item.label}</a>
            ))}
          </nav>
          <nav aria-label={footerCopy.toolsLabel || "เครื่องมือเสริม"}>
            <strong data-cms-field="9f7d7eae-5">{footerCopy.toolsLabel || "เครื่องมือเสริม"}</strong>
            {toolLinks.map((item: FooterLink) => (
              <a data-cms-field="9f7d7eae-6" href={resolveHref(item.href)}>{item.label}</a>
            ))}
            {footerLinks.map((item: FooterLink) => (
              <a data-cms-field="9f7d7eae-7" href={resolveHref(item.href)}>{item.label}</a>
            ))}
          </nav>
        </div>
      </details>
      <div class="site-footer-home-action">
        <span data-cms-field="9f7d7eae-8">เริ่มต้นการเดินทาง</span>
        <a data-cms-field="9f7d7eae-9" href="/temples/planner/">วางแผนไหว้พระ <SiteIcon name="arrow-right" /></a>
        <a data-cms-field="9f7d7eae-10" class="site-footer-home-calendar" href="/calendar/">ดูปฏิทินไทย <SiteIcon name="arrow-right" /></a>
        <button class="pdpa-reopen" data-pdpa-reopen type="button" aria-haspopup="dialog" hidden>ตั้งค่าคุกกี้</button>
      </div>
    </div>
    <div class="site-footer-home-bottom"><small data-cms-field="9f7d7eae-11">© {new Date().getFullYear() + 543} มงคลเวลา</small><small data-cms-field="9f7d7eae-12">ควรตรวจสอบข้อมูลสถานที่ก่อนออกเดินทาง</small></div>
    <p class="pdpa-storage-status" data-pdpa-storage-status role="status"></p>
  </footer>

<script>
  const links = document.querySelector<HTMLDetailsElement>("[data-home-footer-links]");
  if (links) {
    const desktop = matchMedia("(min-width: 721px)");
    const sync = () => { links.open = desktop.matches; };
    sync();
    desktop.addEventListener("change", sync);
  }
</script>
