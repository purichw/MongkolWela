---
import { siteConfig } from "../config/site.js";
import BrandMark from "./icons/BrandMark.astro";
import BrandOrnament from "./BrandOrnament.astro";
import SiteIcon from "./icons/SiteIcon.astro";
import "../styles/public-footer.css";

type FooterLink = {
  label: string;
  href: string;
};
type PageConfig = {
  footerLinks?: FooterLink[];
  footerVariant?: string;
};

const { locale = "th", page = "home" } = Astro.props as {
  locale?: "th";
  page?: string;
};
const config = siteConfig[locale] || siteConfig.th;
const footerCopy = config.copy?.footer || {};
const pages = config.pages as Record<string, PageConfig>;
const pageConfig = pages[page] || pages.home;
const isPopularDirectory = page === "templesPopular";
const isPlaceDetail = /^\/temples\/(popular|sacred|mu)\/[^/]+\/?$/.test(Astro.url.pathname);
const usesEditorialFooter = ["home", "calendar", "calendarDay"].includes(page) || isPlaceDetail;
const isTempleHubPage = page === "temples";
const isTemplePlannerPage = page === "templesPlanner";
const isTempleCollectionPage = ["templesPopular", "templesSacred", "templesMu"].includes(page);
const isTempleV2Page = isTempleHubPage || isTempleCollectionPage || isTemplePlannerPage;

function resolveHref(href = "") {
  if (!href) return "/";
  if (/^(https?:|mailto:|tel:)/.test(href)) return href;
  if (href.startsWith("#")) return `/${href}`;
  if (href.startsWith("/")) return href;
  return `/${href}`;
}

const footerLinks = pageConfig.footerLinks || [
  { label: config.footer.contact, href: "#consult" },
];
const templeRouteLinks = footerCopy.templeRoutes || [
  { label: "วางแผนไหว้พระ", href: "/temples/planner/" },
  { label: "เส้นทางไหว้พระ ๙ วัด", href: "/temples/popular/" },
  { label: "วัดศักดิ์สิทธิ์", href: "/temples/sacred/" },
  { label: "สถานที่มงคล", href: "/temples/mu/" },
];
const toolLinks = footerCopy.tools || [
  { label: "ปฏิทินไทย", href: "/calendar/" },
  { label: "คำเซียมซี", href: "/horoscope/seamsi/" },
  { label: "ไพ่ยิปซีรายวัน", href: "/tarot/daily/" },
];
---

{isPopularDirectory && !isTempleCollectionPage ? (
  <footer class="site-footer site-footer--popular-directory" id="consult">
    <div class="site-footer-popular-brand">
      <BrandMark class="site-footer-brand-lockup" variant="lockup" loading="lazy" />
    </div>
    <p>ค้นหาวัดดัง สถานที่ศักดิ์สิทธิ์ และเส้นทางไหว้พระเสริมมงคลสำหรับผู้ใช้ไทย</p>
  </footer>
) : usesEditorialFooter ? (
  <footer class:list={["site-footer", "site-footer--home-v2", { "site-footer--ivory": page === "calendarDay" }]} id="consult">
    <BrandOrnament /><BrandOrnament mirrored />
    <div class="site-footer-home-grid">
      <div class="site-footer-home-brand">
        <BrandMark class="site-footer-brand-lockup" variant="lockup" loading="lazy" />
        <p>{footerCopy.homeDescription || config.footer.description}</p>
      </div>
      <details class="site-footer-home-links" data-home-footer-links open>
        <summary>เส้นทางและเครื่องมือ <SiteIcon name="chevron-right" /></summary>
        <div class="site-footer-home-navs">
          <nav aria-label={footerCopy.templeRoutesLabel || "เส้นทางและสถานที่"}>
            <strong>{footerCopy.templeRoutesLabel || "เส้นทางและสถานที่"}</strong>
            {templeRouteLinks.map((item: FooterLink) => (
              <a href={resolveHref(item.href)}>{item.label}</a>
            ))}
          </nav>
          <nav aria-label={footerCopy.toolsLabel || "เครื่องมือเสริม"}>
            <strong>{footerCopy.toolsLabel || "เครื่องมือเสริม"}</strong>
            {toolLinks.map((item: FooterLink) => (
              <a href={resolveHref(item.href)}>{item.label}</a>
            ))}
          </nav>
        </div>
      </details>
      <div class="site-footer-home-action">
        <span>เริ่มต้นการเดินทาง</span>
        <a href="/temples/planner/">วางแผนไหว้พระ <SiteIcon name="arrow-right" /></a>
        <a class="site-footer-home-calendar" href="/calendar/">ดูปฏิทินไทย <SiteIcon name="arrow-right" /></a>
      </div>
    </div>
    <div class="site-footer-home-bottom"><small>© {new Date().getFullYear() + 543} มงคลเวลา</small><small>ควรตรวจสอบข้อมูลสถานที่ก่อนออกเดินทาง</small></div>
  </footer>
) : isTempleV2Page ? (
  <footer class="site-footer site-footer--temple-hub-v2" id="consult">
    <div class="site-footer-temple-hub-grid">
      <div class="site-footer-temple-hub-brand">
        <BrandMark class="site-footer-brand-lockup" variant="lockup" loading="lazy" />
        <p>{footerCopy.templeDescription || config.footer.description}</p>
      </div>
      <nav aria-label={footerCopy.templeRoutesLabel || "เส้นทางและสถานที่"}>
        <strong>{footerCopy.templeRoutesLabel || "เส้นทางและสถานที่"}</strong>
        {templeRouteLinks.map((item: FooterLink) => (
          <a href={resolveHref(item.href)}>{item.label}</a>
        ))}
      </nav>
      <nav aria-label={footerCopy.toolsLabel || "เครื่องมือเสริม"}>
        <strong>{footerCopy.toolsLabel || "เครื่องมือเสริม"}</strong>
        {toolLinks.map((item: FooterLink) => (
          <a href={resolveHref(item.href)}>{item.label}</a>
        ))}
        <a href="#consult">ติดต่อมงคลเวลา</a>
      </nav>
    </div>
    <p class="credits">{footerCopy.templeCreditNote || "ควรตรวจสอบเวลาเปิด-ปิดก่อนเดินทาง"}</p>
  </footer>
) : (
  <footer class="site-footer" id="consult">
    <div>
      <BrandMark class="site-footer-brand-lockup" variant="lockup" loading="lazy" />
      <p>{config.footer.description}</p>
    </div>
    <div class="footer-links">
      {footerLinks.map((item: FooterLink) => (
        <a href={resolveHref(item.href)}>{item.label}</a>
      ))}
    </div>
  </footer>
)}

<script>
  const links = document.querySelector<HTMLDetailsElement>("[data-home-footer-links]");
  if (links) {
    const desktop = matchMedia("(min-width: 721px)");
    const sync = () => { links.open = desktop.matches; };
    sync();
    desktop.addEventListener("change", sync);
  }
</script>
