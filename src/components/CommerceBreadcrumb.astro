---
import liveContent from "../../public/admin/content/live.json";
import { navigationBreadcrumbs, renderNavigationBreadcrumbs, navigationBreadcrumbJsonLd } from "../lib/navigation-breadcrumbs.js";

const pathname = Astro.url.pathname;
const items = navigationBreadcrumbs(liveContent, pathname);
---
<nav class="commerce-breadcrumb" aria-label="เส้นทางนำทาง" data-navigation-breadcrumb={pathname} set:html={renderNavigationBreadcrumbs(items)} />
<script is:inline type="application/ld+json" data-navigation-breadcrumb-jsonld={pathname} set:html={navigationBreadcrumbJsonLd(items, pathname)} />
