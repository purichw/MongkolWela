---
interface Props {
  title: string;
  kicker: string;
  lead: string;
  breadcrumbs: { label: string; href?: string }[];
  quote?: string;
  ornamentSrc?: string;
}
const { title, kicker, lead, breadcrumbs, quote, ornamentSrc = "/assets/images/ornament-lotus-bodhi.webp" } = Astro.props;
---

<section class="tools-hero" aria-labelledby="tools-title">
  <div class="tools-hero__inner">
    <nav class="tools-breadcrumb" aria-label="เส้นทางนำทาง">
      {breadcrumbs.map((item, index) => (
        <>
          {index > 0 && <span aria-hidden="true">/</span>}
          {item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
        </>
      ))}
    </nav>
    <div class="tools-hero__copy">
      <p class="section-kicker">{kicker}</p>
      <h1 id="tools-title">{title}</h1>
      <p class="tools-hero__lead">{lead}</p>
    </div>
    {quote && <blockquote class="tools-hero__quote">{quote}</blockquote>}
    <img class="tools-hero__ornament" src={ornamentSrc}
      alt="" width="640" height="960" aria-hidden="true" />
  </div>
</section>
