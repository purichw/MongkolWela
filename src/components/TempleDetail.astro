---
import BaseLayout from "../layouts/BaseLayout.astro";
import TempleResponsiveImage from "./TempleResponsiveImage.astro";
import TempleActivities from "./TempleActivities.astro";
import TempleCommerce from "./TempleCommerce.astro";
import SiteIcon from "./icons/SiteIcon.astro";
import IconMedallion from "./IconMedallion.astro";
import BrandOrnament from "./BrandOrnament.astro";
import { getTempleTravel } from "../data/temple-travel.js";
import { getTempleVisitInfo } from "../data/temple-visit-info.js";
import { getTempleCmsRecordMap } from "../data/temple-cms.js";
import { getTempleDetailUrl, createLegacyTempleSlug } from "../data/temple-slugs.js";
import { absoluteUrl, createTempleJsonLd } from "../lib/seo.js";
import { createPlaceModel, renderIdentity, renderImageCredit, renderHighlights, renderLocation, renderVisit, renderTravel, icon } from "../lib/place-detail-view.js";
import "../styles/place-detail.css";

interface Props {
  collection: "popular" | "mu" | "sacred";
  collectionLabel: string;
  collectionHref: string;
  temple: {
    rank: number;
    cmsKey?: string;
    name: string;
    region: string;
    province: string;
    district?: string;
    imageUrl?: string;
    imageMobileUrl?: string;
    detailImageUrl?: string;
    detailImageMobileUrl?: string;
    imageAlt?: string;
    placeType?: string;
    blessings?: string;
    objectHero?: string;
    latitude?: number | null;
    longitude?: number | null;
    plusCode?: string;
    coordinateSource?: string;
    coordinateAddress?: string;
    imageSourceLabel?: string;
    imageSourceUrl?: string;
    travelModes?: string;
    travelDetail?: {
      summary?: string;
      railAccess?: string;
      boatAccess?: string;
      busAccess?: string;
      vanAccess?: string;
      walkAccess?: string;
      sources?: string;
      confidence?: string;
      updatedAt?: string;
      routes?: {
        mode?: string;
        sourceKey?: string;
        stop?: string;
        name?: string;
        title?: string;
        distance?: string;
        distanceText?: string;
        route?: string;
        routeText?: string;
        line?: string;
        operator?: string;
        operatorText?: string;
        type?: string;
        typeText?: string;
        isTransfer?: boolean;
      }[];
    };
  };
  placeholderImage: string;
  relatedTemples?: Props["temple"][];
  content?: any;
}


const { collection, collectionLabel, collectionHref, temple, placeholderImage, relatedTemples = [], content } = Astro.props as Props;
const key = temple.cmsKey || `${collection}:${createLegacyTempleSlug(temple)}`;
const override = getTempleCmsRecordMap(content)[key] || {};
const seed = { key, record: temple, visit: getTempleVisitInfo(temple), collectionLabel, collectionHref, placeholderImage };
const vm = createPlaceModel(seed, override);
const imageUrl = (temple.detailImageUrl ?? temple.imageUrl) || placeholderImage;
const imageMobileUrl = temple.detailImageMobileUrl === "" ? placeholderImage : temple.detailImageMobileUrl ?? imageUrl;
const detailUrl = getTempleDetailUrl(collection, temple);
const title = `${temple.name} | ${collectionLabel} | มงคลเวลา`;
const detailDescription = `${temple.name} ${temple.province} ใน${collectionLabel} พร้อมพิกัด แผนที่ วิธีเดินทาง และข้อมูลเข้าชม`;
const detailBreadcrumbs = [{ label: "หน้าแรก", href: "/" }, { label: "วัดดังเสริมมงคล", href: "/temples/" }, { label: collectionLabel, href: collectionHref }, { label: temple.name, href: detailUrl }];
const templeJsonLd = createTempleJsonLd({ temple, collectionLabel, collectionHref, pageUrl: absoluteUrl(detailUrl), imageUrl: absoluteUrl(imageUrl) });
const rank = Number(temple.rank);
---
<BaseLayout title={title} description={detailDescription} lang="th" locale="th" page="temples" bodyClass="temples-hub-page place-detail-page"
  canonicalPath={detailUrl} image={imageUrl} imageAlt={temple.imageAlt || temple.name} breadcrumbs={detailBreadcrumbs} structuredData={templeJsonLd} liveCmsContent={content}>
  <main class="temple-detail place-detail" data-place-key={key} data-place-detail>
    <div class="pd-page-ornaments" aria-hidden="true"><BrandOrnament /><BrandOrnament mirrored /></div>
    <script is:inline type="application/json" data-place-seed set:html={JSON.stringify(seed).replace(/</g, "\\u003c")} />
    <nav class="pd-back" aria-label="เส้นทางนำทาง">
      <a href={collectionHref}><SiteIcon name="arrow-left" />กลับไป{collectionLabel}</a>
      <ol><li><a href="/">หน้าแรก</a></li><li><a href="/temples/">วัดดังเสริมมงคล</a></li><li><a href={collectionHref}>{collectionLabel}</a></li><li aria-current="page" data-place-breadcrumb>{temple.name}</li></ol>
    </nav>
    <section class="pd-hero" aria-labelledby="temple-detail-title">
      <figure class="pd-hero-media" data-place-media>
        <TempleResponsiveImage desktopSrc={imageUrl} mobileSrc={imageMobileUrl} alt={temple.imageAlt || temple.name} loading="eager" decoding="async" fetchpriority="high" fallbackSrc={placeholderImage} />
        <figcaption data-place-rank hidden={!Number.isFinite(rank) || rank <= 0}>#{String(rank).padStart(2, "0")} {collectionLabel}</figcaption>
        <span class="pd-image-credit" data-pd-domain="imageCredit" set:html={renderImageCredit(vm)} />
        <button class="pd-photo-open" type="button" data-photo-open data-pd-enhanced hidden><SiteIcon name="maximize-2" />ดูภาพขนาดใหญ่</button>
      </figure>
      <div class="pd-hero-copy">
        <SiteIcon name="temple" class="pd-title-mark" />
        <div data-pd-domain="identity" set:html={renderIdentity(vm)} />
        <div class="pd-actions" aria-label="การทำงานของหน้า">
          <a class="pd-button pd-button--primary" href={vm.mapHref} hidden={!vm.mapHref} data-place-map-link target="_blank" rel="noopener"><Fragment set:html={icon("map-pin")} />เปิดแผนที่</a>
          <button class="pd-button" type="button" data-temple-detail-share data-pd-enhanced hidden><Fragment set:html={icon("share-2")} />แชร์</button>
          <button class="pd-button" type="button" data-temple-detail-copy data-pd-enhanced hidden><Fragment set:html={icon("link")} />คัดลอกลิงก์</button>
        </div>
      </div>
    </section>
    <div class="pd-overview">
      <section class="pd-highlights pd-surface" aria-labelledby="pd-highlights-title">
        <header class="pd-section-heading"><IconMedallion class="pd-medallion"><SiteIcon name="lotus" /></IconMedallion><h2 id="pd-highlights-title">จุดเด่นของสถานที่นี้</h2></header>
        <div class="pd-highlight-copy" data-pd-domain="highlights" set:html={renderHighlights(vm)} />
      </section>
      <section class="pd-location pd-surface" aria-label="พิกัดและที่อยู่">
        <header class="pd-section-heading"><IconMedallion class="pd-medallion"><SiteIcon name="map-pin" /></IconMedallion><h2>ตำแหน่งที่ตั้ง</h2></header>
        <div class="pd-map-frame" data-place-map-frame>
          <div class="pd-map-canvas" data-temple-detail-map data-lat={vm.coords?.[0] ?? ""} data-lng={vm.coords?.[1] ?? ""} data-title={vm.record.name} data-map-url={vm.mapHref} data-address={vm.record.coordinateAddress || ""} aria-hidden="true"></div>
          <p class="pd-map-status" data-map-status role="status">{vm.coords ? "เปิดพิกัดผ่าน Google Maps ด้านล่าง" : "ยังไม่มีพิกัดสำหรับแผนที่ภายใน"}</p>
          <button type="button" class="pd-map-expand" data-map-open data-pd-enhanced hidden><span class="pd-button"><SiteIcon name="maximize-2" />ขยายแผนที่</span></button>
          <a class="pd-map-external pd-button pd-button--jade" href={vm.mapHref} hidden={!vm.mapHref} data-place-map-link target="_blank" rel="noopener">Google Maps <SiteIcon name="arrow-right" /></a>
          <button type="button" class="pd-map-retry pd-button" data-map-retry hidden>ลองโหลดแผนที่ใหม่</button>
          <small class="pd-map-attribution">Map tiles © Esri</small>
          <noscript><p class="pd-map-noscript">เปิดพิกัดผ่าน Google Maps ด้านล่าง</p></noscript>
        </div>
        <div data-pd-domain="location" set:html={renderLocation(vm)} />
      </section>
      <section class="pd-visit pd-surface" aria-labelledby="pd-visit-title">
        <header class="pd-section-heading"><IconMedallion class="pd-medallion"><SiteIcon name="altar" /></IconMedallion><h2 id="pd-visit-title">ข้อมูลเข้าชมและติดต่อ</h2></header>
        <div data-pd-domain="visit" set:html={renderVisit(vm)} />
      </section>
    </div>
    <section class="pd-travel" aria-label="ข้อมูลการเดินทาง" data-pd-domain="travel" set:html={renderTravel(getTempleTravel(temple.travelDetail), vm.record)} />
    <div class="pd-community">
      <TempleActivities templeId={key} />
      <TempleCommerce templeId={key} />
    </div>
    <aside class="pd-merit-banner">
      <SiteIcon name="lotus" class="pd-merit-icon" />
      <div><h2 data-cms-field="be8f616d-6">ร่วมสร้างบุญได้หลากหลายช่องทาง</h2><p data-cms-field="be8f616d-7">ติดตามประกาศจากทางวัด เพื่อรับทราบกิจกรรมและช่องทางร่วมบุญ</p></div>
      <a href="/merit/">ดูช่องทางร่วมบุญ <SiteIcon name="arrow-right" /></a>
    </aside>
    {relatedTemples.length > 0 && <section class="pd-related" aria-labelledby="pd-related-title">
      <header class="pd-section-heading"><IconMedallion class="pd-medallion"><SiteIcon name="temple" /></IconMedallion><div><h2 id="pd-related-title">แนะนำในชุดเดียวกัน</h2><p>{collectionLabel}</p></div><a class="pd-all-link" href={collectionHref}>ดูทั้งหมด <SiteIcon name="arrow-right" /></a></header>
      <div class="pd-related-rail" data-related-rail>
        {relatedTemples.slice(0, 3).map(item => <a href={getTempleDetailUrl(collection, item)} data-temple-key={item.cmsKey || `${collection}:${createLegacyTempleSlug(item)}`} class="pd-related-card">
          <div class="pd-related-image"><TempleResponsiveImage desktopSrc={item.imageUrl || placeholderImage} mobileSrc={item.imageMobileUrl === "" ? placeholderImage : item.imageMobileUrl ?? item.imageUrl} alt={item.imageAlt ?? item.name} loading="lazy" decoding="async" fallbackSrc={placeholderImage} />{Number(item.rank) > 0 && <span>#{String(item.rank).padStart(2, "0")}</span>}</div>
          <div class="pd-related-copy"><div><strong>{item.name}</strong><small>{[item.province, item.district].filter(Boolean).join(" · ")}</small></div><SiteIcon name="chevron-right" /></div>
        </a>)}
      </div>
      <div class="pd-rail-controls" data-related-controls hidden><button type="button" aria-label="สถานที่ก่อนหน้า" data-related-prev><SiteIcon name="chevron-left" /></button><span data-related-count role="status">1 / {Math.min(relatedTemples.length, 3)}</span><button type="button" aria-label="สถานที่ถัดไป" data-related-next><SiteIcon name="chevron-right" /></button></div>
    </section>}
    <div class="pd-sr-only" role="status" data-place-status></div>
  </main>
  <script>import "../scripts/temple-detail.js";</script>
</BaseLayout>
