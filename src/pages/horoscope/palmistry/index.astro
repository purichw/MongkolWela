---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import FeaturePageHero from "../../../components/FeaturePageHero.astro";
import PalmistryHandDiagram from "../../../components/PalmistryHandDiagram.astro";
import PalmLineWidget from "../../../components/PalmLineWidget.astro";

const extraScripts = ["/assets/js/palmistry.js"];
const extraStyles = ["/assets/css/palmistry.css?feature=20260612-09"];

const breadcrumbs = [
  { label: "หน้าแรก", href: "/" },
  { label: "เครื่องมือเสริม", href: "/#supporting-tools" },
  { label: "อ่านลายมือ" },
];
---

<BaseLayout
  title="ดูลายมือซ้าย มือขวา และมือถนัด | มงคลเวลา"
  description="ดูลายมือซ้าย มือขวา หรือเทียบสองมือ เลือกลักษณะเส้นชีวิต เส้นสมอง เส้นหัวใจ และเส้นวาสนา พร้อมแปลพื้นฐานเดิม สิ่งที่พัฒนา และแนวโน้มปัจจุบัน"
  lang="th"
  locale="th"
  page="palmistry"
  bodyClass="palmistry-page feature-template-page"
  extraStyles={extraStyles}
  extraScripts={extraScripts}
  canonicalPath="/horoscope/palmistry/"
  breadcrumbs={breadcrumbs}
>
  <main>
    <FeaturePageHero
      class="palm-hero"
      breadcrumbs={breadcrumbs}
      kicker="หัตถศาสตร์ไทย-first"
      title="อ่านลายมือ"
      lead="เลือกมือที่ต้องการอ่านและลักษณะเส้นที่เห็นชัด ระบบจะแยกความหมายพื้นฐานออกจากบริบทของมือถนัด มือไม่ถนัด และการเปรียบเทียบสองมือ"
      mediaLabel="แผนภาพเส้นหลักบนฝ่ามือ"
      mediaWidth="400px"
      mediaAlign="center"
    >
      <PalmistryHandDiagram slot="media" />
    </FeaturePageHero>

    <section class="palm-hand-context" aria-labelledby="palm-hand-context-title">
      <div class="palm-hand-context__head">
        <div>
          <p class="section-kicker">ก่อนเริ่มอ่าน</p>
          <h2 id="palm-hand-context-title">มือแต่ละข้างบอกคนละชั้นของเรื่องเดียวกัน</h2>
        </div>
        <p>
          ในเครื่องมือนี้ “ซ้าย” หรือ “ขวา” ไม่ได้มีความหมายตายตัว ระบบจะถามมือที่ถนัดก่อน
          แล้วใช้บทบาทของมือเป็นหลักตามตำราไทยและแนวเทียบมือร่วมสมัย
        </p>
      </div>
      <div class="palm-hand-context__grid">
        <article>
          <span>01</span>
          <h3>มือไม่ถนัด</h3>
          <p>ใช้มองพื้นฐานเดิม ธรรมชาติภายใน ศักยภาพ และแนวโน้มที่ติดตัวมาก่อนการปรับตัว</p>
        </article>
        <article>
          <span>02</span>
          <h3>มือถนัด</h3>
          <p>ใช้มองสิ่งที่พัฒนาขึ้น การตัดสินใจ พฤติกรรม และแนวทางที่กำลังแสดงออกในชีวิตปัจจุบัน</p>
        </article>
        <article>
          <span>03</span>
          <h3>เทียบสองมือ</h3>
          <p>ใช้ดูว่าพื้นฐานเดิมคงอยู่ เด่นขึ้น อ่อนลง หรือเปลี่ยนรูปแบบ โดยไม่ฝืนตัดสินทุกความต่างว่าเป็นดีหรือร้าย</p>
        </article>
      </div>
    </section>

    <section class="palm-lines-reference" id="palmistry-tool">
      <PalmLineWidget />
    </section>

    <section class="palm-method">
      <div class="palm-method-head">
        <div>
          <p class="section-kicker">วิธีกันผลมั่ว</p>
          <h2>อ่านเฉพาะสิ่งที่ตรวจย้อนกลับได้</h2>
        </div>
      </div>
      <div class="palm-guide-grid" data-palm-line-guide></div>
    </section>

    <section class="palm-sources">
      <details class="palm-source-disclosure">
        <summary>แหล่งข้อมูลที่ใช้ยืนยัน</summary>
        <ul>
          <li>
            <a href="https://www.gutenberg.org/ebooks/20480" target="_blank" rel="noreferrer">
              <strong>Cheiro - Palmistry for All</strong>
              <span>ตำราคลาสสิก public-domain ใช้เป็นฐานตำแหน่งเส้นและคำอ่านแบบตะวันตก</span>
            </a>
          </li>
          <li>
            <a href="https://www.gutenberg.org/cache/epub/20480/pg20480-images.html" target="_blank" rel="noreferrer">
              <strong>Project Gutenberg ฉบับภาพประกอบ</strong>
              <span>ใช้เทียบชื่อบทและภาพประกอบของเส้น Head, Life, Fate, Sun และ Heart</span>
            </a>
          </li>
          <li>
            <a href="https://digital.nlt.go.th/dlib/items/show/2115" target="_blank" rel="noreferrer">
              <strong>หอสมุดแห่งชาติ - ตำรานรลักษณ์</strong>
              <span>ใช้วางกรอบคำอ่านไทย-first และแยก “วาสนา/บารมี” ออกจากศัพท์ palmistry ตะวันตก</span>
            </a>
          </li>
          <li>
            <a href="https://palmistrypath.com/learn/lines/" target="_blank" rel="noreferrer">
              <strong>Palmistry Path - The Lines</strong>
              <span>ใช้ cross-check โครงเส้นหลักและแนวทางอ่านแบบไม่แยกเส้นโดด ๆ</span>
            </a>
          </li>
          <li>
            <a href="https://www.palmseer.com/insights/five-major-lines-in-palmistry" target="_blank" rel="noreferrer">
              <strong>PalmSeer - Five Major Lines</strong>
              <span>ใช้เทียบภาษาสมัยใหม่ และย้ำว่าเส้นชีวิตไม่ใช่การทำนายอายุขัย</span>
            </a>
          </li>
          <li>
            <a href="https://www.mahamongkol.com/m/content.php?id=831" target="_blank" rel="noreferrer">
              <strong>มหามงคล - พื้นฐานหัตถศาสตร์</strong>
              <span>ใช้ยืนยันหลักมือถนัด มือไม่ถนัด และการเปรียบเทียบพัฒนาการระหว่างสองมือ</span>
            </a>
          </li>
          <li>
            <a href="https://www.mahamongkol.com/m/tag.php?id=215" target="_blank" rel="noreferrer">
              <strong>มหามงคล - หมวดดูลายมือ</strong>
              <span>ใช้เทียบหลักอดีต ปัจจุบัน อนาคต และข้อแนะนำให้พิจารณามือทั้งสองข้าง</span>
            </a>
          </li>
          <li>
            <a href="https://www.mahamodo.com/modo/maha_handfortune/handfortune_data_topic_list.aspx?id=" target="_blank" rel="noreferrer">
              <strong>มหาหมอดู - หัตถศาสตร์</strong>
              <span>ใช้ยืนยันการยึดมือถนัดสำหรับปัจจุบัน พร้อมเทียบสองมือเพื่อเพิ่มบริบท</span>
            </a>
          </li>
          <li>
            <a href="https://www.wongnai.com/beauty-tips/palm-reading" target="_blank" rel="noreferrer">
              <strong>Wongnai - วิธีดูลายมือเบื้องต้น</strong>
              <span>ใช้เทียบแนวตำราไทยที่แบ่งบทบาทมือซ้ายและขวาตามเพศ โดยเก็บเป็นข้อสังเกต ไม่ใช้เป็นค่าเริ่มต้นของระบบ</span>
            </a>
          </li>
        </ul>
      </details>
    </section>
  </main>
</BaseLayout>
