---
import ToolsLayout from "../../../layouts/ToolsLayout.astro";
import ToolsHero from "../../../components/ToolsHero.astro";
import PalmistryHandDiagram from "../../../components/PalmistryHandDiagram.astro";
import PalmLineWidget from "../../../components/PalmLineWidget.astro";
import SiteIcon from "../../../components/icons/SiteIcon.astro";

const features = [
  { icon: "hand" as const, title: "ทีละเรื่อง", copy: "สังเกตเส้นที่เห็นชัด" },
  { icon: "book-open" as const, title: "เข้าใจง่าย", copy: "คำอ่านพร้อมบริบทของมือ" },
  { icon: "leaf" as const, title: "ใช้เพื่อแนวทาง", copy: "ทบทวนและพัฒนาตัวเอง" },
  { icon: "shield-check" as const, title: "ข้อมูลเป็นส่วนตัว", copy: "รูปอยู่เฉพาะในแท็บนี้" },
];

const breadcrumbs = [
  { label: "หน้าแรก", href: "/" },
  { label: "เครื่องมือเสริม", href: "/#supporting-tools" },
  { label: "อ่านลายมือ" },
];
---

<ToolsLayout
  title="ดูลายมือซ้าย มือขวา และมือถนัด | มงคลเวลา"
  description="ดูลายมือซ้าย มือขวา หรือเทียบสองมือ เลือกลักษณะเส้นชีวิต เส้นสมอง เส้นหัวใจ และเส้นวาสนา พร้อมแปลพื้นฐานเดิม สิ่งที่พัฒนา และแนวโน้มปัจจุบัน"
  lang="th"
  locale="th"
  page="palmistry"
  bodyClass="palmistry-page feature-template-page"
  canonicalPath="/horoscope/palmistry/"
  breadcrumbs={breadcrumbs}
>
  <main>
    <div class="palm-hero">
      <ToolsHero title="อ่านลายมือ" kicker="PALMISTRY" lead="เลือกมือและลักษณะเส้นที่เห็นชัด เพื่ออ่านพื้นฐานเดิม สิ่งที่พัฒนา และเปรียบเทียบสองมืออย่างมีบริบท" quote="เส้นในมือ คือเรื่องราวให้เราเข้าใจตัวเองมากขึ้น" breadcrumbs={[{label:"หน้าแรก",href:"/"},{label:"อ่านลายมือ"}]} />
    </div>
    <ul class="palm-features" aria-label="แนวทางการอ่าน">
      {features.map(item => <li><span class="palm-feature-icon"><SiteIcon name={item.icon} /></span><div><strong data-cms-field="fd3af381-1">{item.title}</strong><p data-cms-field="fd3af381-2">{item.copy}</p></div></li>)}
    </ul>

    <section class="palm-lines-reference" id="palmistry-tool">
      <PalmLineWidget />
    </section>

    <details class="palm-reference-disclosure tools-section">
      <summary data-cms-field="fd3af381-3"><SiteIcon name="hand" />ตำแหน่งเส้น เนินมือ และหลักมือถนัด<SiteIcon name="chevron-down" /></summary>
      <div class="palm-reference-intro"><section class="palm-hand-context" aria-labelledby="palm-hand-context-title">
      <div class="palm-hand-context__head">
        <div>
          <p data-cms-field="fd3af381-4" class="section-kicker">ก่อนเริ่มอ่าน</p>
          <h2 data-cms-field="fd3af381-5" id="palm-hand-context-title">มือแต่ละข้างบอกคนละชั้นของเรื่องเดียวกัน</h2>
        </div>
        <p data-cms-field="fd3af381-6">
          ในเครื่องมือนี้ “ซ้าย” หรือ “ขวา” ไม่ได้มีความหมายตายตัว ระบบจะถามมือที่ถนัดก่อน
          แล้วใช้บทบาทของมือเป็นหลักตามตำราไทยและแนวเทียบมือร่วมสมัย
        </p>
      </div>
      <div class="palm-hand-context__grid">
        <article>
          <span>01</span>
          <h3 data-cms-field="fd3af381-7">มือไม่ถนัด</h3>
          <p data-cms-field="fd3af381-8">ใช้มองพื้นฐานเดิม ธรรมชาติภายใน ศักยภาพ และแนวโน้มที่ติดตัวมาก่อนการปรับตัว</p>
        </article>
        <article>
          <span>02</span>
          <h3 data-cms-field="fd3af381-9">มือถนัด</h3>
          <p data-cms-field="fd3af381-10">ใช้มองสิ่งที่พัฒนาขึ้น การตัดสินใจ พฤติกรรม และแนวทางที่กำลังแสดงออกในชีวิตปัจจุบัน</p>
        </article>
        <article>
          <span>03</span>
          <h3 data-cms-field="fd3af381-11">เทียบสองมือ</h3>
          <p data-cms-field="fd3af381-12">ใช้ดูว่าพื้นฐานเดิมคงอยู่ เด่นขึ้น อ่อนลง หรือเปลี่ยนรูปแบบ โดยไม่ฝืนตัดสินทุกความต่างว่าเป็นดีหรือร้าย</p>
        </article>
      </div>
    </section>

      <PalmistryHandDiagram /></div>
    </details>
  </main>

  <script>
    import "../../../scripts/palmistry.js";
  </script>
</ToolsLayout>
