---
import ToolsLayout from "../../../layouts/ToolsLayout.astro";
import ToolsHero from "../../../components/ToolsHero.astro";


---

<ToolsLayout
  title="ผูกดวงโหราศาสตร์ไทย | มงคลเวลา"
  description="ผูกดวงโหราศาสตร์ไทยเบื้องต้นจากวันเวลาเกิด ลัคนา ภพ 12 ราศี ดาวพระเคราะห์ และดวงจร"
  lang="th"
  locale="th"
  page="thaiAstrology"
  bodyClass="thai-astrology-page"
>
  <main>
      <ToolsHero title="ผูกดวงโหราศาสตร์ไทย" kicker="Thai Astrology" lead="ผูกดวงจากวัน เวลา และสถานที่เกิด พร้อมอ่านความหมายของภพและตำแหน่งดาวตามระบบที่เลือก" breadcrumbs={[{label:"หน้าแรก",href:"/"},{label:"โหราศาสตร์ไทย"}]} quote="รู้ดวง เพื่อรู้ตน และใช้ชีวิตอย่างมีสติ" />

      <section class="thai-astro-tool" id="thai-astrology-tool" data-thai-astrology-output data-state="empty">
        <header class="thai-reading-head" data-astro-heading>
          <h2 data-cms-field="86277e23-1" id="thai-result-title" tabindex="-1">แผนผังดวง</h2>
          <p data-cms-field="86277e23-2">กรอกข้อมูลเพื่อแสดงแผนผัง</p>
        </header>
        <div class="thai-chart-stage" data-astro-wheel></div>
        <form class="thai-astro-form tools-form" id="thai-birth-form" data-thai-astrology-form novalidate>
          <div>
            <p data-cms-field="86277e23-3" class="section-kicker">ข้อมูลผูกดวง</p>
            <h2 data-cms-field="86277e23-4" id="thai-form-title" tabindex="-1">กรอกวันเวลาเกิด</h2>
          </div>

          <label>
            <span data-cms-field="86277e23-5">ชื่อสำหรับแสดงผล</span>
            <input data-cms-field="86277e23-6" name="name" type="text" value="เจ้าชะตา" autocomplete="name" maxlength="80">
          </label>

          <label>
            <span data-cms-field="86277e23-7">วันเดือนปีเกิด</span>
            <input data-cms-field="86277e23-8" name="birthDate" type="date" required>
          </label>

          <div class="thai-astro-form-row tools-form-row">
            <label>
              <span data-cms-field="86277e23-9">ชั่วโมงเกิด</span>
              <select name="birthHour" required data-hour-options></select>
            </label>
            <label>
              <span data-cms-field="86277e23-10">นาทีเกิด</span>
              <select name="birthMinute" required data-minute-options></select>
            </label>
          </div>

          <label>
            <span data-cms-field="86277e23-11">สถานที่เกิด</span>
            <select name="birthPlace">
              <option data-cms-field="86277e23-12" value="bangkok">กรุงเทพมหานคร</option>
              <option data-cms-field="86277e23-13" value="chiangmai">เชียงใหม่</option>
              <option data-cms-field="86277e23-14" value="khonkaen">ขอนแก่น</option>
              <option data-cms-field="86277e23-15" value="songkhla">สงขลา</option>
              <option data-cms-field="86277e23-16" value="phuket">ภูเก็ต</option>
              <option data-cms-field="86277e23-17" value="foreign">ต่างประเทศ / ระบุภายหลัง</option>
            </select>
          </label>

          <div class="thai-astro-form-row tools-form-row thai-astro-mode-row">
            <label>
              <span data-cms-field="86277e23-18">ชนิดดวง</span>
              <select name="chartType">
                <option data-cms-field="86277e23-19" value="natal">ดวงกำเนิด</option>
                <option data-cms-field="86277e23-20" value="transit">ดวงจร</option>
                <option data-cms-field="86277e23-21" value="newmoon">ดวงอมาวสี</option>
                <option data-cms-field="86277e23-22" value="fullmoon">ดวงปูรณมี</option>
              </select>
            </label>
            <label>
              <span data-cms-field="86277e23-23">ระบบคำนวณ</span>
              <select name="calculationSystem">
                <option data-cms-field="86277e23-24" value="suriyayatra">สุริยยาตร์ไทย</option>
                <option data-cms-field="86277e23-25" value="lahiri">นิรายนะ ลาหิรี</option>
              </select>
            </label>
          </div>

          <label>
            <span data-cms-field="86277e23-26">วันจร / วันที่ทำนาย</span>
            <input data-cms-field="86277e23-27" name="transitDate" type="date" required data-transit-date>
          </label>

          <button data-cms-field="86277e23-28" class="primary-action" type="submit">ผูกดวง</button>
          <p class="thai-astro-feedback" data-astro-feedback role="status" aria-live="polite"></p>
          <p data-cms-field="86277e23-29" class="thai-astro-form-note">
            ข้อมูลวันเวลาเกิดใช้ประกอบการผูกดวงตามระบบที่เลือก ผลเป็นการประมาณเบื้องต้น ไม่ใช่คำทำนายที่แน่นอน
          </p>
          <noscript><p data-cms-field="86277e23-30">โปรดเปิด JavaScript เพื่อคำนวณและแสดงแผนผังดวง</p></noscript>
        </form>

        <aside class="thai-chart-summary" data-astro-overview></aside>
        <section class="thai-planet-table-card" id="thai-planet-positions" data-astro-planets></section>
        <section class="thai-reading-section" data-astro-readings></section>
      </section>

    </main>

  <script>
    import "../../../scripts/thai-astrology.js";
  </script>
</ToolsLayout>
