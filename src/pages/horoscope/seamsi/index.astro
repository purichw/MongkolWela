---
import ToolsLayout from "../../../layouts/ToolsLayout.astro";
import ToolsHero from "../../../components/ToolsHero.astro";


---

<ToolsLayout
  title="คำเซียมซี | มงคลเวลา"
  description="คำเซียมซีออนไลน์ ตั้งจิต ภาวนา เขย่ากระบอกเซียมซี รับใบคำทำนายพร้อมคำแนะนำ ข้อควรระวัง และมงคลประจำใบ"
  lang="th"
  locale="th"
  page="seamsi"
  bodyClass="seamsi-page"
>
  <main>
      <ToolsHero title="คำเซียมซี" kicker="Kau Chim Oracle" lead="ตั้งจิตให้สงบ เลือกเรื่องที่ต้องการถาม แล้วเขย่ากระบอกเซียมซีเพื่อรับคำทำนายและข้อคิดสำหรับทบทวนใจ" breadcrumbs={[{label:"หน้าแรก",href:"/"},{label:"คำเซียมซี"}]} />

      <section class="seamsi-shell tools-workspace" id="seamsi-oracle">
        <form class="seamsi-form tools-form" data-seamsi-form>
          <div>
            <p class="section-kicker">ตั้งจิตถาม</p>
            <h2>เลือกเรื่องเดียวก่อนเขย่า</h2>
          </div>

          <label>
            <span>เรื่องที่ต้องการถาม</span>
            <select name="category" data-seamsi-category></select>
          </label>

          <label>
            <span>คำถามในใจ</span>
            <textarea
              name="question"
              maxlength="180"
              data-seamsi-question
              placeholder="เขียนสั้น ๆ เช่น งานนี้ควรเดินหน้าต่อไหม"
            ></textarea>
          </label>

          <button class="primary-action" type="submit" data-seamsi-shake>เขย่าเซียมซี</button>
          <p class="seamsi-form-note">
            ควรถามเฉพาะเรื่องสำคัญ 1-3 เรื่องต่อครั้ง และไม่ควรถามซ้ำเพียงเพื่อได้คำตอบที่ต้องการ
          </p>
        </form>

        <div class="seamsi-main">
          <section class="seamsi-stage tools-panel">
            <div class="seamsi-stage-copy">
              <p class="section-kicker">รับคำทำนาย</p>
              <h2>กดกระบอกเพื่อเขย่าไม้เซียมซี</h2>
              <p>
                หายใจเข้าออกลึก ๆ ตั้งคำถามในใจ แล้วกดกระบอกเซียมซี
                ระบบจะสุ่มใบคำทำนายพร้อม ภาพเคลื่อนไหวของไม้เซียมซีตกจากกระบอก
              </p>
              <p class="seamsi-status" data-seamsi-status aria-live="polite">
                ตั้งจิต เลือกเรื่องที่ถาม แล้วกดกระบอกเซียมซี
              </p>
            </div>

            <div class="seamsi-oracle-wrap">
              <button class="seamsi-oracle" type="button" data-seamsi-oracle aria-label="เขย่ากระบอกเซียมซี">
                <span class="seamsi-stick" data-stick="๑"></span>
                <span class="seamsi-stick" data-stick="๗"></span>
                <span class="seamsi-stick" data-stick="๙"></span>
                <span class="seamsi-stick" data-stick="๑๒"></span>
                <span class="seamsi-stick" data-stick="๒๑"></span>
                <span class="seamsi-stick" data-stick="๒๘"></span>
                <span class="seamsi-falling-stick"></span>
                <span class="seamsi-cup"></span>
              </button>
              <span class="seamsi-tap-hint">แตะกระบอก หรือกดปุ่มเขย่าเซียมซี</span>
            </div>
          </section>

          <section class="seamsi-result" data-seamsi-result aria-live="polite"></section>
        </div>
      </section>

      <section class="seamsi-prayer-section tools-section">
        <div class="seamsi-prayer-grid">
          <div>
            <p class="section-kicker">บทภาวนา</p>
            <h2>กล่าวในใจอย่างสุภาพก่อนรับคำเซียมซี</h2>
          </div>
          <article class="seamsi-prayer-card">
            <p>
              ข้าพเจ้าขอตั้งจิตให้สงบ ระลึกถึงสิ่งศักดิ์สิทธิ์และคุณความดีทั้งหลาย
              ขอให้การรับคำเซียมซีครั้งนี้เป็นแสงเตือนใจ ให้เห็นทางที่ควรเดิน
              รู้สิ่งที่ควรระวัง และมีกำลังใจทำสิ่งที่ถูกต้องด้วยเทอญ
            </p>
          </article>
        </div>
      </section>

      <section class="seamsi-notes tools-section">
        <div class="seamsi-prayer-grid">
          <div>
            <p class="section-kicker">วิธีใช้</p>
            <h2>ใช้ด้วยความเคารพ ไม่ใช่ความร้อนใจ</h2>
          </div>
          <p>
            เซียมซีในหน้านี้เป็นเครื่องมือทบทวนใจและประกอบการตัดสินใจ
            ไม่ใช่คำสั่งตายตัวหรือการรับรองผลลัพธ์ล่วงหน้า
          </p>
        </div>
        <div class="seamsi-note-grid">
          <article>
            <span>01</span>
            <h3>ถามให้ชัด</h3>
            <p>ตั้งคำถามหนึ่งเรื่องต่อหนึ่งครั้ง คำถามที่ชัดทำให้คำทำนายอ่านได้ตรงประเด็นมากขึ้น</p>
          </article>
          <article>
            <span>02</span>
            <h3>เว้นจังหวะ</h3>
            <p>หากยังลังเลหลังได้คำทำนาย ให้พักใจและกลับมาอ่านใหม่ แทนการขอคำตอบซ้ำทันที</p>
          </article>
          <article>
            <span>03</span>
            <h3>ใช้ร่วมกับสติ</h3>
            <p>คำทำนายช่วยชี้มุมมอง แต่การตัดสินใจยังควรอาศัยข้อมูล เหตุผล และความรับผิดชอบ</p>
          </article>
        </div>
      </section>
    </main>

  <script>
    import "../../../scripts/seamsi.js";
  </script>
</ToolsLayout>
