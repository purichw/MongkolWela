---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const mainContent = "<main>\n      <section class=\"seamsi-hero\">\n        <div>\n          <nav class=\"seamsi-breadcrumb\" aria-label=\"breadcrumb\">\n            <a href=\"../../\">หน้าแรก</a>\n            <span>/</span>\n            <span>คำเซียมซี</span>\n          </nav>\n          <p class=\"section-kicker\">Kau Chim Oracle</p>\n          <h1>คำเซียมซี</h1>\n          <p>\n            ตั้งจิตให้สงบ เลือกเรื่องที่ต้องการถาม แล้วเขย่ากระบอกเซียมซี\n            เพื่อรับใบคำทำนายที่เขียนขึ้นใหม่ในน้ำเสียงของมงคลเวลา\n            ไม่มีการอ้างชื่อวัดหรือคัดลอกใบเซียมซีจากสถานที่จริง\n          </p>\n        </div>\n      </section>\n\n      <section class=\"seamsi-shell\" id=\"seamsi-oracle\">\n        <form class=\"seamsi-form\" data-seamsi-form>\n          <div>\n            <p class=\"section-kicker\">ตั้งจิตถาม</p>\n            <h2>เลือกเรื่องเดียวก่อนเขย่า</h2>\n          </div>\n\n          <label>\n            <span>เรื่องที่ต้องการถาม</span>\n            <select name=\"category\" data-seamsi-category></select>\n          </label>\n\n          <label>\n            <span>คำถามในใจ</span>\n            <textarea\n              name=\"question\"\n              maxlength=\"180\"\n              data-seamsi-question\n              placeholder=\"เขียนสั้น ๆ เช่น งานนี้ควรเดินหน้าต่อไหม\"\n            ></textarea>\n          </label>\n\n          <button class=\"primary-action\" type=\"submit\" data-seamsi-shake>เขย่าเซียมซี</button>\n          <p class=\"seamsi-form-note\">\n            ควรถามเฉพาะเรื่องสำคัญ 1-3 เรื่องต่อครั้ง และไม่ควรถามซ้ำเพียงเพื่อได้คำตอบที่ต้องการ\n          </p>\n        </form>\n\n        <div class=\"seamsi-main\">\n          <section class=\"seamsi-stage\">\n            <div class=\"seamsi-stage-copy\">\n              <p class=\"section-kicker\">รับคำทำนาย</p>\n              <h2>กดกระบอกเพื่อเขย่าไม้เซียมซี</h2>\n              <p>\n                หายใจเข้าออกลึก ๆ ตั้งคำถามในใจ แล้วกดกระบอกเซียมซี\n                ระบบจะสุ่มใบคำทำนายพร้อม ภาพเคลื่อนไหวของไม้เซียมซีตกจากกระบอก\n              </p>\n              <p class=\"seamsi-status\" data-seamsi-status aria-live=\"polite\">\n                ตั้งจิต เลือกเรื่องที่ถาม แล้วกดกระบอกเซียมซี\n              </p>\n            </div>\n\n            <div class=\"seamsi-oracle-wrap\">\n              <button class=\"seamsi-oracle\" type=\"button\" data-seamsi-oracle aria-label=\"เขย่ากระบอกเซียมซี\">\n                <span class=\"seamsi-stick\" data-stick=\"๑\"></span>\n                <span class=\"seamsi-stick\" data-stick=\"๗\"></span>\n                <span class=\"seamsi-stick\" data-stick=\"๙\"></span>\n                <span class=\"seamsi-stick\" data-stick=\"๑๒\"></span>\n                <span class=\"seamsi-stick\" data-stick=\"๒๑\"></span>\n                <span class=\"seamsi-stick\" data-stick=\"๒๘\"></span>\n                <span class=\"seamsi-falling-stick\"></span>\n                <span class=\"seamsi-cup\"></span>\n              </button>\n              <span class=\"seamsi-tap-hint\">แตะกระบอก หรือกดปุ่มเขย่าเซียมซี</span>\n            </div>\n          </section>\n\n          <section class=\"seamsi-result\" data-seamsi-result aria-live=\"polite\"></section>\n        </div>\n      </section>\n\n      <section class=\"seamsi-prayer-section\">\n        <div class=\"seamsi-prayer-grid\">\n          <div>\n            <p class=\"section-kicker\">บทภาวนา</p>\n            <h2>กล่าวในใจอย่างสุภาพก่อนรับคำเซียมซี</h2>\n          </div>\n          <article class=\"seamsi-prayer-card\">\n            <p>\n              ข้าพเจ้าขอตั้งจิตให้สงบ ระลึกถึงสิ่งศักดิ์สิทธิ์และคุณความดีทั้งหลาย\n              ขอให้การรับคำเซียมซีครั้งนี้เป็นแสงเตือนใจ ให้เห็นทางที่ควรเดิน\n              รู้สิ่งที่ควรระวัง และมีกำลังใจทำสิ่งที่ถูกต้องด้วยเทอญ\n            </p>\n          </article>\n        </div>\n      </section>\n\n      <section class=\"seamsi-notes\">\n        <div class=\"seamsi-prayer-grid\">\n          <div>\n            <p class=\"section-kicker\">วิธีใช้</p>\n            <h2>ใช้ด้วยความเคารพ ไม่ใช่ความร้อนใจ</h2>\n          </div>\n          <p>\n            เซียมซีในหน้านี้เป็นเครื่องมือทบทวนใจและประกอบการตัดสินใจ\n            ไม่ใช่คำสั่งตายตัวหรือการรับรองผลลัพธ์ล่วงหน้า\n          </p>\n        </div>\n        <div class=\"seamsi-note-grid\">\n          <article>\n            <span>01</span>\n            <h3>ถามให้ชัด</h3>\n            <p>ตั้งคำถามหนึ่งเรื่องต่อหนึ่งครั้ง คำถามที่ชัดทำให้คำทำนายอ่านได้ตรงประเด็นมากขึ้น</p>\n          </article>\n          <article>\n            <span>02</span>\n            <h3>เว้นจังหวะ</h3>\n            <p>หากยังลังเลหลังได้คำทำนาย ให้พักใจและกลับมาอ่านใหม่ แทนการขอคำตอบซ้ำทันที</p>\n          </article>\n          <article>\n            <span>03</span>\n            <h3>ใช้ร่วมกับสติ</h3>\n            <p>คำทำนายช่วยชี้มุมมอง แต่การตัดสินใจยังควรอาศัยข้อมูล เหตุผล และความรับผิดชอบ</p>\n          </article>\n        </div>\n      </section>\n    </main>";
const extraScripts = ["/assets/js/seamsi.js"];
---

<BaseLayout
  title="คำเซียมซี | มงคลเวลา"
  description="คำเซียมซีออนไลน์ ตั้งจิต ภาวนา เขย่ากระบอกเซียมซี รับใบคำทำนายพร้อมคำแนะนำ ข้อควรระวัง และมงคลประจำใบ"
  lang="th"
  locale="th"
  page="seamsi"
  bodyClass="seamsi-page"
  extraScripts={extraScripts}
>
  <Fragment set:html={mainContent} />
</BaseLayout>
