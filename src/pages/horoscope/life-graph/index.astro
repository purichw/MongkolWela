---
import ToolsLayout from "../../../layouts/ToolsLayout.astro";
import ToolsHero from "../../../components/ToolsHero.astro";


---

<ToolsLayout
  title="กราฟชีวิต | มงคลเวลา"
  description="ต้นแบบกราฟชีวิต เลข 12 ตัว สำหรับดูจังหวะชีวิตจากวันเกิด เวลาเกิด และวันจร พร้อมกราฟเชิงโต้ตอบ"
  lang="th"
  locale="th"
  page="lifeGraph"
  bodyClass=""
>
  <main class="life-graph-page">
      <ToolsHero title="กราฟชีวิต" kicker="Life Graph" lead="อ่านจังหวะชีวิตจากวันเกิดและวันจร ผ่านกราฟ 12 เรือน พร้อมคำแนะนำสำหรับทบทวนและวางแผนชีวิต" breadcrumbs={[{label:"หน้าแรก",href:"/"},{label:"กราฟชีวิต"}]} />

      <section class="life-graph-tool tools-workspace" aria-label="เครื่องมือกราฟชีวิต">
        <form class="life-graph-form tools-form" data-life-graph-form>
          <div class="form-heading">
            <p class="section-kicker">ข้อมูลตั้งต้น</p>
            <h2>กรอกวันเกิดและวันจร</h2>
          </div>

          <label>
            <span>ชื่อ</span>
            <input name="name" type="text" value="ผู้มาเยือน" maxlength="80">
          </label>

          <label>
            <span>วันเกิด</span>
            <input name="birthDate" type="date" required>
          </label>

          <div class="form-row tools-form-row">
            <label>
              <span>ชั่วโมงเกิด</span>
              <select name="birthHour" required data-hour-options></select>
            </label>
            <label>
              <span>นาทีเกิด</span>
              <select name="birthMinute" required data-minute-options></select>
            </label>
          </div>

          <label>
            <span>วันจร / วันที่ต้องการอ่าน</span>
            <input name="transitDate" type="date" required>
          </label>

          <button class="primary-action" type="submit">คำนวณกราฟชีวิต</button>
          <p class="form-footnote">
            สูตรฐาน 12 ใช้วัน เดือนจันทรคติ และปีนักษัตรเป็นแกนหลัก เวลาเกิดเก็บไว้สำหรับการต่อยอดร่วมกับศาสตร์อื่น
          </p>
        <aside class="life-graph-note">
          <strong>สูตรฐาน 12</strong>
          <p>
            คำนวณจากฐานวัน ฐานเดือนจันทรคติ และฐานปีนักษัตร
            โดยใช้ ThaiCalendarProvider ตรวจข้อมูลปฏิทินไทยก่อนวางกราฟ
          </p>
        </aside></form>

        <div class="life-graph-output tools-panel" data-life-graph-output>
          <div class="output-empty">
            <span>๑๒</span>
            <strong>ตั้งข้อมูลเพื่อเปิดกราฟ</strong>
            <p>กราฟ ตารางเลข และคำอ่านรายเรือนจะแสดงที่นี่หลังคำนวณ</p>
          </div>
        </div>
      </section>

      <section class="life-graph-principles tools-section">
        <div>
          <p class="section-kicker">แนวทางของเรา</p>
          <h2>ทำให้กราฟชีวิตอ่านง่ายขึ้น โดยไม่ตัดความขลังออก</h2>
        </div>
        <div class="principle-grid">
          <article>
            <strong>แยกสูตรออกจากคำทำนาย</strong>
            <p>สูตรฐาน 12 อยู่ใน engine เฉพาะ ส่วนคำอ่านเป็น content layer ที่ปรับผ่านระบบเนื้อหาได้โดยไม่แตะสูตรคำนวณ</p>
          </article>
          <article>
            <strong>กราฟต้องโต้ตอบได้</strong>
            <p>ผู้ใช้ควรคลิกแต่ละเรือนเพื่ออ่านหัวข้อที่สนใจ ไม่ต้องไล่อ่านข้อความยาวทั้งหมด</p>
          </article>
          <article>
            <strong>ไม่ลอกคำทำนายเดิม</strong>
            <p>ทุกข้อความเขียนใหม่ในน้ำเสียงของมงคลเวลา และระบุว่าเป็นแนวทางประกอบการตัดสินใจ</p>
          </article>
        </div>
      </section>
    </main>

  <script>
    import "../../../scripts/life-graph.js";
  </script>
</ToolsLayout>
