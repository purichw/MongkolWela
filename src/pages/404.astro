---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="ไม่พบหน้าที่ต้องการ | มงคลเวลา"
  description="ไม่พบหน้าที่ต้องการในมงคลเวลา กลับหน้าแรกหรือเลือกหมวดหลักของเว็บไซต์"
  lang="th"
  locale="th"
  page="home"
>
  <main class="not-found-page">
    <section class="not-found-panel" aria-labelledby="not-found-title">
      <p class="section-kicker">ไม่พบหน้า</p>
      <h1 id="not-found-title">เส้นทางนี้ไม่มีอยู่ในมงคลเวลาแล้ว</h1>
      <p>
        อาจเป็นลิงก์เก่าหรือหน้าที่ถูกย้ายออกแล้ว เลือกกลับหน้าแรกเพื่อเริ่มใหม่
        หรือไปที่ทะเบียนวัดทั่วประเทศไทยได้ทันที
      </p>
      <div class="not-found-actions">
        <a class="primary-action" href="/">กลับหน้าแรก</a>
        <a class="secondary-action" href="/temples/thailand/">วัดทั่วประเทศไทย</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .not-found-page {
    display: grid;
    min-height: 62vh;
    padding: 72px 20px;
    place-items: center;
  }

  .not-found-panel {
    width: min(820px, 100%);
    padding: clamp(28px, 6vw, 58px);
    background: rgba(255, 251, 242, 0.78);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    text-align: center;
  }

  .not-found-panel h1 {
    margin: 10px 0 18px;
    color: var(--ink);
    font-size: clamp(2.1rem, 6vw, 4.8rem);
    line-height: 1.05;
  }

  .not-found-panel p:not(.section-kicker) {
    max-width: 620px;
    margin: 0 auto;
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.85;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 28px;
  }
</style>
