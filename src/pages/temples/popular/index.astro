---
import TempleCollectionView from "../../../components/TempleCollectionView.astro";
import popularTemples from "../../../data/popular-temples.json";
import { applyTempleImageOverrides } from "../../../data/temple-images.js";
import { getTempleDetailUrl } from "../../../data/temple-slugs.js";
import { createItemListJsonLd } from "../../../lib/seo.js";

type TempleCard = {
  rank: number;
  name: string;
  region: string;
  province: string;
  district?: string;
  imageUrl?: string;
  imageMobileUrl?: string;
  mapImageUrl?: string;
  mapImageMobileUrl?: string;
  imageAlt?: string;
  placeType?: string;
  blessings?: string;
  objectHero?: string;
  latitude?: number;
  longitude?: number;
  travelDetail?: {
    confidence?: string;
  };
};
const rankedTemples = (applyTempleImageOverrides("popular", [...popularTemples]) as TempleCard[]).sort(
  (a: TempleCard, b: TempleCard) => a.rank - b.rank,
);
const regionOrder = [
  "ภาคเหนือ",
  "ภาคกลาง",
  "ภาคตะวันออกเฉียงเหนือ",
  "ภาคตะวันออก",
  "ภาคตะวันตก",
  "ภาคใต้",
];
const popularRegions = Array.from(new Set(rankedTemples.map((temple: TempleCard) => temple.region))).sort(
  (a: string, b: string) => regionOrder.indexOf(a) - regionOrder.indexOf(b),
);
const purposeOrder = [
  "โชคลาภ",
  "การเงิน/ค้าขาย",
  "ความรัก/คู่ครอง",
  "สุขภาพ/อายุยืน",
  "ความสำเร็จ/ก้าวหน้า",
  "การงาน",
  "สิริมงคลทั่วไป",
  "แคล้วคลาด/คุ้มครอง",
  "สงบใจ/ปฏิบัติธรรม",
  "สติปัญญา/การเรียน",
  "ชื่อเสียง/เมตตามหานิยม",
  "ครอบครัว",
  "สะเดาะเคราะห์/แก้ชง",
  "ปีเกิด/พระธาตุประจำปี",
];
const splitTags = (value?: string) =>
  String(value || "")
    .split(";")
    .map((item) => item.trim())
    .filter((item) => item && item !== "0" && item.toLowerCase() !== "nan" && item.toLowerCase() !== "null");
const purposeTags = Array.from(new Set(rankedTemples.flatMap((temple) => splitTags(temple.blessings)))).sort(
  (a, b) => {
    const aIndex = purposeOrder.indexOf(a);
    const bIndex = purposeOrder.indexOf(b);
    if (aIndex !== -1 || bIndex !== -1) return (aIndex === -1 ? 999 : aIndex) - (bIndex === -1 ? 999 : bIndex);
    return a.localeCompare(b, "th");
  },
);
const pageTitle = "วัดดังน่าไป | มงคลเวลา";
const pageDescription = "รวมวัดดังน่าไปทั่วไทยและพิกัดทำบุญ พร้อมตัวกรองภาค จังหวัด วัตถุประสงค์ แผนที่ และรายละเอียดการเดินทาง";
const breadcrumbs = [
  { label: "หน้าแรก", href: "/" },
  { label: "วัดดังเสริมมงคล", href: "/temples/" },
  { label: "วัดดังน่าไป", href: "/temples/popular/" },
];
const collectionMeta = {
  key: "popular",
  label: "วัดดังน่าไป",
  shortLabel: "วัดดังน่าไป",
  kicker: "วัดยอดนิยมทั่วไทย",
  title: "วัดดังน่าไป",
  description: "วัดดังที่คนรู้จัก จัดเรียงตามความนิยม พร้อมจัดเป็นเส้นทางไหว้พระต่อเนื่องได้ในคลิกเดียว",
  intro: "รวมวัดดังทั่วประเทศไทยสำหรับวางแผนเส้นทางไหว้พระ ทำบุญ และเลือกสถานที่เสริมมงคลให้เหมาะกับจังหวะชีวิต",
  accent: "#8e2d24",
  heroBg: "radial-gradient(circle at 18% 0%, #7a2620, #3d130f 70%)",
  mapTitle: "วัดดังน่าไป",
  mapSearchPlaceholder: "ค้นหาวัดในแผนที่",
  searchLabel: "ค้นหาพิกัดวัดยอดนิยม",
  searchPlaceholder: "ค้นหาในวัดดังน่าไป",
  gridLabel: "พิกัดไหว้พระยอดนิยม",
  emptyText: "ไม่พบวัดดังน่าไปที่ตรงกับคำค้นหา",
  imageAlt: "วัดดังน่าไปทั่วไทย",
} as const;
const itemListJsonLd = createItemListJsonLd({
  name: "วัดดังน่าไปทั่วไทย",
  description: pageDescription,
  url: "/temples/popular/",
  items: rankedTemples.slice(0, 8).map((temple) => ({
    name: `${temple.name} ${temple.province}`,
    url: getTempleDetailUrl("popular", temple),
  })),
});
---

<TempleCollectionView
  collection="popular"
  pageKey="templesPopular"
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  canonicalPath="/temples/popular/"
  breadcrumbs={breadcrumbs}
  meta={collectionMeta}
  rankedTemples={rankedTemples}
  regions={popularRegions}
  purposes={purposeTags}
  structuredData={itemListJsonLd}
/>
