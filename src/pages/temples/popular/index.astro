---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const extraScripts = ["/assets/js/temple-directory.js"];
---

<BaseLayout
  title="ไหว้พระ 9 วัด | มงคลเวลา"
  description="รวมเส้นทางไหว้พระ 9 วัดและวัดเด่นทั่วไทย พร้อมทางลัดไปยังทะเบียนวัดทั่วประเทศไทย"
  lang="th"
  locale="th"
  page="templesPopular"
  bodyClass="temples-hub-page"
  extraScripts={extraScripts}
>
  <main class="temples-hub">
    <section class="temples-hub-hero">
      <nav class="temple-breadcrumb" aria-label="breadcrumb">
        <a href="../../">หน้าแรก</a>
        <span>/</span>
        <a href="../">วัดดังเสริมมงคล</a>
        <span>/</span>
        <span>พิกัดยอดนิยม</span>
      </nav>
      <p class="section-kicker">พิกัดยอดนิยม</p>
      <h1>ไหว้พระ 9 วัด</h1>
      <p>
        รวมทางลัดสำหรับค้นหาเส้นทางไหว้พระ วัดเด่น และฐานข้อมูลวัดทั่วประเทศไทย
        เพื่อช่วยวางแผนทำบุญ ไหว้พระ และเลือกสถานที่เสริมมงคลให้เหมาะกับจังหวะชีวิต
      </p>
    </section>

    <section class="temple-search-panel temple-quick-search" aria-label="ค้นหาพิกัดวัดยอดนิยม" data-temple-quick-search>
      <form class="temple-search-form" data-temple-form>
        <label class="temple-field temple-field-wide">
          <span>ชื่อวัด</span>
          <input type="search" name="name" placeholder="ค้นหาจากชื่อวัด" autocomplete="off" data-temple-name />
        </label>

        <label class="temple-field">
          <span>ประเภทวัด</span>
          <select name="type" data-temple-type></select>
        </label>

        <label class="temple-field">
          <span>นิกาย</span>
          <select name="sect" data-temple-sect></select>
        </label>

        <label class="temple-field">
          <span>ภาค</span>
          <select name="region" data-temple-region></select>
        </label>

        <label class="temple-field">
          <span>จังหวัด</span>
          <select name="province" data-temple-province></select>
        </label>

        <label class="temple-field">
          <span>อำเภอ / เขต</span>
          <select name="district" data-temple-district></select>
        </label>

        <label class="temple-field">
          <span>ตำบล / แขวง</span>
          <select name="subdistrict" data-temple-subdistrict></select>
        </label>

        <div class="temple-actions">
          <button class="temple-search-button" type="submit">ค้นหา</button>
          <button class="temple-clear-button" type="button" data-temple-clear>เคลียร์ข้อมูล</button>
        </div>
      </form>
    </section>

    <section class="temples-section">
      <h2>วัดดังทั่วไทย</h2>
      <div class="temples-feature-grid" aria-label="พิกัดไหว้พระยอดนิยม">
        <a class="temples-feature-card is-primary" href="../thailand/">
          <span>ค้นหาข้อมูลวัด</span>
          <strong>วัดทั่วประเทศไทย</strong>
          <p>ค้นหาจากชื่อวัด ประเภท นิกาย ภาค จังหวัด อำเภอ และตำบล</p>
        </a>
        <a class="temples-feature-card" href="../">
          <span>หมวดหลัก</span>
          <strong>วัดดังเสริมมงคล</strong>
          <p>กลับไปดูทางลัดทั้งหมดในหมวดวัดดังเสริมมงคล</p>
        </a>
        <a class="temples-feature-card" href="/">
          <span>มงคลเวลา</span>
          <strong>ดูฤกษ์ก่อนเดินทาง</strong>
          <p>กลับหน้าแรกเพื่อดูจังหวะประจำวัน ปฏิทินไทย และเครื่องมือมงคลอื่น ๆ</p>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
