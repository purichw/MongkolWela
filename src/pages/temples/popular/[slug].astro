---
import TempleDetail from "../../../components/TempleDetail.astro";
import popularTemples from "../../../data/popular-temples.json";
import { applyTempleImageOverrides, templePlaceholderImage } from "../../../data/temple-images.js";
import { createTempleSlug } from "../../../data/temple-slugs.js";

const temples = applyTempleImageOverrides("popular", [...popularTemples]);
type Temple = (typeof temples)[number];

export function getStaticPaths() {
  const staticTemples = applyTempleImageOverrides("popular", [...popularTemples]) as Temple[];
  return staticTemples.map((temple: Temple) => ({
    params: { slug: createTempleSlug(temple) },
    props: { temple },
  }));
}

const { temple } = Astro.props;
---

<TempleDetail
  collectionLabel="สายไหว้พระ 9 วัด"
  collectionHref="/temples/popular/"
  temple={temple}
  placeholderImage={templePlaceholderImage}
/>
