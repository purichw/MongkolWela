---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TempleSearchHero from "../../components/TempleSearchHero.astro";
import templePageBanners from "../../data/temple-page-banners.json";
---

<BaseLayout
  title="วัดดังเสริมมงคล | มงคลเวลา"
  description="รวมทางลัดวัดดังเสริมมงคล พิกัดไหว้พระยอดนิยม และทะเบียนวัดทั่วประเทศไทย"
  lang="th"
  locale="th"
  page="temples"
  bodyClass="temples-hub-page"
>
  <main class="temples-hub">
    <TempleSearchHero
      banner={templePageBanners.hub}
      breadcrumbs={[
        { label: "หน้าแรก", href: "../" },
        { label: "วัดดังเสริมมงคล" },
      ]}
      kicker="วัดดังเสริมมงคล"
      title="วัดดังเสริมมงคล"
      description="รวมทางลัดสำหรับค้นหาเส้นทางไหว้พระ วัดเด่น และฐานข้อมูลวัดทั่วประเทศไทย เพื่อช่วยวางแผนทำบุญ ไหว้พระ และเลือกสถานที่เสริมมงคลให้เหมาะกับจังหวะชีวิต"
    />

    <section class="temples-section">
      <h2>วัดดังทั่วไทย</h2>
      <div class="temples-feature-grid" aria-label="หมวดวัดดังเสริมมงคล">
        <a class="temples-feature-card is-primary" href="./popular/">
          <span>สายไหว้พระ 9 วัด</span>
          <strong>วัดเด่นวัดดัง</strong>
          <p>เตรียมพื้นที่สำหรับเส้นทางไหว้พระยอดนิยม พร้อมต่อยอดข้อมูลวัดเด่นจากแต่ละจังหวัด</p>
        </a>
        <a class="temples-feature-card" href="./mu/">
          <span>พิกัดขอพร</span>
          <strong>สายมู</strong>
          <p>รวมสถานที่ศักดิ์สิทธิ์สำหรับขอพรเรื่องงาน เงิน ความรัก สุขภาพ โชคลาภ และสิริมงคล</p>
        </a>
        <a class="temples-feature-card" href="./thailand/">
          <span>ทะเบียนวัด</span>
          <strong>วัดทั่วประเทศไทย</strong>
          <p>ค้นหาจากชื่อวัด ประเภท นิกาย จังหวัด อำเภอ ตำบล รหัสไปรษณีย์ และสถานะวิสุงคามสีมา</p>
        </a>
        <a class="temples-feature-card" href="/">
          <span>มงคลเวลา</span>
          <strong>ดูฤกษ์ก่อนเดินทาง</strong>
          <p>กลับหน้าแรกเพื่อดูจังหวะประจำวัน ปฏิทินไทย และเครื่องมือมงคลอื่น ๆ</p>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
