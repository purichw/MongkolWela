---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TempleSearchHero from "../../components/TempleSearchHero.astro";
import templePageBanners from "../../data/temple-page-banners.json";
import { templeHubContent } from "../../data/temple-directory-content.js";
---

<BaseLayout
  title={templeHubContent.title}
  description={templeHubContent.description}
  lang="th"
  locale="th"
  page="temples"
  bodyClass="temples-hub-page"
>
  <main class="temples-hub">
    <TempleSearchHero
      banner={templePageBanners.hub}
      breadcrumbs={templeHubContent.breadcrumbs}
      kicker={templeHubContent.kicker}
      title={templeHubContent.heading}
      description={templeHubContent.intro}
    />

    <section class="temples-section">
      <h2>{templeHubContent.sectionTitle}</h2>
      <div class="temples-feature-grid" aria-label={templeHubContent.cardsLabel}>
        {templeHubContent.cards.map((card) => (
          <a class={`temples-feature-card${card.tone === "primary" ? " is-primary" : ""}`} href={card.href}>
            <span>{card.kicker}</span>
            <strong>{card.title}</strong>
            <p>{card.description}</p>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
