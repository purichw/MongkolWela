---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TempleSearchHero from "../../../components/TempleSearchHero.astro";
import templePageBanners from "../../../data/temple-page-banners.json";
import SiteIcon from "../../../components/icons/SiteIcon.astro";
import { iconAttributes } from "../../../lib/ui-markup.js";
const description = "ค้นหาวัดและสถานที่ที่มีพิกัดสำหรับเดินทาง เลือกตามจังหวัดและเปิดเส้นทางบน Google Maps";
---

<BaseLayout title="วัดทั่วประเทศไทย | มงคลเวลา" description={description} lang="th" locale="th" page="templesThailand" bodyClass="temple-directory-page" canonicalPath="/temples/thailand/"
  image={templePageBanners.thailand.imageUrl} imageAlt="วัดทั่วประเทศไทย"
  breadcrumbs={[{ label: "หน้าแรก", href: "/" }, { label: "วัดดังเสริมมงคล", href: "/temples/" }, { label: "วัดทั่วประเทศไทย", href: "/temples/thailand/" }]}>
  <main class="directory-places" data-directory-places data-page-pending="directory">
    <TempleSearchHero banner={templePageBanners.thailand} breadcrumbs={[{ label: "หน้าแรก", href: "/" }, { label: "วัดดังเสริมมงคล", href: "/temples/" }, { label: "วัดทั่วประเทศไทย" }]}
      kicker="ค้นหาพิกัดวัด" title="วัดทั่วประเทศไทย" description={description}>
      <Fragment slot="quote">“ทุกการเดินทาง<br />เริ่มจากความตั้งใจ”</Fragment>
      <form slot="panel" class="directory-search" data-directory-form aria-label="ค้นหาวัดทั่วประเทศไทย">
        <label class="directory-search-name"><span>ชื่อวัดหรือพื้นที่</span><span class="directory-input"><SiteIcon name="search" /><input type="search" name="name" placeholder="ค้นหาชื่อวัด จังหวัด หรืออำเภอ" autocomplete="off" /></span></label>
        <label><span>ภาค</span><select name="region" aria-label="ภาค"><option value="">ทุกภาค</option></select></label>
        <label><span>จังหวัด</span><select name="province" aria-label="จังหวัด"><option value="">ทุกจังหวัด</option></select></label>
        <button type="submit" class="directory-button is-primary"><SiteIcon name="search" />ค้นหา</button>
        <button type="reset" class="directory-button"><span {...iconAttributes("rotate-ccw")}></span>ล้างตัวกรอง</button>
      </form>
    </TempleSearchHero>
    <section class="directory-results" aria-labelledby="directory-title" id="directory-managed">
      <header class="directory-results-heading"><div><h2 id="directory-title">วัดและสถานที่พร้อมพิกัด</h2><p role="status" data-directory-count></p></div><p class="directory-caution">ตรวจสอบทางเข้าและเวลาเปิดกับสถานที่ก่อนเดินทาง</p></header>
      <div class="directory-grid place-card-grid" data-directory-results></div>
      <button type="button" class="directory-button directory-more" data-directory-more hidden>แสดงเพิ่มเติม <SiteIcon name="chevron-down" /></button>
      <p class="directory-attribution">ข้อมูลพิกัดบางส่วน © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap contributors</a> ภายใต้ ODbL (<a href="/assets/data/thailand-mapped-osm.json" download>ดาวน์โหลดข้อมูล</a>) และข้อมูลที่ทีมงานเพิ่ม ไม่ใช่ทะเบียนวัดทั้งหมดหรือการรับรองว่ายังเปิดให้เข้าชม</p>
    </section>
  </main>
  <script>import "../../../scripts/directory-places.js";</script>
</BaseLayout>
