---
import TempleCollectionView from "../../../components/TempleCollectionView.astro";
import muTemples from "../../../data/mu-temples.json";
import { applyTempleImageOverrides } from "../../../data/temple-images.js";
import { getTempleDetailUrl } from "../../../data/temple-slugs.js";
import { createItemListJsonLd } from "../../../lib/seo.js";

type TempleCard = {
  rank: number;
  name: string;
  region: string;
  province: string;
  district?: string;
  imageUrl?: string;
  imageMobileUrl?: string;
  mapImageUrl?: string;
  mapImageMobileUrl?: string;
  imageAlt?: string;
  placeType?: string;
  blessings?: string;
  objectHero?: string;
  latitude?: number;
  longitude?: number;
  travelDetail?: {
    confidence?: string;
  };
};
const rankedTemples = (applyTempleImageOverrides("mu", [...muTemples]) as TempleCard[]).sort(
  (a: TempleCard, b: TempleCard) => a.rank - b.rank,
);
const regionOrder = [
  "ภาคเหนือ",
  "ภาคกลาง",
  "ภาคตะวันออกเฉียงเหนือ",
  "ภาคตะวันออก",
  "ภาคตะวันตก",
  "ภาคใต้",
];
const popularRegions = Array.from(new Set(rankedTemples.map((temple: TempleCard) => temple.region))).sort(
  (a: string, b: string) => regionOrder.indexOf(a) - regionOrder.indexOf(b),
);
const purposeOrder = [
  "โชคลาภ",
  "การเงิน/ค้าขาย",
  "ความรัก/คู่ครอง",
  "สุขภาพ/อายุยืน",
  "ความสำเร็จ/ก้าวหน้า",
  "การงาน",
  "สิริมงคลทั่วไป",
  "แคล้วคลาด/คุ้มครอง",
  "สงบใจ/ปฏิบัติธรรม",
  "สติปัญญา/การเรียน",
  "ชื่อเสียง/เมตตามหานิยม",
  "ครอบครัว",
  "สะเดาะเคราะห์/แก้ชง",
  "ปีเกิด/พระธาตุประจำปี",
];
const splitTags = (value?: string) =>
  String(value || "")
    .split(";")
    .map((item) => item.trim())
    .filter((item) => item && item !== "0" && item.toLowerCase() !== "nan" && item.toLowerCase() !== "null");
const purposeTags = Array.from(new Set(rankedTemples.flatMap((temple) => splitTags(temple.blessings)))).sort(
  (a, b) => {
    const aIndex = purposeOrder.indexOf(a);
    const bIndex = purposeOrder.indexOf(b);
    if (aIndex !== -1 || bIndex !== -1) return (aIndex === -1 ? 999 : aIndex) - (bIndex === -1 ? 999 : bIndex);
    return a.localeCompare(b, "th");
  },
);
const pageTitle = "พิกัดสายมู | มงคลเวลา";
const pageDescription = "รวมพิกัดสายมูและสถานที่ศักดิ์สิทธิ์ทั่วไทยสำหรับสักการะเรื่องงาน เงิน ความรัก สุขภาพ โชคลาภ พร้อมแผนที่และตัวกรองวัตถุประสงค์";
const breadcrumbs = [
  { label: "หน้าแรก", href: "/" },
  { label: "วัดดังเสริมมงคล", href: "/temples/" },
  { label: "พิกัดสายมู", href: "/temples/mu/" },
];
const collectionMeta = {
  key: "mu",
  label: "พิกัดสายมู",
  shortLabel: "พิกัดสายมู",
  kicker: "มงคล · ศรัทธา",
  title: "พิกัดสายมู",
  description: "รวมสถานที่สำหรับสักการะ เสริมสิริมงคล แก้ชง และตั้งจิตอธิษฐาน โดยนำเสนออย่างพอดีและเคารพสถานที่",
  intro: "รวมสถานที่ศักดิ์สิทธิ์สำหรับเรื่องการงาน การเงิน ความรัก สุขภาพ โชคลาภ และการเสริมสิริมงคล พร้อมค้นหาและกรองตามพื้นที่ได้ทันที",
  accent: "#b0691c",
  heroBg: "radial-gradient(circle at 18% 0%, #8a4c16, #3d1c0d 70%)",
  mapTitle: "พิกัดสายมู",
  mapSearchPlaceholder: "ค้นหาสถานที่ในแผนที่",
  searchLabel: "ค้นหาพิกัดสายมู",
  searchPlaceholder: "ค้นหาพิกัดสายมู",
  gridLabel: "พิกัดสายมูยอดนิยม",
  emptyText: "ไม่พบพิกัดสายมูที่ตรงกับคำค้นหา",
  imageAlt: "พิกัดสายมูและสถานที่ศักดิ์สิทธิ์ทั่วไทย",
} as const;
const itemListJsonLd = createItemListJsonLd({
  name: "พิกัดสายมูยอดนิยมทั่วไทย",
  description: pageDescription,
  url: "/temples/mu/",
  items: rankedTemples.slice(0, 8).map((temple) => ({
    name: `${temple.name} ${temple.province}`,
    url: getTempleDetailUrl("mu", temple),
  })),
});
---

<TempleCollectionView
  collection="mu"
  pageKey="templesMu"
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  canonicalPath="/temples/mu/"
  breadcrumbs={breadcrumbs}
  meta={collectionMeta}
  rankedTemples={rankedTemples}
  regions={popularRegions}
  purposes={purposeTags}
  structuredData={itemListJsonLd}
/>
