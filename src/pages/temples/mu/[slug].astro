---
import TempleDetail from "../../../components/TempleDetail.astro";
import { templePlaceholderImage } from "../../../data/temple-images.js";
import { loadTemplePage } from "../../../server/temple-page.js";

export const prerender = false;
const page = await loadTemplePage("mu", Astro.params.slug, Astro.url);
if (page.response) return page.response;
Astro.response.headers.set("Cache-Control", "no-store");
---

<TempleDetail
  collection="mu"
  collectionLabel="พิกัดสายมู"
  collectionHref="/temples/mu/"
  temple={page.temple}
  content={page.content}
  placeholderImage={templePlaceholderImage}
  relatedTemples={page.relatedTemples}
/>
