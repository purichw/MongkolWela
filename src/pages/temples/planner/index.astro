---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TempleSearchHero from "../../../components/TempleSearchHero.astro";

const plannerDataSrc = "/assets/data/temple-planner.json";
const extraStyles = ["/assets/css/temple-planner.css?feature=20260830-01"];
const extraScripts = ["/assets/js/temple-planner.js?feature=20260729-02"];
const pageTitle = "วางแผนไหว้พระ | มงคลเวลา";
const pageDescription =
  "บอกโจทย์จำนวนวัด พื้นที่ เวลา และสิ่งที่อยากเสริม แล้วให้มงคลเวลาช่วยจัดลำดับเส้นทางไหว้พระที่ต่อเนื่องและใช้เวลาน้อยที่สุด";
const plannerBanner = {
  adminKey: "temples.planner.banner",
  imageUrl: "/assets/images/hero-temple-red.jpg",
  imageAlt: "จิตรกรรมไทยบนผนังวัดสำหรับหน้าวางแผนไหว้พระ",
  focalPoint: "center 42%",
};
const plannerAreas = [
  { label: "กรุงเทพมหานคร", value: "province:กรุงเทพมหานคร", hint: "เลือกจังหวัดหรือย่านที่จะเดินทาง" },
  { label: "นนทบุรี · ปทุมธานี", value: "provinces:นนทบุรี|ปทุมธานี", hint: "โซนใกล้กรุงเทพฯ ฝั่งเหนือ" },
  { label: "พระนครศรีอยุธยา", value: "province:พระนครศรีอยุธยา", hint: "เหมาะกับทริปวัดเก่าและริมแม่น้ำ" },
  { label: "เชียงใหม่", value: "province:เชียงใหม่", hint: "เส้นทางวัดสำคัญในภาคเหนือ" },
  { label: "นครปฐม", value: "province:นครปฐม", hint: "เส้นทางใกล้กรุงเทพฯ ฝั่งตะวันตก" },
  { label: "ทุกพื้นที่", value: "", hint: "ให้ระบบเลือกจากทุกจังหวัดในฐานข้อมูล" },
];
const plannerPurposes = [
  { label: "โชคลาภ เงินทอง", value: "โชคลาภ" },
  { label: "การงาน ก้าวหน้า", value: "การงาน", active: true },
  { label: "ความรัก เนื้อคู่", value: "ความรัก/คู่ครอง" },
  { label: "สุขภาพ ครอบครัว", value: "สุขภาพ/อายุยืน" },
  { label: "แก้ชง สะเดาะเคราะห์", value: "สะเดาะเคราะห์/แก้ชง" },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  lang="th"
  locale="th"
  page="templesPlanner"
  bodyClass="temple-planner-page"
  extraStyles={extraStyles}
  extraScripts={extraScripts}
  canonicalPath="/temples/planner/"
  image={plannerBanner.imageUrl}
  imageAlt={plannerBanner.imageAlt}
  breadcrumbs={[
    { label: "หน้าแรก", href: "/" },
    { label: "วัด", href: "/temples/" },
    { label: "วางแผนไหว้พระ", href: "/temples/planner/" },
  ]}
>
  <main
    class="temple-planner"
    data-temple-planner
    data-planner-data-src={plannerDataSrc}
    data-planner-default-purpose="การงาน"
  >
    <TempleSearchHero
      banner={plannerBanner}
      breadcrumbs={[
        { label: "หน้าแรก", href: "../../../" },
        { label: "วัด", href: "../../" },
        { label: "วางแผนไหว้พระ" },
      ]}
      kicker="✦ ตัวช่วยหลักของมงคลเวลา"
      title="วางแผนไหว้พระ"
      description="บอกโจทย์ของคุณ — จำนวนวัด พื้นที่ เวลา และสิ่งที่อยากเสริม แล้วให้ระบบจัดลำดับเส้นทางที่เดินทางต่อเนื่องและใช้เวลาน้อยที่สุด"
    >
      <section slot="panel" class="planner-setup" aria-labelledby="planner-setup-title">
        <div class="planner-setup__heading">
          <div>
            <p class="section-kicker"><span aria-hidden="true">๐๑</span> ตั้งโจทย์ทริป</p>
            <h2 id="planner-setup-title">อยากไปกี่วัด แบบไหน</h2>
          </div>
        </div>

        <div class="planner-setup__grid">
          <div class="planner-hidden-controls" hidden>
            <label>
              <span>เวลาที่มี</span>
              <select data-planner-budget>
                <option value="300" selected>ครึ่งวัน · ประมาณ 5 ชั่วโมง</option>
                <option value="600">เต็มวัน · ประมาณ 10 ชั่วโมง</option>
                <option value="720">เต็มวันแบบสบาย · ประมาณ 12 ชั่วโมง</option>
              </select>
            </label>
            <input type="date" data-planner-start-date />
            <select data-planner-radius>
              <option value="">ไม่จำกัดรัศมี</option>
              <option value="50">ภายใน 50 กม.</option>
              <option value="100" selected>ภายใน 100 กม.</option>
              <option value="200">ภายใน 200 กม.</option>
              <option value="500">ภายใน 500 กม.</option>
            </select>
            <input type="hidden" data-planner-start />
            <input type="search" data-planner-search />
          </div>

          <fieldset class="planner-field planner-field--count">
            <legend>จำนวนสถานที่</legend>
            <div class="planner-segmented" data-planner-count>
              {[
                { count: 3, label: "๓ วัด" },
                { count: 5, label: "๕ วัด" },
                { count: 9, label: "๙ วัด" },
              ].map(({ count, label }) => (
                <label>
                  <input type="radio" name="planner-count" value={count} checked={count === 3} />
                  <span>{label}</span>
                </label>
              ))}
            </div>
            <small>เส้นทางยอดนิยมคือไหว้พระ ๙ วัดในวันเดียว</small>
          </fieldset>

          <label class="planner-field planner-field--area">
            <span>พื้นที่</span>
            <select data-planner-area data-planner-area-default="province:กรุงเทพมหานคร">
              {plannerAreas.map((area) => <option value={area.value} data-planner-area-hint={area.hint}>{area.label}</option>)}
            </select>
            <small data-planner-area-hint-display>{plannerAreas[0].hint}</small>
          </label>

          <label class="planner-field planner-field--time">
            <span>เริ่มทริปเวลา</span>
            <input type="time" value="09:00" data-planner-start-time />
            <small>ไล่ตามเวลาเปิดของวัด</small>
          </label>

          <div class="planner-field planner-field--purpose">
            <span>อยากเสริมเรื่องอะไร</span>
            <div class="planner-wish-chips" aria-label="เลือกเรื่องที่อยากเสริม">
              {plannerPurposes.map((purpose) => (
                <button
                  type="button"
                  class={purpose.active ? "is-active" : undefined}
                  data-planner-purpose-tag
                  value={purpose.value}
                  aria-pressed={purpose.active ? "true" : "false"}
                >{purpose.label}</button>
              ))}
            </div>
          </div>

          <label class="planner-field planner-field--origin">
            <span>เริ่มทริปจาก (จุดเริ่มต้น)</span>
            <input
              type="text"
              list="planner-start-suggestions"
              placeholder="เช่น สถานีรถไฟฟ้า BTS สนามกีฬาแห่งชาติ หรือที่พักของคุณ"
              autocomplete="off"
              data-planner-origin-text
            />
            <datalist id="planner-start-suggestions"></datalist>
          </label>

          <div class="planner-search-actions" aria-label="เลือกวิธีค้นหาและจัดแผน">
            <div class="planner-search-actions__group">
              <span>เลือกสถานที่เอง</span>
              <button class="planner-secondary-button planner-filter-button" type="button" data-planner-filter-search>
                เปิดรายการวัดแล้วเลือกเอง
              </button>
            </div>

            <div class="planner-search-actions__or" aria-hidden="true">หรือ</div>

            <div class="planner-search-actions__group planner-search-actions__group--auto">
              <span class="planner-action-label-with-help">ให้ระบบจัดทริปให้</span>
              <p>จากโจทย์ด้านบน ระบบจะเรียงลำดับให้เดินทางสั้นและต่อเนื่องที่สุด</p>
              <button class="planner-primary-button" type="button" data-planner-auto>
                ✦ ให้ระบบจัดทริป
              </button>
            </div>
          </div>

          <button class="planner-location-button" type="button" data-planner-location>
            ค้นหาใกล้ฉัน
          </button>

          <button class="planner-secondary-button planner-reset-button" type="button" data-planner-reset-filters>
            รีเซ็ตโจทย์
          </button>

        </div>

        <div class="planner-criteria-notice" data-planner-criteria-notice hidden>
          <p>
            <strong>เงื่อนไขด้านบนเปลี่ยนแล้ว</strong>
            <span>ทริปที่แสดงอยู่ยังใช้โจทย์เดิม กดจัดทริปใหม่ถ้าต้องการใช้เงื่อนไขล่าสุด</span>
          </p>
          <div class="planner-criteria-notice__actions">
            <button class="planner-primary-button" type="button" data-planner-criteria-rebuild>จัดทริปใหม่</button>
            <button class="planner-secondary-button" type="button" data-planner-criteria-restore>คืนค่าโจทย์เดิม</button>
          </div>
        </div>

        <p class="planner-location-status" role="status" aria-live="polite" data-planner-location-status></p>
      </section>
    </TempleSearchHero>

    <section class="planner-pick" id="planner-pick" aria-labelledby="planner-pick-title" hidden>
      <div class="planner-section-head">
        <div>
          <p class="section-kicker">เลือกสถานที่เอง</p>
          <h2 id="planner-pick-title">เลือกเองจากรายการหรือแผนที่</h2>
        </div>
        <div class="planner-selection-count" aria-live="polite">
          เลือกแล้ว <strong data-planner-selected-count>0</strong>/<span data-planner-target-count>9</span>
        </div>
      </div>

      <div class="planner-picker-context" data-planner-picker-context>
        <div>
          <p class="section-kicker" data-planner-picker-kicker>รายการสำหรับเลือกเอง</p>
          <h3 data-planner-picker-title>เลือกสถานที่เข้าทริป</h3>
          <p data-planner-picker-description>
            รายการนี้แยกจากโจทย์ด้านบน ใช้ค้นหาและปรับสถานที่ในทริปที่กำลังแก้
          </p>
          <div class="planner-picker-chips" data-planner-picker-chips></div>
        </div>
        <div class="planner-picker-context__controls">
          <div class="planner-picker-mode" aria-label="โหมดรายการสถานที่">
            <button type="button" class="is-active" data-planner-picker-mode="recommended">แนะนำก่อน</button>
            <button type="button" data-planner-picker-mode="browse">ค้นเอง</button>
          </div>
          <label class="planner-search planner-search--picker">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m16 16 4 4"></path>
            </svg>
            <input
              type="search"
              placeholder="ค้นหาในรายการนี้"
              autocomplete="off"
              data-planner-picker-search
            />
          </label>
          <button class="planner-secondary-button planner-picker-scope-button" type="button" data-planner-picker-toggle-scope>
            ดูทั้งหมด
          </button>
        </div>
      </div>
      <p class="planner-picker-note" data-planner-picker-note></p>

      <div class="planner-selected-tray" data-planner-selected-tray>
        <p>ยังไม่ได้เลือกสถานที่ ระบบสามารถแนะนำให้ครบตามจำนวนได้</p>
      </div>

      <div class="planner-pick__toolbar">
        <div class="planner-tabs" role="tablist" aria-label="วิธีเลือกสถานที่">
          <button type="button" role="tab" aria-selected="true" data-planner-picker-tab="list">รายการ</button>
          <button type="button" role="tab" aria-selected="false" data-planner-picker-tab="map">แผนที่</button>
        </div>
      </div>

      <div class="planner-picker-panel" role="tabpanel" data-planner-picker-panel="list">
        <div class="planner-place-grid" data-planner-place-grid></div>
        <button class="planner-more-button" type="button" data-planner-more hidden>ดูสถานที่เพิ่ม</button>
        <p class="planner-empty" data-planner-empty hidden>ไม่พบสถานที่ที่ตรงกับตัวกรอง</p>
      </div>

      <div class="planner-picker-panel" role="tabpanel" data-planner-picker-panel="map" hidden>
        <div class="planner-map-shell">
          <div class="planner-map" data-planner-selection-map aria-label="แผนที่เลือกวัดและสถานที่ศักดิ์สิทธิ์"></div>
          <div class="planner-map-note">
            แตะหมุดเพื่อดูข้อมูลและเพิ่มในทริป หมุดสีแดงคือสถานที่ที่เลือกแล้ว
          </div>
        </div>
      </div>

      <div class="planner-pick__actions">
        <button class="planner-primary-button" type="button" data-planner-build>
          จัดลำดับสถานที่ที่เลือก
        </button>
        <button class="planner-secondary-button" type="button" data-planner-clear-selection>
          ล้างที่เลือก
        </button>
      </div>
    </section>

    <section class="planner-result" aria-labelledby="planner-result-title" data-planner-result hidden>
      <div class="planner-section-head">
        <div>
          <p class="section-kicker">แผนการเดินทาง</p>
          <h2 id="planner-result-title">ทริปที่จัดให้</h2>
        </div>
        <div class="planner-result__head-actions">
          <button class="planner-secondary-button" type="button" data-planner-edit>ปรับสถานที่เอง</button>
          <button class="planner-secondary-button planner-clear-trip-button" type="button" data-planner-clear-trip>ล้างทริปนี้</button>
        </div>
      </div>

      <div class="planner-trip-source" data-planner-trip-source hidden></div>
      <div class="planner-summary" data-planner-summary></div>
      <div class="planner-warnings" data-planner-warnings hidden></div>

      <div class="planner-result__toolbar">
        <div class="planner-tabs" role="tablist" aria-label="มุมมองแผนการเดินทาง">
          <button type="button" role="tab" aria-selected="true" data-planner-result-tab="timeline">แผนตามเวลา</button>
          <button type="button" role="tab" aria-selected="false" data-planner-result-tab="map">ดูบนแผนที่</button>
        </div>
        <div class="planner-result__actions">
          <button class="planner-secondary-button" type="button" data-planner-save>บันทึกแผน</button>
          <a class="planner-primary-button" href="#" target="_blank" rel="noopener" data-planner-google>
            เปิดเส้นทางใน Google Maps
          </a>
        </div>
      </div>

      <div role="tabpanel" data-planner-result-panel="timeline">
        <ol class="planner-timeline" data-planner-timeline></ol>
      </div>
      <div role="tabpanel" data-planner-result-panel="map" hidden>
        <div class="planner-map-shell">
          <div class="planner-map planner-map--route" data-planner-route-map aria-label="แผนที่ลำดับการเดินทาง"></div>
          <div class="planner-map-note">เส้นเชื่อมใช้เพื่อแสดงลำดับโดยประมาณ ไม่ใช่แนวถนนจริง</div>
        </div>
      </div>

      <p class="planner-disclaimer">
        ระยะทางและเวลาเป็นค่าประมาณสำหรับวางแผนจากพิกัด ไม่รวมสภาพจราจร เหตุปิดถนน เวลาเปิด–ปิด หรือเวลารอจริง
        ควรตรวจเส้นทางอีกครั้งก่อนออกเดินทาง
      </p>
    </section>

    <section class="planner-guides" id="guides" aria-label="หลักการจัดทริป">
      <article>
        <span>๐๑ / เกณฑ์</span>
        <h2>จัดจากอะไร</h2>
        <p>ระยะเดินทาง เวลาเปิดของวัด และพรที่คุณตั้งใจ — ไม่ใช่แค่ความดัง</p>
      </article>
      <article>
        <span>๐๒ / ความมั่นใจ</span>
        <h2>บอกตรงเมื่อควรเช็ก</h2>
        <p>จุดสีเขียว-ทอง-เทา บอกระดับความมั่นใจของข้อมูลแต่ละแห่ง</p>
      </article>
      <article>
        <span>๐๓ / ปรับได้</span>
        <h2>แก้ลำดับเองได้</h2>
        <p>สลับ เพิ่ม หรือเอาสถานที่ออก แล้วเปิดเส้นทางต่อใน Google Maps</p>
      </article>
    </section>

    <section class="planner-supporting-tools" id="supporting-tools" aria-label="เครื่องมือเสริม">
      <p>เครื่องมือเสริม</p>
      <a href="/calendar/">วันพระและปฏิทินไทย</a>
      <a href="/horoscope/seamsi/">เซียมซี</a>
      <a href="/tarot/daily/">ไพ่ประจำวัน</a>
    </section>

    <div class="planner-dialog" data-planner-dialog aria-hidden="true" hidden>
      <button class="planner-dialog__overlay" type="button" data-planner-dialog-close aria-label="ปิดข้อความ"></button>
      <section class="planner-dialog__panel" role="dialog" aria-modal="true" aria-labelledby="planner-dialog-title" aria-describedby="planner-dialog-message">
        <p class="section-kicker" data-planner-dialog-kicker>ตรวจสอบก่อนจัดแผน</p>
        <h2 id="planner-dialog-title" data-planner-dialog-title></h2>
        <p id="planner-dialog-message" data-planner-dialog-message></p>
        <div class="planner-dialog__actions">
          <button class="planner-secondary-button" type="button" data-planner-dialog-cancel>ยกเลิก</button>
          <button class="planner-primary-button" type="button" data-planner-dialog-confirm></button>
        </div>
      </section>
    </div>

  </main>
</BaseLayout>
