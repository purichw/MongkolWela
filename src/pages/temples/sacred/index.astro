---
import TempleCollectionView from "../../../components/TempleCollectionView.astro";
import sacredTemples from "../../../data/sacred-temples.json";
import { applyTempleImageOverrides } from "../../../data/temple-images.js";
import { getTempleDetailUrl } from "../../../data/temple-slugs.js";
import { templeDirectoryCommon, templeDirectoryPages } from "../../../data/temple-directory-content.js";
import { createItemListJsonLd } from "../../../lib/seo.js";

const pageContent = templeDirectoryPages.sacred;
const regionOrder = templeDirectoryCommon.regionOrder;
const purposeOrder = templeDirectoryCommon.purposeOrder;
type TempleCard = {
  rank: number;
  name: string;
  region: string;
  province: string;
  district?: string;
  imageUrl?: string;
  imageMobileUrl?: string;
  mapImageUrl?: string;
  mapImageMobileUrl?: string;
  imageAlt?: string;
  placeType?: string;
  blessings?: string;
  objectHero?: string;
  latitude?: number;
  longitude?: number;
  travelDetail?: {
    confidence?: string;
  };
};
const rankedTemples = (applyTempleImageOverrides("sacred", [...sacredTemples]) as TempleCard[]).sort(
  (a: TempleCard, b: TempleCard) => a.rank - b.rank,
);
const popularRegions = Array.from(new Set(rankedTemples.map((temple: TempleCard) => temple.region))).sort(
  (a: string, b: string) => regionOrder.indexOf(a) - regionOrder.indexOf(b),
);
const splitTags = (value?: string) =>
  String(value || "")
    .split(";")
    .map((item) => item.trim())
    .filter((item) => item && item !== "0" && item.toLowerCase() !== "nan" && item.toLowerCase() !== "null");
const purposeTags = Array.from(new Set(rankedTemples.flatMap((temple) => splitTags(temple.blessings)))).sort(
  (a, b) => {
    const aIndex = purposeOrder.indexOf(a);
    const bIndex = purposeOrder.indexOf(b);
    if (aIndex !== -1 || bIndex !== -1) return (aIndex === -1 ? 999 : aIndex) - (bIndex === -1 ? 999 : bIndex);
    return a.localeCompare(b, "th");
  },
);
const breadcrumbs = [
  { label: "หน้าแรก", href: "/" },
  { label: "วัดดังเสริมมงคล", href: "/temples/" },
  { label: pageContent.heading, href: pageContent.collectionHref },
];
const collectionMeta = {
  key: "sacred",
  label: pageContent.heading,
  shortLabel: "วัดเด่นขอพร",
  kicker: "ศรัทธา · ขอพรเสริมมงคล",
  title: pageContent.heading,
  description: "สถานที่ศักดิ์สิทธิ์ เลือกจากจังหวัด ภูมิภาค และเรื่องที่ตั้งใจขอพร พร้อมพิกัดและข้อมูลประกอบ",
  intro: pageContent.intro,
  accent: "#1c6a4f",
  heroBg: "radial-gradient(circle at 18% 0%, #1c6a4f, #123d34 70%)",
  mapTitle: pageContent.mapTitle,
  mapSearchPlaceholder: pageContent.mapSearchPlaceholder,
  searchLabel: pageContent.filterLabel,
  searchPlaceholder: pageContent.searchPlaceholder,
  gridLabel: pageContent.gridLabel,
  emptyText: pageContent.emptyText,
  imageAlt: "วัดเด่นขอพรและสถานที่สำคัญทั่วไทย",
} as const;
const itemListJsonLd = createItemListJsonLd({
  name: pageContent.heading,
  description: pageContent.description,
  url: pageContent.collectionHref,
  items: rankedTemples.slice(0, 8).map((temple) => ({
    name: `${temple.name} ${temple.province}`,
    url: getTempleDetailUrl("sacred", temple),
  })),
});
---

<TempleCollectionView
  collection="sacred"
  pageKey={pageContent.pageKey}
  pageTitle={pageContent.title}
  pageDescription={pageContent.description}
  canonicalPath={pageContent.collectionHref}
  breadcrumbs={breadcrumbs}
  meta={collectionMeta}
  rankedTemples={rankedTemples}
  regions={popularRegions}
  purposes={purposeTags}
  structuredData={itemListJsonLd}
/>
