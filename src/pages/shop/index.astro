---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CommerceNav from "../../components/CommerceNav.astro";
import SiteIcon from "../../components/icons/SiteIcon.astro";
import LinkArrow from "../../components/LinkArrow.astro";
import "../../styles/commerce.css";
import "../../styles/shop.css";

const destinations = [
  { href: "/temples/planner/", icon: "map" as const, kind: "planner", title: "วางแผนไหว้พระ", description: ["ค้นหาวัด จัดเส้นทาง", "และวางแผนการเดินทาง"] },
  { href: "/calendar/", icon: "calendar-days" as const, kind: "calendar", title: "วันพระและปฏิทิน", description: ["ดูวันพระ วันสำคัญ", "และฤกษ์มงคล"] },
  { href: "/temples/", icon: "altar" as const, kind: "temples", title: "วัดดังเสริมมงคล", description: ["รวมวัดและสถานที่ศักดิ์สิทธิ์", "ยอดนิยมทั่วไทย"] },
];
const questions = [
  { title: "ร้านค้าจะเริ่มเปิดเมื่อไร?", answer: "ขณะนี้ยังไม่มีกำหนดเปิดบริการที่ยืนยันแล้ว เมื่อพร้อมให้บริการ เราจะแจ้งรายละเอียดผ่านหน้านี้" },
  { title: "มีสินค้าอะไรบ้าง?", answer: "เรากำลังเตรียมวัตถุมงคลและเครื่องรางที่คัดสรรอย่างตั้งใจ โดยจะแสดงรายการสินค้า แหล่งที่มา และข้อมูลผู้จำหน่ายเมื่อเปิดบริการ" },
  { title: "สามารถร่วมบุญกับวัดได้อย่างไร?", answer: "ขณะนี้ยังไม่เปิดรับรายการร่วมบุญผ่านเว็บไซต์ ระหว่างนี้โปรดตรวจสอบประกาศและช่องทางอย่างเป็นทางการของวัดที่คุณต้องการร่วมบุญโดยตรง" },
];
---
<BaseLayout title="วัตถุมงคลและเครื่องราง | มงคลเวลา" description="วัตถุมงคลจากวัดและผู้จำหน่าย พร้อมแหล่งที่มาและข้อมูลผู้ขาย" page="shop" robots="noindex,follow" analytics={false}>
  <main class="commerce-page shop-page" data-commerce-public="shop" data-commerce-state="loading">
    <section class="shop-intro" aria-labelledby="shop-title">
      <div class="shop-frame">
        <nav class="shop-breadcrumb" aria-label="เส้นทางนำทาง"><a data-cms-field="3746c99e-1" href="/">หน้าแรก</a><span aria-hidden="true">/</span><span data-cms-field="3746c99e-2" aria-current="page">ร้านค้าและร่วมบุญ</span></nav>
        <header class="commerce-heading shop-heading">
          <p data-cms-field="3746c99e-3" class="section-kicker">ร้านค้ามงคลเวลา</p>
          <h1 data-cms-field="3746c99e-4" id="shop-title">วัตถุมงคลและเครื่องราง</h1>
          <p data-cms-field="3746c99e-5" class="shop-lead">วัตถุมงคลที่คัดสรรอย่างตั้งใจ เพื่อเสริมสิริมงคลในทุกการเดินทางของคุณ</p>
        </header>
        <div data-commerce-operational hidden><CommerceNav active="shop" /></div>
        <div class="commerce-message" role="status" aria-live="polite" data-commerce-message></div>
        <div data-commerce-content aria-busy="true"><p data-cms-field="3746c99e-6">กำลังตรวจสอบสถานะร้านค้า</p></div>
        <section class="shop-closed" aria-labelledby="shop-closed-title" data-shop-unavailable hidden>
          <img data-cms-field="3746c99e-7" class="shop-closed-art" src="/assets/images/shop-closed-kiosk.webp" alt="ร้านไม้เล็ก ๆ แขวนป้ายปิดให้บริการในขณะนี้" width="1000" height="604" fetchpriority="high" />
          <div class="shop-closed-copy">
            <h2 id="shop-closed-title"><span data-cms-field="3746c99e-8">ระบบร้านค้าและร่วมบุญ</span><span data-cms-field="3746c99e-9">ยังไม่เปิดบริการ</span></h2>
            <p data-cms-field="3746c99e-10">เรากำลังเตรียมวัตถุมงคลและสินค้าที่คัดสรรอย่างดี<br class="shop-desktop-break" /> รวมถึงช่องทางร่วมบุญกับวัดและสถานที่ศักดิ์สิทธิ์ต่าง ๆ<br class="shop-desktop-break" /> เพื่อให้คุณได้ทำบุญและเสริมสิริมงคลได้อย่างสะดวกและมั่นใจ</p>
            <p data-cms-field="3746c99e-11" class="shop-coming-soon">โปรดติดตามเร็ว ๆ นี้</p>
            <div class="shop-lotus-rule" aria-hidden="true"><SiteIcon name="lotus" /></div>
          </div>
        </section>
        <p data-cms-field="3746c99e-12" class="shop-quote" data-shop-unavailable hidden>“บุญที่ตั้งใจ ย่อมเดินทางมาถึง”</p>
        <noscript><p data-cms-field="3746c99e-13" class="shop-no-script">เปิด JavaScript เพื่อตรวจสอบสถานะร้านค้า หรือสำรวจ <a data-cms-field="3746c99e-14" href="/temples/">วัดดังเสริมมงคล</a> และ <a data-cms-field="3746c99e-15" href="/calendar/">ปฏิทินไทย</a></p></noscript>
      </div>
    </section>
    <section class="shop-explore" aria-labelledby="shop-explore-title" data-shop-unavailable hidden>
      <div class="shop-frame">
        <header class="shop-explore-heading">
          <h2 data-cms-field="3746c99e-16" id="shop-explore-title">ระหว่างนี้ คุณอาจสนใจ</h2>
          <p data-cms-field="3746c99e-17">สำรวจเนื้อหาอื่น ๆ ที่ช่วยเสริมสิริมงคลให้กับการเดินทางของคุณ</p>
        </header>
        <div class="shop-destinations">
          {destinations.map(item => <a class="shop-destination" href={item.href}>
            <span data-cms-field="3746c99e-18" class:list={["shop-destination-art", `shop-destination-art--${item.kind}`]}>
              <SiteIcon name={item.icon} />
              {item.kind === "planner" && <SiteIcon name="map-pin" class="shop-map-pin" />}
            </span>
            <span class="shop-destination-copy"><strong data-cms-field="3746c99e-19">{item.title}</strong><span data-cms-field="3746c99e-20">{item.description.map(line => <span data-cms-field="3746c99e-21">{line}</span>)}</span></span>
            <LinkArrow />
          </a>)}
        </div>
        <section class="shop-faq" aria-labelledby="shop-faq-title">
          <h2 data-cms-field="3746c99e-22" id="shop-faq-title"><span class="shop-question-mark" aria-hidden="true">?</span>คำถามที่พบบ่อย</h2>
          {questions.map(question => <details>
            <summary data-cms-field="3746c99e-23">{question.title}<SiteIcon name="chevron-down" /></summary>
            <p data-cms-field="3746c99e-24">{question.answer}</p>
          </details>)}
        </section>
      </div>
    </section>
  </main>
  <script>import "../../scripts/commerce-public.js";</script>
</BaseLayout>
