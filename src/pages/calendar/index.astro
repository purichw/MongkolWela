---
import BaseLayout from "../../layouts/BaseLayout.astro";
import cmsSeed from "../../../public/admin/content/live.json";
import CmsImage from "../../components/CmsImage.astro";
import SiteIcon from "../../components/icons/SiteIcon.astro";
import PageBanner from "../../components/PageBanner.astro";
import { createYearOptions, thaiMonthNames } from "../../scripts/thai-calendar-core.js";
import { monthShortNames } from "../../scripts/calendar-view-model.js";

const patches = cmsSeed.pages.find(page => page.id === "calendar")?.patches || [];
const media = (id: string) => patches.find(patch => patch.id === id && patch.enabled !== false);
---

<BaseLayout
  title="ปฏิทินไทย | มงคลเวลา"
  description="เช็กวันพระ วันสำคัญ และรายละเอียดรายวัน เลือกดูปฏิทินไทยรายเดือนและทั้งปี พร้อมข้อมูลจันทรคติประกอบการวางแผน"
  lang="th"
  locale="th"
  page="calendar"
  bodyClass="thai-calendar-page"
>
  <main id="calendar-top" class="calendar-app" data-page-pending="calendar" data-calendar-app data-state="loading">
    {(["lotus", "stupa", "calendar-days", "chevron-left", "chevron-right", "arrow-right"] as const).map(name => (
      <template data-calendar-symbol={name}><SiteIcon name={name} /></template>
    ))}
    <PageBanner titleId="calendar-title" class="cal-hero thai-calendar-hero">
      <CmsImage slot="media" mediaId="calendar-hero-image" image={media("calendar-hero-image")} width={1920} height={1080} loading="eager" fetchpriority="high" class="cal-hero-image" />
      <div class="page-banner__copy">
        <nav class="page-banner__breadcrumb" aria-label="เส้นทางนำทาง">
          <a data-cms-field="6211ed68-1" href="/">หน้าแรก</a><span aria-hidden="true">/</span><span data-cms-field="6211ed68-2" aria-current="page">ปฏิทินไทย</span>
        </nav>
        <h1 id="calendar-title"><span data-cms-field="6211ed68-3">ปฏิทินไทย</span><span data-calendar-title></span></h1>
        <p data-cms-field="6211ed68-4" class="page-banner__subtitle">เช็กวันพระ วันสำคัญ และรายละเอียดรายวัน</p>
        <p data-cms-field="6211ed68-5" class="page-banner__description">วางแผนชีวิต เดินทางไหว้พระ ทำบุญ และกิจกรรมมงคลตลอดทั้งปี</p>
      </div>
      <Fragment slot="quote">“เวลา... ก็เป็นมงคลได้<br />หากเราเลือกใช้ด้วยใจที่ดี”</Fragment>
    </PageBanner>

    <div class="cal-toolbar-wrap" data-calendar-toolbar>
      <div class="cal-toolbar cal-container">
        <div class="cal-year-control">
          <label data-cms-field="6211ed68-6" for="calendar-year">เลือกปี</label>
          <select id="calendar-year" name="year" data-calendar-year>
            {createYearOptions().map(year => <option data-cms-field="6211ed68-7" value={year}>{year} / {year - 543}</option>)}
          </select>
        </div>
        <nav class="cal-month-nav" data-calendar-months aria-label="เลือกเดือน">
          {thaiMonthNames.map((month, i) => (
            <button data-cms-field="6211ed68-8" type="button" data-month={i + 1} aria-label={month} aria-pressed="false" title={month}>{monthShortNames[i]}</button>
          ))}
        </nav>
        <div class="cal-view-switch" role="group" aria-label="มุมมองปฏิทิน">
          <button data-cms-field="6211ed68-9" type="button" data-view="overview" aria-pressed="true"><SiteIcon name="calendar-days" />ภาพรวม</button>
          <button data-cms-field="6211ed68-10" type="button" data-view="month" aria-pressed="false"><SiteIcon name="calendar-days" />รายเดือน</button>
          <button data-cms-field="6211ed68-11" type="button" data-view="events" aria-pressed="false"><SiteIcon name="calendar-days" />วันสำคัญ</button>
        </div>
        <select class="cal-mobile-view" data-calendar-view aria-label="มุมมองปฏิทิน">
          <option data-cms-field="6211ed68-12" value="overview">ภาพรวม</option><option data-cms-field="6211ed68-13" value="month">รายเดือน</option><option data-cms-field="6211ed68-14" value="events">วันสำคัญ</option>
        </select>
        <a class="cal-today cal-button" data-calendar-today href="/calendar/day/" aria-label="รายละเอียดวันนี้" title="รายละเอียดวันนี้">
          <SiteIcon name="calendar-days" /><span data-cms-field="6211ed68-15">วันนี้</span>
        </a>
      </div>
    </div>

    <div class="cal-container cal-content">
      <p class="sr-only" role="status" data-calendar-status></p>
      <section class="cal-summaries" data-calendar-summary aria-label="สรุปปฏิทิน" aria-busy="true">
        {Array.from({ length: 4 }, () => <div class="cal-summary-skeleton" aria-hidden="true"><span></span><span></span></div>)}
      </section>
      <section class="cal-workspace" id="calendar-workspace" data-calendar-workspace tabindex="-1" aria-label="ปฏิทินเดือนที่เลือก" aria-busy="true">
        <div class="cal-grid-skeleton" aria-hidden="true">
          {Array.from({ length: 35 }, () => <span></span>)}
        </div>
        <p data-cms-field="6211ed68-16" class="sr-only">กำลังเตรียมข้อมูลปฏิทิน</p>
      </section>
      <section class="cal-year-overview" data-calendar-overview aria-labelledby="calendar-year-title"></section>
      <section class="cal-guide" data-calendar-guide hidden aria-labelledby="cal-guide-title">
        <h2 data-cms-field="6211ed68-17" id="cal-guide-title">เกร็ดความรู้</h2>
        <a href="/calendar/day/">
          <CmsImage mediaId="calendar-guide-image" image={media("calendar-guide-image")} width={240} height={180} />
          <span><strong data-cms-field="6211ed68-18">อ่านวันพระและจันทรคติ</strong><small data-cms-field="6211ed68-19">ดูข้างขึ้น ข้างแรม และข้อมูลประกอบของแต่ละวัน</small></span>
          <SiteIcon name="arrow-right" />
        </a>
      </section>
      <noscript>
        <p data-cms-field="6211ed68-20" class="cal-data-note">โปรดเปิด JavaScript เพื่อเลือกปี เดือน และอ่านรายละเอียดปฏิทิน</p>
      </noscript>
    </div>
  </main>
  <script>
    import "../../scripts/thai-calendar-year.js";
  </script>
</BaseLayout>
