---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TempleSearchForm from "../../components/TempleSearchForm.astro";
import SiteIcon from "../../components/icons/SiteIcon.astro";
import { iconAttributes } from "../../lib/ui-markup.js";
---
<BaseLayout title="ค้นหาวัดและสถานที่ | มงคลเวลา" description="ค้นหาวัดดังน่าไป วัดเด่นขอพร และพิกัดสายมู ตามจังหวัดและความตั้งใจ" page="templeSearch" canonicalPath="/search/" robots="noindex, follow">
  <main class="temple-search-page" data-search-page data-cms-preserve-section-order>
    <nav class="temple-search-page__breadcrumb" aria-label="เส้นทางนำทาง"><a data-cms-field="1e6d4bcc-1" href="/">หน้าแรก</a><span>/</span><span data-cms-field="1e6d4bcc-2">ค้นหาวัดและสถานที่</span></nav>
    <h1 data-cms-field="1e6d4bcc-3">ค้นหาวัดและสถานที่</h1>
    <TempleSearchForm id="results-temple-search" variant="results" />
    <div class="temple-search-page__filters" data-search-filters>
      <label data-cms-field="1e6d4bcc-4">หมวดสถานที่<select name="collection" data-search-filter><option data-cms-field="1e6d4bcc-5" value="">ทุกหมวด</option></select></label>
      <label data-cms-field="1e6d4bcc-6">จังหวัด<select name="province" data-search-filter><option data-cms-field="1e6d4bcc-7" value="">ทุกจังหวัด</option></select></label>
      <label data-cms-field="1e6d4bcc-8">เรื่องที่ขอพร<select name="purpose" data-search-filter><option data-cms-field="1e6d4bcc-9" value="">ทุกเรื่อง</option></select></label>
      <button data-cms-field="1e6d4bcc-10" type="button" data-search-reset><SiteIcon name="x" />ล้างตัวกรอง</button>
    </div>
    <p class="temple-search-page__count" data-search-count role="status" aria-live="polite"></p>
    <div class="temple-search-page__state" data-search-page-state><span {...iconAttributes("search")} /><h2 data-cms-field="1e6d4bcc-11" data-cms-runtime data-search-state-title>กำลังค้นหาสถานที่</h2><p data-cms-field="1e6d4bcc-12" data-cms-runtime data-search-state-copy>รอสักครู่</p><button data-cms-field="1e6d4bcc-13" type="button" data-search-page-retry hidden>ลองอีกครั้ง</button></div>
    <div class="temple-search-page__results" data-search-results></div>
    <nav class="temple-search-page__pagination" aria-label="หน้าผลค้นหา" data-search-pagination hidden>
      <button type="button" data-search-prev aria-label="ผลค้นหาหน้าก่อนหน้า"><SiteIcon name="chevron-left" /></button>
      <span data-search-page-number></span>
      <button type="button" data-search-next aria-label="ผลค้นหาหน้าถัดไป"><SiteIcon name="chevron-right" /></button>
    </nav>
    <noscript><p data-cms-field="1e6d4bcc-14">เปิด JavaScript เพื่อค้นหาสถานที่ หรือเลือกดูตามหมวด</p><a data-cms-field="1e6d4bcc-15" href="/temples/popular/">วัดดังน่าไป</a> · <a data-cms-field="1e6d4bcc-16" href="/temples/sacred/">วัดเด่นขอพร</a> · <a data-cms-field="1e6d4bcc-17" href="/temples/mu/">พิกัดสายมู</a><style>.temple-search-page__state,.temple-search-page__filters{display:none}</style></noscript>
  </main>
</BaseLayout>
