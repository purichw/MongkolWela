---
import BaseLayout from "../layouts/BaseLayout.astro";

const heroSlides = [
  { src: "/assets/images/hero-temple-red.jpg", alt: "จิตรกรรมฝาผนังวัดไทยในโทนแดงทอง" },
  { src: "/assets/images/hero-jtha-98.jpg", alt: "บรรยากาศสถานที่ศักดิ์สิทธิ์สำหรับไหว้พระ" },
  { src: "/assets/images/hero-jtha-83.jpg", alt: "วัดและศาลเจ้าสำหรับประกอบพิธีมงคล" },
  { src: "/assets/images/hero-jtha-80.jpg", alt: "พระพุทธรูปและพื้นที่สักการะในวัด" },
  { src: "/assets/images/chinese-incense-card.jpg", alt: "ธูปวงแขวนในศาลเจ้าจีน" },
];

const intentLinks = [
  {
    no: "๐๑",
    kicker: "โชคลาภ",
    label: "เสริมโชคลาภ เงินทอง",
    description: "วัดและสถานที่ศักดิ์สิทธิ์ที่ผู้ศรัทธานิยมไปสักการะเรื่องการเงิน การค้า และโชคลาภ",
    href: "/temples/sacred/?q=โชคลาภ",
  },
  {
    no: "๐๒",
    kicker: "การงาน",
    label: "การงาน ความก้าวหน้า",
    description: "สถานที่สำหรับสักการะเพื่อเสริมกำลังใจด้านหน้าที่การงาน ตำแหน่ง และการสอบหรือสัมภาษณ์สำคัญ",
    href: "/temples/sacred/?q=การงาน",
  },
  {
    no: "๐๓",
    kicker: "ความรัก",
    label: "ความรัก เนื้อคู่",
    description: "สถานที่ที่นิยมสักการะเรื่องความรัก คู่ครอง และความสัมพันธ์ที่มั่นคง",
    href: "/temples/sacred/?q=ความรัก",
  },
  {
    no: "๐๔",
    kicker: "ครอบครัว",
    label: "สุขภาพ และครอบครัว",
    description: "สถานที่สำหรับตั้งจิตอธิษฐานเรื่องสุขภาพ ความคุ้มครอง และความสงบสุขของครอบครัว",
    href: "/temples/sacred/?q=สุขภาพ",
  },
  {
    no: "๐๕",
    kicker: "เริ่มใหม่",
    label: "เริ่มต้นชีวิตใหม่",
    description: "เหมาะกับช่วงเปลี่ยนงาน ย้ายบ้าน หรือช่วงเวลาที่ต้องการตั้งต้นอย่างมีสติ",
    href: "/temples/popular/?q=เริ่มต้น",
  },
  {
    no: "๐๖",
    kicker: "แก้ชง",
    label: "แก้ชง สะเดาะเคราะห์",
    description: "สำหรับปีชงหรือช่วงที่ต้องการทำบุญ สะเดาะเคราะห์ และเสริมกำลังใจอย่างเหมาะสม",
    href: "/temples/mu/?q=แก้ชง",
  },
];

const tickerItems = [
  "๙ เส้นทางไหว้พระยอดนิยม",
  "๔๔,๗๐๔ วัดทั่วไทยพร้อมค้นหา",
  "พิกัดสำหรับตรวจสอบเส้นทาง",
  "วางแผน ๓ / ๕ / ๙ แห่ง",
];

const planStops = [
  {
    time: "09:00",
    title: "วัดพระเชตุพนฯ (วัดโพธิ์)",
    detail: "พระนคร · สุขภาพและความสงบ",
    image: "/assets/images/hero-jtha-80.jpg",
  },
  {
    time: "10:15",
    title: "วัดอรุณราชวราราม",
    detail: "บางกอกใหญ่ · การงานและความก้าวหน้า",
    image: "/assets/images/hero-jtha-98.jpg",
  },
  {
    time: "11:20",
    title: "วัดกัลยาณมิตรฯ",
    detail: "ธนบุรี · การเดินทางปลอดภัย",
    image: "/assets/images/temple-placeholder-auspicious.png",
  },
];

const collectionCards = [
  {
    variant: "popular",
    kicker: "เส้นทาง · ยอดนิยม",
    title: "สายไหว้พระ ๙ วัด",
    description: "วัดยอดนิยมที่จัดเป็นเส้นทางต่อเนื่อง เหมาะสำหรับวางแผนเดินทางภายในวันเดียว",
    href: "/temples/popular/",
    linkLabel: "จัดเป็นเส้นทาง",
  },
  {
    variant: "sacred",
    kicker: "ศรัทธา · ข้อมูลประกอบ",
    title: "วัดศักดิ์สิทธิ์",
    description: "สถานที่สำคัญที่เลือกได้ตามจังหวัด ภูมิภาค และวัตถุประสงค์ด้านมงคล พร้อมพิกัดและข้อมูลประกอบ",
    href: "/temples/sacred/",
    linkLabel: "ค้นหาตามความตั้งใจ",
  },
  {
    variant: "mu",
    kicker: "มงคล · กำลังใจ",
    title: "สถานที่มงคล",
    description: "รวมสถานที่สำหรับสักการะ เสริมสิริมงคล แก้ชง และตั้งจิตอธิษฐาน โดยนำเสนออย่างพอดีและเคารพสถานที่",
    href: "/temples/mu/",
    linkLabel: "ดูสถานที่เด่น",
  },
];

const supportingLinks = [
  { label: "วันพระและปฏิทินไทย", href: "/calendar/" },
  { label: "คำเซียมซี", href: "/horoscope/seamsi/" },
  { label: "ไพ่ยิปซีรายวัน", href: "/tarot/daily/" },
  { label: "อ่านลายมือ", href: "/horoscope/palmistry/" },
];

---

<BaseLayout
  title="มงคลเวลา | วางแผนไหว้พระ วัดศักดิ์สิทธิ์ และข้อมูลมงคล"
  description="มงคลเวลาเป็นคู่มือค้นหาวัด สถานที่ศักดิ์สิทธิ์ เส้นทางไหว้พระ 9 วัด วัดทั่วไทย และเครื่องมือวางแผนเดินทางมงคลสำหรับผู้ใช้ไทย"
  lang="th"
  locale="th"
  page="home"
  bodyClass="home-v2-page"
  canonicalPath="/"
  image="/assets/images/hero-temple-red.jpg"
  imageAlt="มงคลเวลา วัด สถานที่ศักดิ์สิทธิ์ และเส้นทางไหว้พระ"
  breadcrumbs={[{ label: "หน้าแรก", href: "/" }]}
>
  <script is:inline>
    document.documentElement.classList.add("home-text-motion-pending");
  </script>
  <main data-cms-preserve-section-order>
    <section class="hero home-aura-hero" aria-labelledby="hero-title">
      <div class="hero-carousel" data-carousel>
        {heroSlides.map((slide, index) => (
          <div class={`hero-slide${index === 0 ? " is-active" : ""}`}>
            <img src={slide.src} alt={slide.alt} />
          </div>
        ))}
      </div>
      <div class="hero-shade"></div>
      <div class="home-hero-motion" aria-hidden="true">
        <span class="home-orbit home-orbit-one"></span>
        <span class="home-orbit home-orbit-two"></span>
        <span class="home-ritual-line home-ritual-line-one"></span>
        <span class="home-ritual-line home-ritual-line-two"></span>
      </div>

      <div class="hero-content home-hero-shell">
        <div class="home-hero-copy">
          <p class="eyebrow">วัด · สถานที่ศักดิ์สิทธิ์ · เส้นทางมงคล</p>
          <h1 id="hero-title"><span>วางแผน<span class="hero-title-keep">ไหว้พระ</span></span><mark>อย่างรอบคอบ</mark></h1>
          <p class="hero-copy">
            กำหนดจังหวัด วัตถุประสงค์ และเวลาที่เดินทางได้ เพื่อค้นหาสถานที่จริง
            จัดลำดับเส้นทาง และแสดงข้อมูลสำหรับตรวจสอบก่อนเดินทาง
          </p>

          <form class="hero-search home-temple-search" action="/temples/sacred/" role="search">
            <label class="sr-only" for="site-search">ค้นหาวัดหรือสถานที่ศักดิ์สิทธิ์</label>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m21 21-4.3-4.3m2.3-5.2a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z"></path>
            </svg>
            <input
              id="site-search"
              name="q"
              type="search"
              placeholder="ค้นหาวัด จังหวัด หรือวัตถุประสงค์"
            />
            <button type="submit">ค้นหา</button>
          </form>

          <div class="hero-links" aria-label="ทางลัดหน้าแรก">
            <a class="is-primary" href="/temples/planner/">วางแผนไหว้พระ</a>
            <a href="/temples/popular/">เส้นทาง ๙ วัด</a>
            <a href="/temples/thailand/">วัดทั่วประเทศไทย</a>
          </div>
        </div>

        <aside class="home-today-card" id="today" aria-label="ฤกษ์วันนี้">
          <p>ข้อมูลประจำวัน</p>
          <strong data-topbar-realtime="solarToday">วันอาทิตย์ที่ 19 กรกฎาคม 2569</strong>
          <span>
            ใช้ประกอบการวางแผน<strong>ทำบุญและเริ่มสิ่งใหม่</strong>
            พร้อมตรวจสอบวันพระและรายละเอียดประจำวัน
          </span>
          <a href="/calendar/">เปิดปฏิทินไทย</a>
        </aside>
      </div>

      <div class="hero-controls" aria-label="ภาพประกอบหน้าแรก">
        <button class="hero-arrow" type="button" data-carousel-prev aria-label="ภาพก่อนหน้า">
          <span aria-hidden="true">‹</span>
        </button>
        <div class="hero-dots" aria-label="เลือกภาพประกอบ">
          {heroSlides.map((_, index) => (
            <button
              class={index === 0 ? "is-active" : ""}
              type="button"
              data-carousel-dot
              aria-label={`ภาพที่ ${index + 1}`}
              aria-pressed={index === 0 ? "true" : "false"}
            ></button>
          ))}
        </div>
        <button class="hero-arrow" type="button" data-carousel-next aria-label="ภาพถัดไป">
          <span aria-hidden="true">›</span>
        </button>
      </div>
    </section>

    <section class="home-stat-ticker" aria-label="ภาพรวมวัดและเส้นทางมงคล">
      <div>
        {tickerItems.map((item) => (
          <span>{item}</span>
        ))}
      </div>
    </section>

    <section class="home-section home-intent-section" id="intent" aria-labelledby="intent-title">
      <div class="home-section-heading home-intent-heading">
        <p><span>๐๑</span> วัตถุประสงค์ด้านมงคล</p>
        <h2 id="intent-title">เลือกเรื่องที่ต้องการวางแผน</h2>
      </div>

      <div class="home-intent-grid">
        {intentLinks.map((item) => (
          <a class="home-intent-card" href={item.href}>
            <span>{item.no} / {item.kicker}</span>
            <strong>{item.label}</strong>
            <p>{item.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="home-planner-spotlight" id="temple-routes" aria-labelledby="planner-title">
      <div class="home-planner-inner">
        <div class="home-planner-copy">
          <p><span>๐๒</span> เครื่องมือวางแผน</p>
          <h2 id="planner-title">กำหนดเงื่อนไข แล้วจัดลำดับเส้นทาง</h2>
          <p>
            เลือกจำนวนสถานที่ พื้นที่ เวลา และวัตถุประสงค์ด้านมงคล ระบบจะเรียงลำดับให้เดินทางต่อเนื่อง
            โดยใช้พิกัดจริงและข้อมูลประกอบที่ควรตรวจสอบก่อนออกเดินทาง
          </p>
          <div class="home-planner-tags" aria-label="ตัวเลือกหลักในการวางแผน">
            <span>จำนวน ๓/๕/๙</span>
            <span>พื้นที่ · จังหวัด</span>
            <span>วัตถุประสงค์มงคล</span>
          </div>
          <a class="primary-action" href="/temples/planner/">เริ่มวางแผนไหว้พระ</a>
        </div>

        <article class="home-sample-plan" aria-label="ตัวอย่างแผนไหว้พระ">
          <header>
            <p>ตัวอย่างแผนเดินทาง</p>
            <strong>ไหว้พระริมน้ำ ๓ วัด · กรุงเทพฯ</strong>
            <span>รวม ๑๑ กม.</span>
          </header>
          <ol>
            {planStops.map((stop) => (
              <li>
                <time>{stop.time}</time>
                <img src={stop.image} alt="" loading="lazy" />
                <div>
                  <strong>{stop.title}</strong>
                  <p>{stop.detail}</p>
                  <span>ข้อมูลพิกัดพร้อมตรวจสอบ</span>
                </div>
              </li>
            ))}
          </ol>
          <p class="home-plan-note">
            เกณฑ์การจัดลำดับ: เริ่มจากจุดศูนย์กลางเมือง แล้วพิจารณาเวลาเปิดและระยะเดินทางโดยประมาณ
          </p>
        </article>
      </div>
    </section>

    <section class="home-section home-collections-section" id="collections" aria-labelledby="collections-title">
      <div class="home-section-heading home-collection-heading">
        <p><span>๐๓</span> หมวดการค้นหา</p>
        <div>
          <h2 id="collections-title">เลือกจากหมวดหลัก</h2>
          <a class="section-link" href="/temples/">ดูทุกหมวด</a>
        </div>
      </div>

      <div class="home-collection-grid">
        {collectionCards.map((card) => (
          <a class={`home-collection-card is-${card.variant}`} href={card.href}>
            <span>{card.kicker}</span>
            <strong>{card.title}</strong>
            <p>{card.description}</p>
            <em>{card.linkLabel}</em>
          </a>
        ))}
      </div>

      <aside class="home-database-panel" aria-label="ฐานข้อมูลวัดทั่วประเทศไทย">
        <div>
          <p>ฐานข้อมูลวัดทั่วประเทศไทย</p>
          <strong>๔๔,๗๐๕ วัด พร้อมค้นหา</strong>
          <div aria-label="ตัวกรองฐานข้อมูลวัด">
            <span>ภาค</span>
            <span>จังหวัด</span>
            <span>อำเภอ / ตำบล</span>
            <span>นิกาย</span>
            <span>รหัสไปรษณีย์</span>
          </div>
        </div>
        <a href="/temples/thailand/">เปิดฐานข้อมูล</a>
      </aside>
    </section>

    <section class="learn-strip" id="supporting-tools" aria-label="เครื่องมือเสริม">
      <p>เครื่องมือเสริม</p>
      {supportingLinks.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </section>
  </main>

  <script>
    import "../scripts/home-motion.js";
  </script>
</BaseLayout>
