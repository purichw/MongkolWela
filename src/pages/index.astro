---
import BaseLayout from "../layouts/BaseLayout.astro";

const heroSlides = [
  { src: "/assets/images/hero-temple-red.jpg", alt: "พระอุโบสถและบรรยากาศวัดไทยในแสงอบอุ่น" },
  { src: "/assets/images/hero-jtha-98.jpg", alt: "บรรยากาศสถานที่ศักดิ์สิทธิ์สำหรับไหว้พระ" },
  { src: "/assets/images/hero-jtha-83.jpg", alt: "วัดและศาลเจ้าสำหรับขอพรเสริมมงคล" },
  { src: "/assets/images/hero-jtha-80.jpg", alt: "พระพุทธรูปและพื้นที่สักการะในวัด" },
  { src: "/assets/images/chinese-incense-card.jpg", alt: "ธูปวงแขวนในศาลเจ้าจีน" },
];

const intentLinks = [
  { kicker: "โชคลาภ", label: "เสริมโชคลาภ", href: "/temples/sacred/" },
  { kicker: "การงาน", label: "การงานราบรื่น", href: "/temples/sacred/" },
  { kicker: "ความรัก", label: "ความรักและคู่ครอง", href: "/temples/sacred/" },
  { kicker: "ครอบครัว", label: "สุขภาพและครอบครัว", href: "/temples/sacred/" },
  { kicker: "เริ่มใหม่", label: "เริ่มต้นชีวิตใหม่", href: "/temples/popular/" },
  { kicker: "แก้ชง", label: "แก้ชงและสะเดาะเคราะห์", href: "/temples/mu/" },
];

const routeCards = [
  {
    kicker: "จัดทริป",
    title: "วางแผนไหว้พระ",
    description: "เลือก 3, 5 หรือ 9 แห่ง แล้วให้ระบบช่วยเรียงลำดับเส้นทางจากสถานที่ที่มีข้อมูลพิกัด",
    href: "/temples/planner/",
  },
  {
    kicker: "วัดดัง",
    title: "สายไหว้พระ 9 วัด",
    description: "รวมวัดและสถานที่ยอดนิยมสำหรับทำบุญ ไหว้พระ และเดินทางเป็นเส้นทางมงคล",
    href: "/temples/popular/",
  },
  {
    kicker: "ขอพร",
    title: "วัดศักดิ์สิทธิ์",
    description: "ค้นหาสถานที่สำคัญตามจังหวัด ภูมิภาค และสิ่งที่อยากตั้งใจขอพร",
    href: "/temples/sacred/",
  },
  {
    kicker: "สายมู",
    title: "สถานที่สายมู",
    description: "เลือกดูสถานที่เด่นสำหรับเสริมดวง เสริมกำลังใจ และวางแผนไปไหว้แบบพอดี",
    href: "/temples/mu/",
  },
];

const directoryCards = [
  { label: "วัดทั่วไทย", value: "ค้นหาตามจังหวัด อำเภอ ตำบล", href: "/temples/thailand/" },
  { label: "แผนที่พิกัด", value: "ดูตำแหน่งวัดจากหน้ารายการ", href: "/temples/popular/" },
  { label: "วันพระ", value: "เช็กวันสำคัญก่อนออกเดินทาง", href: "/calendar/" },
];

const guideLinks = [
  { label: "เตรียมตัวก่อนไหว้พระ", href: "/temples/" },
  { label: "เลือกเส้นทางให้เหมาะกับเวลา", href: "/temples/planner/" },
  { label: "ค้นหาวัดจากพื้นที่", href: "/temples/thailand/" },
  { label: "ดูสถานที่สำหรับขอพร", href: "/temples/sacred/" },
];

const extraScripts = ["/assets/js/home-motion.js"];
---

<BaseLayout
  title="มงคลเวลา | วัดดัง สถานที่ศักดิ์สิทธิ์ และเส้นทางไหว้พระเสริมมงคล"
  description="มงคลเวลา ช่วยค้นหาวัดดัง สถานที่ศักดิ์สิทธิ์ เส้นทางไหว้พระ 9 วัด สถานที่สายมู วัดทั่วไทย และตัวช่วยวางแผนไหว้พระเพื่อเสริมมงคลชีวิต"
  lang="th"
  locale="th"
  page="home"
  bodyClass=""
  extraScripts={extraScripts}
  canonicalPath="/"
  image="/assets/images/hero-temple-red.jpg"
  imageAlt="มงคลเวลา วัดดัง สถานที่ศักดิ์สิทธิ์ และเส้นทางไหว้พระเสริมมงคล"
  breadcrumbs={[{ label: "หน้าแรก", href: "/" }]}
>
  <script is:inline>
    document.documentElement.classList.add("home-text-motion-pending");
  </script>
  <main>
    <section class="hero home-aura-hero" aria-labelledby="hero-title">
      <div class="hero-carousel" data-carousel>
        {heroSlides.map((slide, index) => (
          <div class={`hero-slide${index === 0 ? " is-active" : ""}`}>
            <img src={slide.src} alt={slide.alt} />
          </div>
        ))}
      </div>
      <div class="hero-shade"></div>
      <div class="home-hero-motion" aria-hidden="true">
        <span class="home-orbit home-orbit-one"></span>
        <span class="home-orbit home-orbit-two"></span>
        <span class="home-ritual-line home-ritual-line-one"></span>
        <span class="home-ritual-line home-ritual-line-two"></span>
      </div>
      <div class="hero-content">
        <p class="eyebrow">วัดดัง • สถานที่ศักดิ์สิทธิ์ • เส้นทางเสริมมงคล</p>
        <h1 id="hero-title">มงคลเวลา</h1>
        <p class="hero-copy">
          ค้นหาวัดและสถานที่ศักดิ์สิทธิ์สำหรับไหว้พระ ขอพร ทำบุญ และวางแผนเส้นทางมงคล
          ให้เหมาะกับสิ่งที่อยากเสริมในชีวิต
        </p>

        <form class="hero-search home-temple-search" action="/temples/sacred/" role="search">
          <label class="sr-only" for="site-search">ค้นหาวัดหรือสถานที่ศักดิ์สิทธิ์</label>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m21 21-4.3-4.3m2.3-5.2a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z"></path>
          </svg>
          <input
            id="site-search"
            name="q"
            type="search"
            placeholder="ค้นหาวัด จังหวัด หรือพรที่อยากขอ เช่น โชคลาภ การงาน ความรัก"
          />
          <button type="submit">ค้นหา</button>
        </form>

        <div class="hero-links" aria-label="ทางลัดหน้าแรก">
          <a href="/temples/planner/">วางแผนไหว้พระ</a>
          <a href="/temples/popular/">ไหว้พระ 9 วัด</a>
          <a href="/temples/sacred/">วัดศักดิ์สิทธิ์</a>
          <a href="/temples/thailand/">วัดทั่วไทย</a>
        </div>
      </div>
      <div class="hero-controls" aria-label="ภาพประกอบหน้าแรก">
        <button class="hero-arrow" type="button" data-carousel-prev aria-label="ภาพก่อนหน้า">
          <span aria-hidden="true">‹</span>
        </button>
        <div class="hero-dots" aria-label="เลือกภาพประกอบ">
          {heroSlides.map((_, index) => (
            <button
              class={index === 0 ? "is-active" : ""}
              type="button"
              data-carousel-dot
              aria-label={`ภาพที่ ${index + 1}`}
              aria-pressed={index === 0 ? "true" : "false"}
            ></button>
          ))}
        </div>
        <button class="hero-arrow" type="button" data-carousel-next aria-label="ภาพถัดไป">
          <span aria-hidden="true">›</span>
        </button>
      </div>
    </section>

    <section class="today-panel home-intent-panel" id="today" aria-labelledby="intent-title">
      <div>
        <p class="section-kicker">เริ่มจากความตั้งใจ</p>
        <h2 id="intent-title">อยากเสริมเรื่องไหน</h2>
      </div>
      <div class="today-grid home-intent-grid">
        {intentLinks.map((item) => (
          <a href={item.href}>
            <span>{item.kicker}</span>
            <strong>{item.label}</strong>
            <p>เลือกสถานที่และเส้นทางที่เกี่ยวข้อง</p>
          </a>
        ))}
      </div>
    </section>

    <section class="section-shell" id="temple-routes">
      <div class="section-heading">
        <div>
          <p class="section-kicker">เส้นทางหลัก</p>
          <h2>เลือกวิธีออกเดินทาง</h2>
        </div>
        <a class="section-link" href="/temples/">ดูทั้งหมด</a>
      </div>

      <div class="category-grid home-route-grid">
        {routeCards.map((card) => (
          <a class="category-card home-route-card" href={card.href}>
            <span class="category-symbol">{card.kicker}</span>
            <strong>{card.title}</strong>
            <p>{card.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="feature-band home-map-band" id="map" aria-labelledby="map-title">
      <div class="feature-copy">
        <p class="section-kicker">พิกัดและแผนที่</p>
        <h2 id="map-title">หาเส้นทางไหว้พระจากพื้นที่จริง</h2>
        <p>
          เปิดดูรายการวัดพร้อมพิกัด ค้นหาจากจังหวัดหรือความตั้งใจ แล้วใช้ตัวช่วยวางแผนทริป
          เพื่อจัดลำดับสถานที่ให้เดินทางต่อกันได้ง่ายขึ้น
        </p>
        <div class="feature-actions">
          <a class="primary-action" href="/temples/planner/">เริ่มวางแผนทริป</a>
          <a class="secondary-action" href="/temples/sacred/">ดูวัดศักดิ์สิทธิ์</a>
        </div>
      </div>
      <div class="home-map-preview" aria-label="ตัวอย่างการค้นหาสถานที่มงคล">
        <div class="home-map-glow" aria-hidden="true"></div>
        <div class="home-map-card is-main">
          <span>จุดหมาย</span>
          <strong>เลือกวัดตามจังหวัดหรือพรที่ตั้งใจ</strong>
          <p>ค้นหา แล้วเปิดรายละเอียดพร้อมพิกัดและข้อมูลเดินทาง</p>
        </div>
        <div class="home-map-card">
          <span>ลำดับทริป</span>
          <strong>3 • 5 • 9 แห่ง</strong>
        </div>
        <div class="home-map-card">
          <span>แผนที่</span>
          <strong>ดูพิกัดก่อนออกเดินทาง</strong>
        </div>
      </div>
    </section>

    <section class="section-shell" id="directory">
      <div class="section-heading">
        <div>
          <p class="section-kicker">ค้นหาเร็ว</p>
          <h2>พื้นที่สำหรับคนจะไปไหว้จริง</h2>
        </div>
      </div>

      <div class="tool-grid home-directory-grid">
        {directoryCards.map((card) => (
          <article class="tool-card">
            <span>{card.label}</span>
            <h3>{card.value}</h3>
            <a href={card.href}>เปิดดู</a>
          </article>
        ))}
      </div>
    </section>

    <section class="tradition-section home-guide-section" id="guides" aria-labelledby="guides-title">
      <img src="/assets/images/chinese-incense-card.jpg" alt="ธูปวงแขวนในศาลเจ้าจีน" />
      <div>
        <p class="section-kicker">คู่มือก่อนเดินทาง</p>
        <h2 id="guides-title">ไหว้พระแบบตั้งใจ สุภาพ และไม่เร่งร้อน</h2>
        <p>
          มงคลเวลาวางบทบาทเป็นผู้ช่วยค้นหาสถานที่และจัดเส้นทางก่อนออกเดินทาง
          พร้อมคงข้อมูลให้กระชับ เคารพสถานที่ และตรวจสอบได้จากข้อมูลที่มีอยู่จริง
        </p>
        <div class="ritual-list">
          {guideLinks.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </div>
      </div>
    </section>

    <section class="learn-strip" id="supporting-tools" aria-label="เครื่องมือเสริม">
      <p>เครื่องมือเสริม</p>
      <a href="/calendar/">วันพระและปฏิทินไทย</a>
      <a href="/horoscope/seamsi/">เซียมซี</a>
      <a href="/tarot/daily/">ไพ่ประจำวัน</a>
      <a href="/horoscope/palmistry/">ลายมือ</a>
    </section>
  </main>
</BaseLayout>
