---
import BaseLayout from "../layouts/BaseLayout.astro";

const heroSlides = [
  { src: "/assets/images/hero-temple-red.jpg", alt: "จิตรกรรมฝาผนังวัดไทยในโทนแดงทอง" },
  { src: "/assets/images/hero-jtha-98.jpg", alt: "บรรยากาศสถานที่ศักดิ์สิทธิ์สำหรับไหว้พระ" },
  { src: "/assets/images/hero-jtha-83.jpg", alt: "วัดและศาลเจ้าสำหรับขอพรเสริมมงคล" },
  { src: "/assets/images/hero-jtha-80.jpg", alt: "พระพุทธรูปและพื้นที่สักการะในวัด" },
  { src: "/assets/images/chinese-incense-card.jpg", alt: "ธูปวงแขวนในศาลเจ้าจีน" },
];

const intentLinks = [
  {
    no: "๐๑",
    kicker: "โชคลาภ",
    label: "เสริมโชคลาภ เงินทอง",
    description: "องค์เทพและวัดที่คนศรัทธานิยมไปขอเรื่องการเงิน หมุนเวียน และโชคลาภ",
    href: "/temples/sacred/?q=โชคลาภ",
  },
  {
    no: "๐๒",
    kicker: "การงาน",
    label: "การงาน ความก้าวหน้า",
    description: "สายขอพรเรื่องหน้าที่การงาน ตำแหน่ง และการสอบหรือสัมภาษณ์ครั้งสำคัญ",
    href: "/temples/sacred/?q=การงาน",
  },
  {
    no: "๐๓",
    kicker: "ความรัก",
    label: "ความรัก เนื้อคู่",
    description: "สถานที่ขอพรเรื่องความรัก คู่ครอง และความสัมพันธ์ที่มั่นคงยืนยาว",
    href: "/temples/sacred/?q=ความรัก",
  },
  {
    no: "๐๔",
    kicker: "ครอบครัว",
    label: "สุขภาพ และครอบครัว",
    description: "ขอพรเรื่องสุขภาพ ความคุ้มครอง และความสงบสุขของคนที่บ้าน",
    href: "/temples/sacred/?q=สุขภาพ",
  },
  {
    no: "๐๕",
    kicker: "เริ่มใหม่",
    label: "เริ่มต้นชีวิตใหม่",
    description: "เหมาะกับช่วงเปลี่ยนงาน ย้ายบ้าน หรืออยากตั้งต้นชีวิตอีกครั้ง",
    href: "/temples/popular/?q=เริ่มต้น",
  },
  {
    no: "๐๖",
    kicker: "แก้ชง",
    label: "แก้ชง สะเดาะเคราะห์",
    description: "สำหรับปีชงหรือช่วงติดขัด ไปทำบุญ สะเดาะเคราะห์ และเสริมกำลังใจ",
    href: "/temples/mu/?q=แก้ชง",
  },
];

const tickerItems = [
  "๙ เส้นทางไหว้พระยอดนิยม",
  "๔๔,๗๐๔ วัดทั่วไทยพร้อมค้นหา",
  "พิกัดพร้อมนำทางจริง",
  "จัดทริป ๓ / ๕ / ๙ แห่ง",
];

const planStops = [
  {
    time: "09:00",
    title: "วัดพระเชตุพนฯ (วัดโพธิ์)",
    detail: "พระนคร · ทำบุญ ขอพรสุขภาพ",
    image: "/assets/images/hero-jtha-80.jpg",
  },
  {
    time: "10:15",
    title: "วัดอรุณราชวราราม",
    detail: "บางกอกใหญ่ · ขอพรการงาน",
    image: "/assets/images/hero-jtha-98.jpg",
  },
  {
    time: "11:20",
    title: "วัดกัลยาณมิตรฯ",
    detail: "ธนบุรี · ขอพรเดินทางปลอดภัย",
    image: "/assets/images/temple-placeholder-auspicious.png",
  },
];

const collectionCards = [
  {
    variant: "popular",
    kicker: "Popular · เดินทาง",
    title: "สายไหว้พระ ๙ วัด",
    description: "วัดดังที่คนรู้จัก จัดมาเป็นเส้นทางต่อเนื่อง เหมาะกับวันหยุดหรือทริปไหว้ครบ",
    href: "/temples/popular/",
    linkLabel: "จัดเป็นเส้นทาง",
  },
  {
    variant: "sacred",
    kicker: "Sacred · ศรัทธา",
    title: "วัดศักดิ์สิทธิ์",
    description: "สถานที่เชื่อถือ เลือกจากจังหวัด ภูมิภาค และเรื่องที่ตั้งใจขอพร พร้อมพิกัดและข้อมูลประกอบ",
    href: "/temples/sacred/",
    linkLabel: "ค้นหาตามความตั้งใจ",
  },
  {
    variant: "mu",
    kicker: "Mu · กำลังใจ",
    title: "สถานที่สายมู",
    description: "เข้าถึงง่าย ไม่ฉูดฉาด รวมสถานที่เสริมดวง แก้ชง และเสริมกำลังใจ เลือกไปแบบพอดีตัว",
    href: "/temples/mu/",
    linkLabel: "ดูสถานที่เด่น",
  },
];

const guideLinks = [
  { label: "เตรียมตัวก่อนไหว้พระ", href: "/temples/" },
  { label: "เลือกเส้นทางให้เหมาะกับเวลา", href: "/temples/planner/" },
  { label: "ดูสถานที่ใกล้ขอพร", href: "/temples/sacred/" },
];

const supportingLinks = [
  { label: "วันพระและปฏิทินไทย", href: "/calendar/" },
  { label: "เซียมซี", href: "/horoscope/seamsi/" },
  { label: "ไพ่ประจำวัน", href: "/tarot/daily/" },
];

const extraScripts = ["/assets/js/home-motion.js"];
---

<BaseLayout
  title="มงคลเวลา | วัดดัง สถานที่ศักดิ์สิทธิ์ และเส้นทางไหว้พระเสริมมงคล"
  description="มงคลเวลา ช่วยค้นหาวัดดัง สถานที่ศักดิ์สิทธิ์ เส้นทางไหว้พระ 9 วัด สถานที่สายมู วัดทั่วไทย และตัวช่วยวางแผนไหว้พระเพื่อเสริมมงคลชีวิต"
  lang="th"
  locale="th"
  page="home"
  bodyClass="home-v2-page"
  extraScripts={extraScripts}
  canonicalPath="/"
  image="/assets/images/hero-temple-red.jpg"
  imageAlt="มงคลเวลา วัดดัง สถานที่ศักดิ์สิทธิ์ และเส้นทางไหว้พระเสริมมงคล"
  breadcrumbs={[{ label: "หน้าแรก", href: "/" }]}
>
  <script is:inline>
    document.documentElement.classList.add("home-text-motion-pending");
  </script>
  <main data-cms-preserve-section-order>
    <section class="hero home-aura-hero" aria-labelledby="hero-title">
      <div class="hero-carousel" data-carousel>
        {heroSlides.map((slide, index) => (
          <div class={`hero-slide${index === 0 ? " is-active" : ""}`}>
            <img src={slide.src} alt={slide.alt} />
          </div>
        ))}
      </div>
      <div class="hero-shade"></div>
      <div class="home-hero-motion" aria-hidden="true">
        <span class="home-orbit home-orbit-one"></span>
        <span class="home-orbit home-orbit-two"></span>
        <span class="home-ritual-line home-ritual-line-one"></span>
        <span class="home-ritual-line home-ritual-line-two"></span>
      </div>

      <div class="hero-content home-hero-shell">
        <div class="home-hero-copy">
          <p class="eyebrow">วัดดัง · สถานที่ศักดิ์สิทธิ์ · เส้นทางมงคล</p>
          <h1 id="hero-title">
            <span>วางแผนไหว้</span>
            <span>พระ</span>
            <mark>ให้ตรงกับใจ</mark>
          </h1>
          <p class="hero-copy">
            บอกเราแค่สิ่งที่อยากเสริม หรือจังหวัดที่อยากไป มงคลเวลาหาวัดจริง
            จัดลำดับเส้นทาง และบอกพิกัดให้พร้อมออกเดินทาง
          </p>

          <form class="hero-search home-temple-search" action="/temples/sacred/" role="search">
            <label class="sr-only" for="site-search">ค้นหาวัดหรือสถานที่ศักดิ์สิทธิ์</label>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m21 21-4.3-4.3m2.3-5.2a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z"></path>
            </svg>
            <input
              id="site-search"
              name="q"
              type="search"
              placeholder="ค้นหาวัด จังหวัด หรือพร เช่น โชคลาภ การงาน ความรัก"
            />
            <button type="submit">ค้นหา</button>
          </form>

          <div class="hero-links" aria-label="ทางลัดหน้าแรก">
            <a class="is-primary" href="/temples/planner/">เริ่มวางแผนไหว้พระ</a>
            <a href="/temples/popular/">ไหว้พระ ๙ วัด</a>
            <a href="/temples/thailand/">วัดทั่วไทย</a>
          </div>
        </div>

        <aside class="home-today-card" id="today" aria-label="ฤกษ์วันนี้">
          <p>ฤกษ์วันนี้ · Today</p>
          <strong data-topbar-realtime="solarToday">วันอาทิตย์ที่ 19 กรกฎาคม 2569</strong>
          <span>
            เป็นวันดีสำหรับ<strong>เริ่มสิ่งใหม่และทำบุญ</strong>
            เหมาะกับการไปกราบขอพรเรื่องการงานและโชคลาภ
          </span>
          <a href="/calendar/">ดูปฏิทินวันพระ</a>
        </aside>
      </div>

      <div class="hero-controls" aria-label="ภาพประกอบหน้าแรก">
        <button class="hero-arrow" type="button" data-carousel-prev aria-label="ภาพก่อนหน้า">
          <span aria-hidden="true">‹</span>
        </button>
        <div class="hero-dots" aria-label="เลือกภาพประกอบ">
          {heroSlides.map((_, index) => (
            <button
              class={index === 0 ? "is-active" : ""}
              type="button"
              data-carousel-dot
              aria-label={`ภาพที่ ${index + 1}`}
              aria-pressed={index === 0 ? "true" : "false"}
            ></button>
          ))}
        </div>
        <button class="hero-arrow" type="button" data-carousel-next aria-label="ภาพถัดไป">
          <span aria-hidden="true">›</span>
        </button>
      </div>
    </section>

    <section class="home-stat-ticker" aria-label="ภาพรวมวัดและเส้นทางมงคล">
      <div>
        {tickerItems.map((item) => (
          <span>{item}</span>
        ))}
      </div>
    </section>

    <section class="home-section home-intent-section" id="intent" aria-labelledby="intent-title">
      <div class="home-section-heading home-intent-heading">
        <p><span>๐๑</span> เริ่มจากความตั้งใจ</p>
        <h2 id="intent-title">อยากเสริมเรื่องไหน เริ่มตรงนี้</h2>
      </div>

      <div class="home-intent-grid">
        {intentLinks.map((item) => (
          <a class="home-intent-card" href={item.href}>
            <span>{item.no} / {item.kicker}</span>
            <strong>{item.label}</strong>
            <p>{item.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="home-planner-spotlight" id="temple-routes" aria-labelledby="planner-title">
      <div class="home-planner-inner">
        <div class="home-planner-copy">
          <p><span>๐๒</span> ตัวช่วยของเรา</p>
          <h2 id="planner-title">บอกแค่ความตั้งใจ ที่เหลือเราจัดเส้นทางให้</h2>
          <p>
            เลือกจำนวนวัด พื้นที่ เวลา และสิ่งที่อยากเสริม ระบบจะเรียงลำดับให้เดินทางต่อเนื่อง
            และใช้ข้อมูลพิกัดจริงกับคำอธิบายที่ตรวจสอบได้ก่อนออกเดินทาง
          </p>
          <div class="home-planner-tags" aria-label="ตัวเลือกหลักในการจัดทริป">
            <span>จำนวน ๓/๕/๙</span>
            <span>พื้นที่ · จังหวัด</span>
            <span>พรที่ตั้งใจ</span>
          </div>
          <a class="primary-action" href="/temples/planner/">เริ่มวางแผนของคุณ</a>
        </div>

        <article class="home-sample-plan" aria-label="ตัวอย่างแผนไหว้พระ">
          <header>
            <p>ตัวอย่างทริป · Sample plan</p>
            <strong>ไหว้พระเริ่มเช้า ๓ วัด · กรุงเทพฯ</strong>
            <span>รวม ๑๑ กม.</span>
          </header>
          <ol>
            {planStops.map((stop) => (
              <li>
                <time>{stop.time}</time>
                <img src={stop.image} alt="" loading="lazy" />
                <div>
                  <strong>{stop.title}</strong>
                  <p>{stop.detail}</p>
                  <span>ข้อมูลพิกัดพร้อมตรวจสอบ</span>
                </div>
              </li>
            ))}
          </ol>
          <p class="home-plan-note">
            ทำไมเรียงแบบนี้: เริ่มจากจุดศูนย์กลางเมืองแล้วไล่ตามเวลาเปิดและระยะเดินทางโดยประมาณ
          </p>
        </article>
      </div>
    </section>

    <section class="home-section home-collections-section" id="collections" aria-labelledby="collections-title">
      <div class="home-section-heading home-collection-heading">
        <p><span>๐๓</span> เลือกแบบการออกบุญ</p>
        <div>
          <h2 id="collections-title">สามสาย สามบุคลิก</h2>
          <a class="section-link" href="/temples/">ดูทั้งหมด</a>
        </div>
      </div>

      <div class="home-collection-grid">
        {collectionCards.map((card) => (
          <a class={`home-collection-card is-${card.variant}`} href={card.href}>
            <span>{card.kicker}</span>
            <strong>{card.title}</strong>
            <p>{card.description}</p>
            <em>{card.linkLabel}</em>
          </a>
        ))}
      </div>
    </section>

    <section class="home-section home-guide-section" id="guides" aria-labelledby="guides-title">
      <figure class="home-guide-media">
        <img src="/assets/images/chinese-incense-card.jpg" alt="ธูปวงแขวนในศาลเจ้าจีน" loading="lazy" />
        <figcaption>๐๔ · เตรียมตัวก่อนไป</figcaption>
      </figure>
      <div class="home-guide-copy">
        <p>คู่มือก่อนเดินทาง</p>
        <h2 id="guides-title">ไหว้พระแบบตั้งใจ สุภาพ และไม่เร่งร้อน</h2>
        <p>
          มงคลเวลาวางบทบาทเป็นผู้ช่วยค้นหาสถานที่และจัดเส้นทางก่อนออกเดินทาง
          คงข้อมูลให้กระชับ เคารพสถานที่ และบอกตรง ๆ เมื่อบางข้อมูลควรตรวจสอบซ้ำ
        </p>
        <div class="ritual-list">
          {guideLinks.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </div>
      </div>
    </section>

    <section class="learn-strip" id="supporting-tools" aria-label="เครื่องมือเสริม">
      <p>เครื่องมือเสริม</p>
      {supportingLinks.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </section>
  </main>
</BaseLayout>
