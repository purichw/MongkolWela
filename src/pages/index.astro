---
import { homeDirectorySummary } from "../data/home-directory-summary.js";
import { sitePlaceholderImage } from "../lib/image-placeholder.js";
import cmsSeed from "../../public/admin/content/live.json";
import { homeHeroAttributes, imageCreditUrl } from "../lib/home-hero-media.js";
import BaseLayout from "../layouts/BaseLayout.astro";
import TempleSearchForm from "../components/TempleSearchForm.astro";
import HomeSymbol from "../components/HomeSymbol.astro";
import CarouselControls from "../components/CarouselControls.astro";
import SiteIcon from "../components/icons/SiteIcon.astro";
import IconMedallion from "../components/IconMedallion.astro";
import CmsImage from "../components/CmsImage.astro";
import LinkArrow from "../components/LinkArrow.astro";
import BrandOrnament from "../components/BrandOrnament.astro";
import { getHomeToday } from "../lib/home-today.js";

const templeCount = homeDirectorySummary.templeCount.toLocaleString("en-US");
const provinceCount = homeDirectorySummary.provinceCount;
const { date: today, weekday, lunarLabel, moon } = getHomeToday();
type HeroImage = { id?: string; enabled?: boolean; src?: string; alt?: string; position?: string; credit?: string; sourceUrl?: string; license?: string; licenseUrl?: string };
const homePatches: HeroImage[] = cmsSeed.pages.find(page => page.id === "home")?.patches || [];
const media = (id: string) => homePatches.find(patch => patch.id === id && patch.enabled !== false);
// Keep stable CMS selectors and carousel slots; published patches take precedence.
const heroSlides = Array.from({ length: 5 }, (_, i) =>
  homePatches.find(patch => patch.id === `home-hero-image-${i + 1}` && patch.enabled !== false) || { src: "", alt: "" });
const quickActions = [
  { title: "วางแผนไหว้พระ", mobileTitle: "วางแผนไหว้พระ", description: "จัดลำดับเส้นทาง", href: "/temples/planner/", icon: "altar" },
  { title: "เส้นทาง ๙ วัด", mobileTitle: "เส้นทาง ๙ วัด", description: "เลือกวัดในทริป", href: "/temples/popular/", icon: "route" },
  { title: "วัดทั่วประเทศไทย", mobileTitle: "วัดทั่วไทย", description: "ค้นหาทุกจังหวัด", href: "/temples/thailand/", icon: "stupa" },
] as const;
const intentLinks = [
  { id: "wealth", label: "เสริมโชคลาภ เงินทอง", description: "การเงิน การค้า และกำลังใจ", href: "/temples/sacred/?q=โชคลาภ", icon: "coins" },
  { id: "career", label: "การงาน ความก้าวหน้า", description: "หน้าที่การงานและโอกาสใหม่", href: "/temples/sacred/?q=การงาน", icon: "stupa" },
  { id: "love", label: "ความรัก เนื้อคู่", description: "ความรักและความสัมพันธ์", href: "/temples/sacred/?q=ความรัก", icon: "lotus" },
  { id: "family", label: "สุขภาพ และครอบครัว", description: "สุขภาพและกำลังใจคนในบ้าน", href: "/temples/sacred/?q=สุขภาพ", icon: "sprout" },
  { id: "beginning", label: "เริ่มต้นชีวิตใหม่", description: "เปลี่ยนงาน ย้ายบ้าน เริ่มต้นใหม่", href: "/temples/popular/?q=เริ่มต้น", icon: "sunrise" },
  { id: "peace", label: "แก้ชง สะเดาะเคราะห์", description: "ทำบุญและเสริมกำลังใจ", href: "/temples/mu/?q=แก้ชง", icon: "flame" },
] as const;
const planStops = [
  { id: "pho", time: "09:00", title: "วัดพระเชตุพนฯ (วัดโพธิ์)", detail: "กรุงเทพฯ · พระนคร" },
  { id: "arun", time: "10:15", title: "วัดอรุณราชวราราม", detail: "กรุงเทพฯ · บางกอกใหญ่" },
  { id: "kalayanamit", time: "11:20", title: "วัดกัลยาณมิตรฯ", detail: "กรุงเทพฯ · ธนบุรี" },
];
const collections = [
  { variant: "popular", title: "วัดดังน่าไป", description: "จัดเส้นทางไหว้พระต่อเนื่อง", href: "/temples/popular/" },
  { variant: "sacred", title: "วัดเด่นขอพร", description: "เลือกตามจังหวัดและความตั้งใจ", href: "/temples/sacred/" },
  { variant: "mu", title: "พิกัดสายมู", description: "สักการะ ทำบุญ เสริมกำลังใจ", href: "/temples/mu/" },
];
const tools = [
  { label: "ปฏิทินไทย", compactLabel: "ปฏิทินไทย", description: "วันสำคัญและรายละเอียด", compactDescription: "ดูวันสำคัญ", href: "/calendar/", icon: "calendar-days" },
  { label: "วันพระ", compactLabel: "วันพระ", description: "เช็กวันพระตลอดปี", compactDescription: "ตลอดปี", href: "/calendar/?view=month", icon: "lotus" },
  { label: "คำเซียมซี", compactLabel: "คำเซียมซี", description: "เสี่ยงทายคำธรรม", compactDescription: "เสี่ยงทาย", href: "/horoscope/seamsi/", icon: "scroll-text" },
  { label: "ไพ่ยิปซีรายวัน", compactLabel: "ไพ่ยิปซี", description: "ดูดวงรายวัน", compactDescription: "ดูรายวัน", href: "/tarot/daily/", icon: "layers-2" },
  { label: "อ่านลายมือ", compactLabel: "อ่านลายมือ", description: "ค้นหาความหมายลายมือ", compactDescription: "ดูลายมือ", href: "/horoscope/palmistry/", icon: "hand" },
] as const;
---

<BaseLayout
  title="มงคลเวลา | วางแผนไหว้พระ วัดเด่นขอพร และข้อมูลมงคล"
  description="มงคลเวลาเป็นคู่มือค้นหาวัด สถานที่ศักดิ์สิทธิ์ เส้นทางไหว้พระ 9 วัด วัดทั่วไทย และเครื่องมือวางแผนเดินทางมงคลสำหรับผู้ใช้ไทย"
  lang="th" locale="th" page="home" bodyClass="home-v2-page home-reconstructed" canonicalPath="/"
  image={heroSlides[0].src} imageAlt={heroSlides[0].alt}
  breadcrumbs={[{ label: "หน้าแรก", href: "/" }]}
>
  <main data-cms-preserve-section-order>
    <section class="hero home-aura-hero" aria-labelledby="hero-title">
      <div class="hero-carousel" data-carousel>
        {heroSlides.map((slide, i) => (
          <div class:list={["hero-slide", { "is-active": i === 0 }]} aria-hidden={i !== 0}>
            <img id={`home-hero-image-${i + 1}`} data-cms-field="95d291e9-1" src={i === 0 ? slide.src || sitePlaceholderImage : undefined} data-carousel-src={slide.src || sitePlaceholderImage}
              {...homeHeroAttributes(slide)} data-home-hero-image style={{ objectPosition: slide.position }}
              alt={slide.alt} width="1920" height="1080" fetchpriority={i === 0 ? "high" : "low"}
              decoding="async" data-home-media data-fallback-src={sitePlaceholderImage} />
          </div>
        ))}
      </div>
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="home-hero-ornaments"><BrandOrnament /><BrandOrnament mirrored /></div>
      <div class="hero-content home-hero-shell">
        <div class="home-hero-copy">
          <nav class="home-hero-breadcrumb" aria-label="เส้นทางนำทาง"><a data-cms-field="95d291e9-2" href="/">หน้าแรก</a><span aria-hidden="true">›</span><span data-cms-field="95d291e9-3" aria-current="page">มงคลเวลา</span></nav>
          <h1 data-cms-field="95d291e9-4" id="hero-title">มงคลเวลา</h1>
          <p data-cms-field="95d291e9-5" class="home-hero-subtitle">ค้นหาวัด สร้างเส้นทางบุญ วางแผนไหว้พระในวันมงคล</p>
          <p data-cms-field="95d291e9-6" class="hero-copy">ค้นหาวัด สร้างเส้นทางบุญ วางแผนไหว้พระอย่างรอบคอบ<br />พร้อมข้อมูลสถานที่และปฏิทินไทยสำหรับตรวจสอบก่อนเดินทาง</p>
          <TempleSearchForm id="site-search" variant="home" />
          <nav class="hero-links" aria-label="ทางลัดหน้าแรก">
            {quickActions.map((item, i) => (
              <a class:list={["ui-glass", { "is-primary": i === 0 }]} href={item.href}>
                <HomeSymbol name={item.icon} />
                <span><strong data-cms-field="95d291e9-7" class="hero-shortcut-full">{item.title}</strong><strong data-cms-field="95d291e9-8" class="hero-shortcut-compact">{item.mobileTitle}</strong><small data-cms-field="95d291e9-9">{item.description}</small></span>
              </a>
            ))}
          </nav>
        </div>
        <aside class="home-today-card ui-glass" id="today" aria-labelledby="today-title">
          <div class="home-today-heading">
            <HomeSymbol name="lotus" />
            <h2 data-cms-field="95d291e9-10" id="today-title">ข้อมูลประจำวัน</h2>
            <a data-cms-field="95d291e9-11" href="/calendar/">ดูทั้งหมด <span aria-hidden="true">→</span></a>
          </div>
          <a data-cms-field="95d291e9-12" class="home-today-date" href="/calendar/day/" title="ดูรายละเอียดวันนี้" data-topbar-realtime="solarToday">{today}</a>
          <div class="home-today-summary">
            <span class="home-today-moon" data-home-moon={moon} aria-hidden="true"></span>
            <div class="home-today-details">
              <div class="home-today-meta">
                <a class="home-today-lunar" href="/calendar/day/" title="ดูรายละเอียดปฏิทินจันทรคติ">
                  <span data-cms-field="95d291e9-13" data-home-lunar>{lunarLabel}</span>
                  <small data-cms-field="95d291e9-14">คำนวณเบื้องต้น</small>
                </a>
                <span data-cms-field="95d291e9-15" class="home-weekday" data-home-weekday>{weekday}</span>
              </div>
              <p data-cms-field="95d291e9-16" class="home-today-note">เลือกวันให้เหมาะกับเวลาของคุณ แล้วตรวจสอบวันพระและรายละเอียดประจำวันก่อนออกเดินทาง</p>
            </div>
          </div>
          <nav class="home-today-actions" aria-label="ทางลัดปฏิทิน">
            <a href="/calendar/day/"><HomeSymbol name="calendar-days" /><span data-cms-field="95d291e9-17">รายละเอียดวันนี้</span></a>
            <a href="/calendar/?view=month"><HomeSymbol name="lotus" /><span data-cms-field="95d291e9-18">ปฏิทินวันพระ</span></a>
            <a href="/calendar/?view=events"><HomeSymbol name="stupa" /><span data-cms-field="95d291e9-19">วันสำคัญ</span></a>
          </nav>
        </aside>
      </div>
      <div class="home-hero-media-controls">
        <div class="home-hero-credit" data-home-hero-credit data-demo-hidden hidden>
          <a data-cms-field="95d291e9-20" href={imageCreditUrl(heroSlides[0].sourceUrl)} target="_blank" rel="noopener noreferrer">{heroSlides[0].credit}</a>
          {heroSlides[0].license && <> · <a data-cms-field="95d291e9-21" href={imageCreditUrl(heroSlides[0].licenseUrl)} target="_blank" rel="noopener noreferrer">{heroSlides[0].license}</a></>}
        </div>
        <CarouselControls count={heroSlides.length} label="ภาพประกอบหน้าแรก" class="hero-controls" />
      </div>
    </section>

    <section class="home-stat-ticker" aria-label="ข้อมูลสำหรับวางแผน">
      <dl>
        <div><dt data-cms-field="home-directory-label"><HomeSymbol name="stupa" />สถานที่พร้อมพิกัด</dt><dd><span data-directory-summary="templeCount" data-temple-count>{templeCount}</span></dd></div>
        <div><dt data-cms-field="95d291e9-24"><HomeSymbol name="map-pin" />จังหวัด</dt><dd data-directory-summary="provinceCount">{provinceCount}</dd></div>
        <div><dt data-cms-field="95d291e9-26"><HomeSymbol name="route" />สถานที่ต่อแผน</dt><dd>3 / 5 / 9</dd></div>
        <div class="home-stat-note"><dt data-cms-field="95d291e9-27"><HomeSymbol name="quote" />ก่อนออกเดินทาง</dt><dd data-cms-field="95d291e9-28">ตรวจสอบเวลาเปิด–ปิด<br />และข้อมูลของแต่ละสถานที่</dd></div>
      </dl>
    </section>

    <section class="home-section home-intent-section home-intent-panel" id="intent" aria-labelledby="intent-title">
      <div class="home-section-heading home-intent-heading">
        <div><p data-cms-field="95d291e9-29" class="home-kicker">วางแผนตามเป้าหมายชีวิต</p><h2 data-cms-field="95d291e9-30" id="intent-title">เลือกเรื่องที่ต้องการวางแผน</h2></div>
        <a data-cms-field="95d291e9-31" class="section-link" href="/temples/sacred/">ดูทั้งหมด <span aria-hidden="true">→</span></a>
      </div>
      <div class="home-intent-grid">
        {intentLinks.map(item => (
          <a class:list={["home-intent-card", `is-${item.id}`]} href={item.href}>
            <div class="home-intent-media"><CmsImage mediaId={`home-intent-${item.id}`} image={media(`home-intent-${item.id}`)} width={720} height={440} /></div>
            <div class="home-intent-body">
              <IconMedallion class="home-intent-icon"><SiteIcon name={item.icon} /></IconMedallion>
              <strong data-cms-field="95d291e9-32">{item.label.split(" ").map((part, index) => <>{index > 0 && " "}<span data-cms-field="95d291e9-33">{part}</span></>)}</strong><p data-cms-field="95d291e9-34">{item.description}</p><LinkArrow class="home-card-arrow" />
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="home-planner-spotlight" id="temple-routes" aria-labelledby="planner-title">
      <CmsImage class="home-planner-background" mediaId="home-planner-background" image={media("home-planner-background")} width={1600} height={900} />
      <BrandOrnament /><BrandOrnament mirrored />
      <div class="home-planner-inner">
        <div class="home-planner-copy">
          <p data-cms-field="95d291e9-35" class="home-kicker">วางแผนการเดินทาง</p>
          <h2 data-cms-field="95d291e9-36" id="planner-title">สร้างเส้นทางไหว้พระ<br />ให้ทุกการเดินทางมีความหมาย</h2>
          <p data-cms-field="95d291e9-37">เลือกวัด กำหนดวัน เวลา และความตั้งใจ ให้ระบบช่วยจัดลำดับเส้นทาง พร้อมข้อมูลประกอบสำหรับตรวจสอบก่อนเดินทาง</p>
          <a data-cms-field="95d291e9-38" class="primary-action" href="/temples/planner/">เริ่มวางแผนไหว้พระ <span aria-hidden="true">→</span></a>
        </div>
        <article class="home-sample-plan" aria-labelledby="sample-plan-title">
          <header><h3 data-cms-field="95d291e9-39" id="sample-plan-title">ตัวอย่างเส้นทาง 1 วัน</h3><a data-cms-field="95d291e9-40" href="/temples/planner/">จัดแผนของคุณ <SiteIcon name="arrow-right" /></a></header>
          <div class="home-sample-content"><ol aria-label="ตัวอย่างไหว้พระริมน้ำ 3 วัด กรุงเทพฯ">
            {planStops.map(stop => (
              <li><time>{stop.time}</time><CmsImage mediaId={`home-stop-${stop.id}`} image={media(`home-stop-${stop.id}`)} width={120} height={90} /><div><strong data-cms-field="95d291e9-41">{stop.title}</strong><p data-cms-field="95d291e9-42">{stop.detail}</p></div></li>
            ))}
          </ol><blockquote class="home-plan-quote"><SiteIcon name="quote" /><p data-cms-field="95d291e9-43">เส้นทางบุญ<br />ไม่ใช่แค่การไปถึงวัด<br />แต่คือการได้พบ<br />สิ่งที่ดีกว่าในใจเรา</p><BrandOrnament class="home-quote-flower" mirrored /></blockquote></div>
          <p data-cms-field="95d291e9-44" class="home-plan-note">เวลาเป็นตัวอย่าง ไม่รวมสภาพจราจร ควรตรวจสอบเวลาเปิด–ปิดก่อนเดินทาง <a data-cms-field="95d291e9-45" href="/assets/images/home-media-credits.txt" target="_blank" rel="noopener noreferrer">เครดิตภาพ</a></p>
        </article>
      </div>
    </section>

    <section class="home-section home-collections-section" id="collections" aria-labelledby="collections-title">
      <div class="home-section-heading home-collection-heading">
        <div><p data-cms-field="95d291e9-46" class="home-kicker">ค้นหาตามประเภท</p><h2 data-cms-field="95d291e9-47" id="collections-title">เลือกจากหมวดหลัก</h2></div>
        <a data-cms-field="95d291e9-48" class="section-link" href="/temples/">ดูทุกหมวด <span aria-hidden="true">→</span></a>
      </div>
      <div class="home-discovery-grid">
        <div class="home-collection-grid">
          {collections.map(card => (
            <a class:list={["home-collection-card", "is-" + card.variant]} href={card.href}>
              <div class="home-collection-media"><CmsImage mediaId={`home-collection-${card.variant}`} image={media(`home-collection-${card.variant}`)} width={360} height={480} /></div>
              <div class="home-collection-body"><strong data-cms-field="95d291e9-49">{card.title}</strong><p data-cms-field="95d291e9-50">{card.description}</p><LinkArrow class="home-card-arrow" /></div>
            </a>
          ))}
        </div>
        <aside class="home-database-panel" id="directory" aria-labelledby="directory-title">
          <CmsImage mediaId="home-directory-map" image={media("home-directory-map")} width={100} height={160} />
          <div><h3 data-cms-field="95d291e9-51" id="directory-title">ค้นหาวัดทั่วประเทศไทย</h3><p><strong data-directory-summary="templeCount" data-temple-count>{templeCount}</strong> สถานที่พร้อมพิกัด<br />ค้นหาวัดและเปิดเส้นทางเดินทาง</p><a data-cms-field="95d291e9-54" href="/temples/thailand/">เปิดฐานข้อมูล <span aria-hidden="true">→</span></a></div>
        </aside>
      </div>
    </section>

    <section class="learn-strip" id="supporting-tools" aria-labelledby="tools-title">
      <div><h2 data-cms-field="95d291e9-55" id="tools-title">เครื่องมือเสริม</h2><p data-cms-field="95d291e9-56">ประกอบการวางแผนและความตั้งใจ</p></div>
      <nav class="home-tool-links" aria-label="เครื่องมือเสริม">{tools.map(item => <a href={item.href} aria-label={item.label}><SiteIcon name={item.icon} /><span class="home-tool-full"><strong data-cms-field="95d291e9-57">{item.label}</strong><small data-cms-field="95d291e9-58">{item.description}</small></span><span class="home-tool-compact"><strong data-cms-field="95d291e9-59">{item.compactLabel}</strong><small data-cms-field="95d291e9-60">{item.compactDescription}</small></span><LinkArrow /></a>)}</nav>
    </section>
  </main>
  <script>
    import "../scripts/home-motion.js";
    import "../scripts/home.js";
  </script>
</BaseLayout>
