---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CommerceNav from "../../components/CommerceNav.astro";
import CommerceBreadcrumb from "../../components/CommerceBreadcrumb.astro";
import SiteIcon from "../../components/icons/SiteIcon.astro";
import { iconAttributes } from "../../lib/ui-markup.js";
import "../../styles/commerce.css";
import "../../styles/commerce-landing.css";
import "../../styles/merit.css";
---
<BaseLayout title="กฐินและร่วมบุญ | มงคลเวลา" description="ค้นหารายการกฐิน จองร่วมเป็นเจ้าภาพ และตรวจสอบช่องทาง e-Donation ของวัด" page="merit" robots="noindex,follow" analytics={false}>
  <main class="commerce-page commerce-landing merit-page" data-page-pending="commerce" data-commerce-public="merit" data-commerce-state="loading">
    <div class="commerce-frame"><CommerceBreadcrumb page="merit" /><CommerceNav active="merit" /></div>
    <section class="merit-closed" data-commerce-unavailable hidden aria-labelledby="merit-closed-title">
      <div class="merit-closed-art">
        <img class="merit-closed-desktop" data-cms-field="merit-closed-image" src="/assets/images/merit-coming-soon.webp" width="1800" height="600" alt="ภาพประกอบผ้าไตรบนพานทอง ท่ามกลางลายวัดและใบโพธิ์" />
        <img class="merit-closed-mobile" data-cms-field="merit-closed-mobile-image" src="/assets/images/merit-coming-soon-mobile.webp" width="700" height="500" alt="ภาพประกอบผ้าไตรบนพานทอง" />
      </div>
      <div class="commerce-frame merit-closed-content">
        <SiteIcon name="lotus" />
        <h1 id="merit-closed-title"><span data-cms-field="f9c40326-2">กฐินและร่วมบุญ</span><span data-cms-field="merit-closed-status">ยังไม่เปิดให้บริการ</span></h1>
        <p data-cms-field="merit-closed-description">เรากำลังเตรียมระบบเพื่อให้คุณร่วมบุญได้อย่างสะดวก<br />พร้อมข้อมูลของวัดและผู้จัดที่ตรวจสอบได้</p>
        <a class="commerce-button secondary" href="/shop/" data-cms-field="merit-back-shop">กลับหน้าร้านค้า<SiteIcon name="arrow-right" /></a>
      </div>
    </section>
    <section class="merit-hero" data-commerce-catalog hidden aria-labelledby="merit-title">
      <img data-cms-field="merit-banner-image" src="/assets/images/merit-robes-banner.webp" alt="" width="1800" height="600" />
      <div class="commerce-frame merit-hero-content">
        <p data-cms-field="f9c40326-1" class="section-kicker">ร่วมทอดกฐินและทำบุญ</p>
        <h1 id="merit-title" data-cms-field="f9c40326-2">กฐินและร่วมบุญ</h1>
        <p data-cms-field="merit-hero-quote" class="merit-hero-quote">“บุญที่ตั้งใจ ย่อมเดินทางมาถึง”</p>
        <ul class="merit-principles">
          <li><span {...iconAttributes("shield-check")} /><span data-cms-field="merit-principle-source">ข้อมูลจากวัดและผู้จัด</span></li>
          <li><span {...iconAttributes("map-pin")} /><span data-cms-field="merit-principle-location">ตรวจสอบสถานที่ได้</span></li>
          <li><span {...iconAttributes("scroll-text")} /><span data-cms-field="merit-principle-reservation">ติดตามสถานะการจอง</span></li>
        </ul>
      </div>
    </section>
    <div class="commerce-frame merit-content">
      <h1 class="merit-detail-heading" data-cms-field="merit-detail-heading">กฐินและร่วมบุญ</h1>
      <div class="commerce-message" role="status" aria-live="polite" data-commerce-message></div>
      <div data-commerce-content aria-busy="true"><p data-cms-field="f9c40326-3" class="commerce-loading">กำลังโหลดรายการร่วมบุญ</p></div>
    </div>
    <noscript><p class="commerce-frame">เปิด JavaScript เพื่อตรวจสอบสถานะและรายการร่วมบุญ หรือ <a href="/shop/">กลับหน้าร้านค้า</a></p></noscript>
  </main>
  <script>import "../../scripts/commerce-public.js";</script>
</BaseLayout>
