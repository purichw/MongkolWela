---
import { brandAssets, siteConfig } from "../../config/site.js";
import { stylesForPath } from "../../config/styles.js";
import adminDesign from "../../styles/admin-design.css?url";
import adminContentLibrary from "../../styles/admin-content-library.css?url";
import commerce from "../../styles/commerce.css?url";
import adminShared from "../../styles/admin-shared.css?url";
import adminHomepage from "../../styles/admin-homepage.css?url";
import adminNavigation from "../../styles/admin-navigation.css?url";
import adminCommerce from "../../styles/admin-commerce.css?url";
import publicSelect from "../../styles/public-select.css?url";
const config = siteConfig.th;
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ระบบจัดการเว็บ | มงคลเวลา</title>
    <meta name="robots" content="noindex,nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type={brandAssets.favicon.type} sizes={brandAssets.favicon.sizes} href={brandAssets.favicon.src} />
    <link rel="apple-touch-icon" sizes={brandAssets.appleTouchIcon.sizes} href={brandAssets.appleTouchIcon.src} />
    {stylesForPath("/admin/").map((src) => <link rel="stylesheet" href={src} />)}
    <link rel="stylesheet" href={adminDesign} />
    <link rel="stylesheet" href={adminContentLibrary} />
    <link rel="stylesheet" href={commerce} />
    <link rel="stylesheet" href={publicSelect} />
    <link rel="stylesheet" href={adminShared} />
    <link rel="stylesheet" href={adminHomepage} />
    <link rel="stylesheet" href={adminNavigation} />
    <link rel="stylesheet" href={adminCommerce} />
  </head>
  <body class="admin-page admin-design">
    <div
      id="adminApp"
      data-admin-app
      data-brand-name={config.brandName}
      data-brand-subtitle="ADMIN CONSOLE"
      data-brand-label={config.brandLabel}
      data-brand-mark-src={brandAssets.mark.src}
      data-brand-mark-width={brandAssets.mark.width}
      data-brand-mark-height={brandAssets.mark.height}
    >
      <div class="mw-admin-shell">
        <aside class="mw-admin-sidebar">
          <header class="mw-admin-header">
            <a class="mw-admin-logo" href="/admin/" aria-label={config.brandLabel}>
              <img class="mw-admin-logo-mark" src={brandAssets.mark.src} width={brandAssets.mark.width} height={brandAssets.mark.height} alt="" aria-hidden="true" decoding="async" />
              <div><strong>{config.brandName}</strong><small>ADMIN CONSOLE</small></div>
            </a>
          </header>
          <nav class="mw-admin-nav" aria-label="Admin navigation">
          <span class="mw-admin-ghost is-active">⌁ <strong>ภาพรวม</strong></span>
          <span class="mw-admin-ghost">▦ <strong>สถิติการใช้งาน</strong></span>
          <span class="mw-admin-ghost">⌂ <strong>หน้าแรก</strong></span>
          <span class="mw-admin-ghost">≣ <strong>เมนูนำทาง</strong></span>
          <span class="mw-admin-ghost">๙ <strong>วัดและสถานที่</strong></span>
          </nav>
          <div class="mw-admin-sidebar-foot">
            <button class="mw-admin-btn" type="button" disabled>↗ เปิดหน้าเว็บผู้ใช้</button>
            <div class="mw-admin-profile"><span>A</span><div><strong>ผู้ดูแลระบบ</strong><small>กำลังตรวจสอบบัญชี</small></div></div>
            <div class="mw-admin-header-actions"><span class="mw-admin-status">กำลังโหลด</span></div>
          </div>
        </aside>
        <main class="mw-admin-main">
          <header class="mw-admin-top">
            <div><p>ภาพรวมระบบ</p><h1>แดชบอร์ด</h1></div>
          </header>
          <section class="mw-admin-content">
            <div class="mw-admin-grid mw-admin-loading-grid" aria-hidden="true">
              <article class="mw-admin-stat mw-admin-skeleton-card"><i></i><span></span></article>
              <article class="mw-admin-stat mw-admin-skeleton-card"><i></i><span></span></article>
              <article class="mw-admin-stat mw-admin-skeleton-card"><i></i><span></span></article>
              <article class="mw-admin-stat mw-admin-skeleton-card"><i></i><span></span></article>
            </div>
            <div class="mw-admin-card mw-admin-skeleton-panel" role="status" aria-live="polite">
              <div>
                <strong>กำลังโหลดข้อมูล</strong>
                <p>กำลังเตรียมข้อมูลสำหรับระบบจัดการเว็บ</p>
              </div>
              <span></span><span></span><span></span>
            </div>
          </section>
        </main>
      </div>
    </div>
    <script>
      import "../../scripts/admin-portal.js";
    </script>
  </body>
</html>
