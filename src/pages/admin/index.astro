---
const assetVersion = "20260729-admin-01";
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ระบบจัดการเว็บ | มงคลเวลา</title>
    <meta name="robots" content="noindex,nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href={`/styles.css?v=${assetVersion}`} />
  </head>
  <body class="admin-page">
    <div id="adminApp" data-admin-app>
      <div class="mw-admin-shell">
        <aside class="mw-admin-sidebar">
          <header class="mw-admin-header">
            <a class="mw-admin-logo" href="/admin/"><span>๙</span><div><strong>มงคลเวลา</strong><small>ADMIN CONSOLE</small></div></a>
          </header>
          <nav class="mw-admin-nav" aria-label="Admin navigation">
          <span class="mw-admin-ghost is-active">⌁ <strong>ภาพรวม</strong></span>
          <span class="mw-admin-ghost">▦ <strong>สถิติการใช้งาน</strong></span>
          <span class="mw-admin-ghost">⌂ <strong>หน้าแรก</strong></span>
          <span class="mw-admin-ghost">≣ <strong>เมนูนำทาง</strong></span>
          <span class="mw-admin-ghost">๙ <strong>วัดและสถานที่</strong></span>
          </nav>
          <div class="mw-admin-sidebar-foot">
            <button class="mw-admin-btn" type="button" disabled>↗ เปิดหน้าเว็บผู้ใช้</button>
            <div class="mw-admin-profile"><span>ก</span><div><strong>กมล (แอดมิน)</strong><small>ผู้ดูแลระบบ</small></div></div>
            <div class="mw-admin-header-actions"><span class="mw-admin-status">กำลังโหลด</span></div>
          </div>
        </aside>
        <main class="mw-admin-main">
          <header class="mw-admin-top">
            <div><p>ภาพรวมระบบ</p><h1>แดชบอร์ด</h1></div>
          </header>
          <section class="mw-admin-content">
            <div class="mw-admin-grid mw-admin-loading-grid" aria-hidden="true">
              <article class="mw-admin-stat mw-admin-skeleton-card"><i></i><span></span></article>
              <article class="mw-admin-stat mw-admin-skeleton-card"><i></i><span></span></article>
              <article class="mw-admin-stat mw-admin-skeleton-card"><i></i><span></span></article>
              <article class="mw-admin-stat mw-admin-skeleton-card"><i></i><span></span></article>
            </div>
            <div class="mw-admin-card mw-admin-skeleton-panel" role="status" aria-live="polite">
              <div>
                <strong>กำลังโหลดข้อมูล</strong>
                <p>กำลังเตรียมข้อมูลสำหรับระบบจัดการเว็บ</p>
              </div>
              <span></span><span></span><span></span>
            </div>
          </section>
        </main>
      </div>
    </div>
    <script is:inline type="module" src={`/assets/js/admin-portal.js?v=${assetVersion}`}></script>
  </body>
</html>
