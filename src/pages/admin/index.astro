---
const assetVersion = "20260619-09";
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ระบบจัดการเว็บ | มงคลเวลา</title>
    <meta name="robots" content="noindex,nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href={`/styles.css?v=${assetVersion}`} />
  </head>
  <body class="admin-page">
    <div id="adminApp" data-admin-app>
      <div class="mw-admin-shell">
        <header class="mw-admin-header">
          <a class="mw-admin-logo" href="/admin/"><span>MW</span><strong>มงคลเวลา</strong><small>ระบบจัดการเนื้อหา</small></a>
          <div class="mw-admin-header-actions">
            <span class="mw-admin-status">กำลังโหลด</span>
            <button class="mw-admin-btn" type="button" disabled>เปิดเว็บ</button>
            <button class="mw-admin-btn" type="button" disabled>บันทึกฉบับร่าง</button>
            <button class="mw-admin-btn mw-admin-btn-primary" type="button" disabled>✓ Publish</button>
          </div>
        </header>
        <nav class="mw-admin-nav" aria-label="Admin navigation">
          <span class="mw-admin-ghost is-active">⌁ <strong>ภาพรวม</strong></span>
          <span class="mw-admin-ghost">▤ <strong>หน้าและเนื้อหา</strong></span>
          <span class="mw-admin-ghost">◇ <strong>สถานที่ศักดิ์สิทธิ์</strong></span>
          <span class="mw-admin-ghost">↕ <strong>ส่วนหน้าเว็บ</strong></span>
          <span class="mw-admin-ghost mw-admin-nav-logout">↩ <strong>ออกจากระบบ</strong></span>
        </nav>
        <main class="mw-admin-main">
          <header class="mw-admin-top">
            <div><p>ระบบจัดการเว็บ</p><h1>ภาพรวม</h1></div>
          </header>
          <section class="mw-admin-content">
            <div class="mw-admin-grid mw-admin-loading-grid" aria-hidden="true">
              <article class="mw-admin-stat mw-admin-skeleton-card"><i></i><span></span></article>
              <article class="mw-admin-stat mw-admin-skeleton-card"><i></i><span></span></article>
              <article class="mw-admin-stat mw-admin-skeleton-card"><i></i><span></span></article>
              <article class="mw-admin-stat mw-admin-skeleton-card"><i></i><span></span></article>
            </div>
            <div class="mw-admin-card mw-admin-skeleton-panel" role="status" aria-live="polite">
              <div>
                <strong>กำลังโหลดข้อมูล</strong>
                <p>กำลังเตรียมข้อมูลสำหรับระบบจัดการเว็บ</p>
              </div>
              <span></span><span></span><span></span>
            </div>
          </section>
        </main>
      </div>
    </div>
    <script is:inline type="module" src={`/assets/js/admin-portal.js?v=${assetVersion}`}></script>
  </body>
</html>
