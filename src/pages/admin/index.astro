---
import { brandAssets, siteConfig } from "../../config/site.js";
import { stylesForPath } from "../../config/styles.js";
import adminDesign from "../../styles/admin-design.css?url";
import adminContentLibrary from "../../styles/admin-content-library.css?url";
import commerce from "../../styles/commerce.css?url";
import adminShared from "../../styles/admin-shared.css?url";
import adminHomepage from "../../styles/admin-homepage.css?url";
import adminNavigation from "../../styles/admin-navigation.css?url";
import adminCommerce from "../../styles/admin-commerce.css?url";
import adminTemples from "../../styles/admin-temples.css?url";
import adminPlaceEditor from "../../styles/admin-place-editor.css?url";
import adminSiteContent from "../../styles/admin-site-content.css?url";
import adminMediaLibrary from "../../styles/admin-media-library.css?url";
import adminAnalytics from "../../styles/admin-analytics.css?url";
import publicSelect from "../../styles/public-select.css?url";
const config = siteConfig.th;
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ระบบจัดการเว็บ | มงคลเวลา</title>
    <meta name="robots" content="noindex,nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type={brandAssets.favicon.type} sizes={brandAssets.favicon.sizes} href={brandAssets.favicon.src} />
    <link rel="apple-touch-icon" sizes={brandAssets.appleTouchIcon.sizes} href={brandAssets.appleTouchIcon.src} />
    {stylesForPath("/admin/").map((src) => <link rel="stylesheet" href={src} />)}
    <link rel="stylesheet" href={adminDesign} />
    <link rel="stylesheet" href={adminAnalytics} />
    <link rel="stylesheet" href={adminContentLibrary} />
    <link rel="stylesheet" href={commerce} />
    <link rel="stylesheet" href={publicSelect} />
    <link rel="stylesheet" href={adminShared} />
    <link rel="stylesheet" href={adminHomepage} />
    <link rel="stylesheet" href={adminNavigation} />
    <link rel="stylesheet" href={adminCommerce} />
    <link rel="stylesheet" href={adminTemples} />
    <link rel="stylesheet" href={adminPlaceEditor} />
    <link rel="stylesheet" href={adminSiteContent} />
    <link rel="stylesheet" href={adminMediaLibrary} />
  </head>
  <body class="admin-page admin-design">
    <div
      id="adminApp"
      data-admin-app
      data-brand-name={config.brandName}
      data-brand-subtitle="ADMIN CONSOLE"
      data-brand-label={config.brandLabel}
      data-brand-mark-src={brandAssets.mark.src}
      data-brand-mark-width={brandAssets.mark.width}
      data-brand-mark-height={brandAssets.mark.height}
    >
      <main class="mw-admin-login" data-admin-auth-pending>
        <section class="mw-admin-login-card mw-admin-auth-pending" aria-labelledby="adminAuthTitle">
          <img class="mw-admin-login-mark" src={brandAssets.mark.src} width={brandAssets.mark.width} height={brandAssets.mark.height} alt="" decoding="async" />
          <h1 id="adminAuthTitle">ระบบจัดการเว็บ</h1>
          <p role="status" aria-live="polite">กำลังตรวจสอบสิทธิ์ กรุณารอสักครู่</p>
          <noscript><p>กรุณาเปิดใช้งาน JavaScript เพื่อเข้าสู่ระบบ</p></noscript>
        </section>
      </main>
    </div>
    <script>
      import "../../scripts/admin-portal.js";
    </script>
  </body>
</html>
