---
import ToolsLayout from "../../../layouts/ToolsLayout.astro";
import ToolsHero from "../../../components/ToolsHero.astro";
import TarotDraw from "../../../components/tarot/TarotDraw.astro";
import { tarotIntentTopics } from "../../../data/tarot-topic-pages.js";

export function getStaticPaths() {
  return tarotIntentTopics.map((topic) => ({
    params: { topic: topic.slug },
    props: { topic },
  }));
}

const { topic } = Astro.props;
---

<ToolsLayout
  title={topic.title}
  description={topic.description}
  lang="th"
  locale="th"
  page={topic.pageId}
  bodyClass="tarot-page"
  canonicalPath={`/tarot/${topic.slug}/`}
  breadcrumbs={[
    { label: "หน้าแรก", href: "/" },
    { label: topic.breadcrumb, href: `/tarot/${topic.slug}/` },
  ]}
>
  <main id={`${topic.slug}-tarot`}>
    <ToolsHero ornamentSrc="/assets/images/life-graph-watercolor.webp" quote="ทุกไพ่มีคำตอบ เพียงคุณเปิดใจ" title={topic.heading} kicker={topic.kicker} lead={topic.lead} breadcrumbs={[{label:"หน้าแรก",href:"/"},{label:topic.breadcrumb}]} />

    <TarotDraw spreadType={topic.spreadType} requiredCount={1} deckCount={22} storageKey={topic.storageKey}
      intentionTitle={topic.intentionTitle} intentionCopy={topic.intentionCopy} warning={topic.warning} />

    <section class="tarot-note tools-section">
      <p class="section-kicker">แนวคิดของเรา</p>
      <h2>{topic.noteTitle}</h2>
      <p>{topic.noteCopy}</p>
    </section>
  </main>

</ToolsLayout>
