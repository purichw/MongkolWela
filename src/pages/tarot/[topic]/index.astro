---
import ToolsLayout from "../../../layouts/ToolsLayout.astro";
import ToolsHero from "../../../components/ToolsHero.astro";
import TarotDraw from "../../../components/tarot/TarotDraw.astro";
import { tarotIntentTopics } from "../../../data/tarot-topic-pages.js";
import { contentBinding } from "../../../lib/content-bindings.js";

export function getStaticPaths() {
  return tarotIntentTopics.map((topic) => ({
    params: { topic: topic.slug },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const bind = (path: string) => contentBinding("tarot.tarotIntentTopics", tarotIntentTopics.findIndex(item => item.slug === topic.slug), path);
---

<ToolsLayout
  title={topic.title}
  description={topic.description}
  lang="th"
  locale="th"
  page={topic.pageId}
  bodyClass="tarot-page"
  canonicalPath={`/tarot/${topic.slug}/`}
  breadcrumbs={[
    { label: "หน้าแรก", href: "/" },
    { label: topic.breadcrumb, href: `/tarot/${topic.slug}/` },
  ]}
>
  <main id={`${topic.slug}-tarot`}>
    <ToolsHero bindings={{ title: bind("heading"), kicker: bind("kicker"), lead: bind("lead") }} ornamentSrc="/assets/images/life-graph-watercolor.webp" quote="ทุกไพ่มีคำตอบ เพียงคุณเปิดใจ" title={topic.heading} kicker={topic.kicker} lead={topic.lead} breadcrumbs={[{label:"หน้าแรก",href:"/"},{label:topic.breadcrumb}]} />

    <TarotDraw spreadType={topic.spreadType} requiredCount={1} deckCount={22} storageKey={topic.storageKey}
      intentionTitle={topic.intentionTitle} intentionCopy={topic.intentionCopy} warning={topic.warning} bindings={{ intentionTitle: bind("intentionTitle"), intentionCopy: bind("intentionCopy"), warning: bind("warning") }} />

    <section class="tarot-note tools-section">
      <p data-cms-field="8e30ba93-1" class="section-kicker">แนวคิดของเรา</p>
      <h2 data-cms-field="8e30ba93-2" {...bind("noteTitle")}>{topic.noteTitle}</h2>
      <p data-cms-field="8e30ba93-3" {...bind("noteCopy")}>{topic.noteCopy}</p>
    </section>
  </main>

</ToolsLayout>
