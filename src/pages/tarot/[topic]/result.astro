---
import ToolsLayout from "../../../layouts/ToolsLayout.astro";
import ToolsHero from "../../../components/ToolsHero.astro";
import { tarotIntentTopics } from "../../../data/tarot-topic-pages.js";

export function getStaticPaths() {
  return tarotIntentTopics.map((topic) => ({
    params: { topic: topic.slug },
    props: { topic },
  }));
}

const { topic } = Astro.props;
---

<ToolsLayout
  title={topic.resultTitle}
  description={topic.resultDescription}
  lang="th"
  locale="th"
  page={topic.pageId}
  bodyClass="tarot-page tarot-result-page"
  canonicalPath={`/tarot/${topic.slug}/result/`}
  robots="noindex, follow"
  breadcrumbs={[
    { label: "หน้าแรก", href: "/" },
    { label: topic.breadcrumb, href: `/tarot/${topic.slug}/` },
    { label: "ผลคำทำนาย", href: `/tarot/${topic.slug}/result/` },
  ]}
>
  <main>
<ToolsHero ornamentSrc="/assets/images/life-graph-watercolor.webp" title={topic.resultTitle.replace(" | มงคลเวลา","")} kicker="Tarot Reading" lead="อ่านคำทำนายเป็นแนวทางประกอบการตัดสินใจ ไม่ใช่การรับรองผลลัพธ์ล่วงหน้า" breadcrumbs={[{label:"หน้าแรก",href:"/"},{label:topic.breadcrumb,href:"/tarot/"+topic.slug+"/"},{label:"ผลคำทำนาย"}]} />
    <section
      class="tarot-result-shell"
      data-tarot-spread-result
      data-spread-type={topic.spreadType}
      data-storage-key={topic.storageKey}
    >
      <div class="tarot-result-copy">
        <p class="section-kicker">{topic.kicker}</p>
        <h2>กำลังเปิดคำทำนาย</h2>
        <p>โปรดรอสักครู่...</p>
      </div>
    </section>

    <section class="tarot-related tools-section">
      <p class="section-kicker">หลังอ่านคำทำนาย</p>
      <h2>{topic.relatedTitle}</h2>
      <p>{topic.relatedCopy}</p>
    </section>
  </main>

  <script>
    import "../../../scripts/tarot-spread-result.js";
  </script>
</ToolsLayout>
