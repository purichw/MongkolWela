---
import { contentBinding } from "../../../lib/content-bindings.js";
import { sitePlaceholderImage } from "../../../lib/image-placeholder.js";
import ToolsLayout from "../../../layouts/ToolsLayout.astro";
import ToolsHero from "../../../components/ToolsHero.astro";
import { renderIcon } from "../../../lib/ui-markup.js";
import { tarotMeaningCards, tarotMeaningGroups, getTarotMeaningGroupCards } from "../../../data/tarot-meanings.js";
import { createItemListJsonLd } from "../../../lib/seo.js";

const structuredData = createItemListJsonLd({
  name: "ความหมายไพ่ยิปซี 78 ใบ",
  description: "รวมความหมายไพ่ยิปซี Rider-Waite-Smith ทั้ง 78 ใบ แบ่ง Major Arcana และ Minor Arcana",
  url: "https://mongkolwela.vercel.app/tarot/meanings/",
  items: tarotMeaningCards.map((card) => ({
    name: `${card.thName} (${card.name})`,
    url: `/tarot/meanings/${card.slug}/`,
  })),
});
const groups = tarotMeaningGroups.map(group => ({ ...group,
  label: group.id === "major" ? "ไพ่ชุดใหญ่ (Major Arcana)" : `${group.thTitle} (${group.title})`,
  cards: getTarotMeaningGroupCards(group.id),
}));
---

<ToolsLayout
  title="ความหมายไพ่ยิปซี 78 ใบ | มงคลเวลา"
  description="รวมความหมายไพ่ยิปซีทั้ง 78 ใบแบบไทย อ่านง่าย พร้อมภาพไพ่ Rider-Waite-Smith ต้นฉบับ ชื่อไพ่ Major Arcana และ Minor Arcana ครบทุกใบ"
  lang="th"
  locale="th"
  page="tarotMeanings"
  bodyClass="tarot-page tarot-library-page"
  canonicalPath="/tarot/meanings/"
  image="/assets/images/tarot/rws-jpg/the-world.jpg"
  imageAlt="ความหมายไพ่ยิปซี 78 ใบ"
  breadcrumbs={[
    { label: "หน้าแรก", href: "/" },
    { label: "ความหมายไพ่ยิปซี 78 ใบ", href: "/tarot/meanings/" },
  ]}
  structuredData={structuredData}
>
  <main id="tarot-meanings">
    <ToolsHero title="ความหมายไพ่ยิปซี 78 ใบ" kicker="Tarot Card Meanings"
      lead="สำรวจความหมายไพ่ Rider-Waite-Smith พร้อมภาพและคำตีความครบทั้ง 78 ใบ สำหรับการศึกษาและเป็นแนวทางในการใช้ไพ่"
      quote="ไพ่ทุกใบสะท้อนเรื่องราวในชีวิต ให้เราเข้าใจตัวเองมากขึ้น"
      breadcrumbs={[{label:"หน้าแรก",href:"/"},{label:"ไพ่ยิปซี",href:"/tarot/daily/"},{label:"ความหมายไพ่ยิปซี 78 ใบ"}]} />
    <div class="tarot-library" data-tarot-library>
      <aside class="tarot-library-sidebar" aria-label="ค้นหาและเลือกหมวดไพ่">
        <nav class="tarot-category-nav" aria-label="หมวดไพ่">
          <h2 data-cms-field="0c6c2b61-1">เลือกหมวดไพ่</h2>
          <a href="#tarot-meanings" data-meaning-category="all" aria-current="true"><span data-cms-field="0c6c2b61-2">ทั้งหมด</span><span data-cms-field="0c6c2b61-3">78 ใบ</span></a>
          {groups.map(group => <a href={`#${group.id}`} data-meaning-category={group.id}><span data-cms-field="0c6c2b61-4">{group.label}</span><span data-cms-field="0c6c2b61-5">{group.cards.length}</span></a>)}
        </nav>
        <div class="tarot-category-mobile" hidden data-library-enhancement>
          <label data-cms-field="0c6c2b61-6" for="tarot-category">เลือกหมวดไพ่</label>
          <select id="tarot-category" data-native-select>
            <option data-cms-field="0c6c2b61-7" value="all">ทั้งหมด 78 ใบ</option>
            {groups.map(group => <option data-cms-field="0c6c2b61-8" value={group.id}>{group.label} · {group.cards.length} ใบ</option>)}
          </select>
        </div>
        <form class="tarot-library-search" role="search" hidden data-library-enhancement>
          <label data-cms-field="0c6c2b61-9" for="tarot-card-search">ค้นหาไพ่</label>
          <div><input data-cms-field="0c6c2b61-10" type="search" id="tarot-card-search" placeholder="ค้นหาชื่อไพ่ หรือคำสำคัญ..." autocomplete="off" />
            <button type="submit" aria-label="ค้นหาไพ่"><Fragment set:html={renderIcon("search")} /></button></div>
        </form>
      </aside>
      <div class="tarot-library-results">
        <div class="tarot-library-toolbar" hidden data-library-enhancement>
          <p data-cms-field="0c6c2b61-11" role="status" aria-live="polite" data-library-status>ทั้งหมด 78 ใบ</p>
          <button type="button" data-library-expand><span data-cms-field="0c6c2b61-12">ขยายทั้งหมด</span><Fragment set:html={renderIcon("chevron-down")} /></button>
        </div>
        {groups.map(group => <details class="tarot-library-group" id={group.id} data-meaning-group open={group.id === "major"}>
          <summary><h2 data-cms-field="0c6c2b61-13">{group.label}</h2><span data-cms-field="0c6c2b61-14" class="tarot-group-count">{group.cards.length} ใบ</span><Fragment set:html={renderIcon("chevron-down")} /></summary>
          <p data-cms-field="0c6c2b61-15" class="tarot-group-intro">{group.copy}</p>
          <div class="tarot-meaning-grid">
            {group.cards.map((card, index) => <a class="tarot-meaning-card" href={`/tarot/meanings/${card.slug}/`}
              data-meaning-search={[card.thName,card.name,...card.keywords,card.theme].join(" ")}>
              <span class="tarot-meaning-image"><img data-cms-field="0c6c2b61-16" {...contentBinding("tarot.tarotMeaningCards", card.slug, "thumbImage", { attr: "src" })} src={card.thumbImage || sitePlaceholderImage} data-fallback-src={sitePlaceholderImage} alt={`${card.thName} ${card.name}`} width="170" height="280"
                loading={group.id === "major" && index < 6 ? "eager" : "lazy"} decoding="async" /></span>
              <strong data-cms-field="0c6c2b61-17" {...contentBinding("tarot.tarotMeaningCards", card.slug, "name")}>{card.name}</strong><span data-cms-field="0c6c2b61-18" {...contentBinding("tarot.tarotMeaningCards", card.slug, "thName", { prefix: "number" in card && card.number != null ? `${card.number} ` : "" })}>{"number" in card && card.number != null ? `${card.number} ` : ""}{card.thName}</span>
            </a>)}
          </div>
        </details>)}
        <div class="tarot-library-empty" data-library-empty hidden>
          <Fragment set:html={renderIcon("search")} /><h2 data-cms-field="0c6c2b61-19">ไม่พบไพ่ที่ตรงกับคำค้น</h2><p data-cms-field="0c6c2b61-20">ลองชื่อไพ่หรือคำสำคัญอื่น หรือกลับไปดูไพ่ทั้งหมด</p>
          <button data-cms-field="0c6c2b61-21" type="button" class="secondary-action" data-library-reset>ดูไพ่ทั้งหมด 78 ใบ</button>
        </div>
        <details class="tarot-library-guide"><summary data-cms-field="0c6c2b61-22">แนวทางอ่านความหมายไพ่<Fragment set:html={renderIcon("chevron-down")} /></summary>
          <ol><li data-cms-field="0c6c2b61-23">เริ่มจากภาพหน้าไพ่ก่อนจำคำแปล</li><li data-cms-field="0c6c2b61-24">อ่านความหมายตรงและกลับหัวเป็นคู่กัน</li><li data-cms-field="0c6c2b61-25">ดูบริบทคำถามก่อนสรุปผล</li><li data-cms-field="0c6c2b61-26">ใช้คำทำนายเป็นแนวทาง ไม่ใช่คำสั่งตายตัว</li></ol>
        </details>
      </div>
    </div>
  </main>
  <script>import "../../../scripts/tarot-library.js";</script>
</ToolsLayout>
