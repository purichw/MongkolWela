---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { tarotMeaningCards, tarotMeaningGroups } from "../../../data/tarot-meanings.js";

export function getStaticPaths() {
  return tarotMeaningCards.map((card) => ({
    params: { card: card.slug },
    props: { card },
  }));
}

const { card } = Astro.props;
const currentIndex = tarotMeaningCards.findIndex((item) => item.slug === card.slug);
const previousCard = tarotMeaningCards[(currentIndex - 1 + tarotMeaningCards.length) % tarotMeaningCards.length];
const nextCard = tarotMeaningCards[(currentIndex + 1) % tarotMeaningCards.length];
const group = tarotMeaningGroups.find((item) => item.id === card.group);
const relatedCards = (card.relatedCards || []).map((relatedCard) => {
  const related = tarotMeaningCards.find((item) => item.slug === relatedCard.card_id);
  return {
    ...relatedCard,
    label: related ? `${related.thName} (${related.name})` : relatedCard.card_id,
    href: related ? `/tarot/meanings/${related.slug}/` : "",
  };
});
---

<BaseLayout
  title={`${card.thName} ${card.name} ความหมายไพ่ยิปซี | มงคลเวลา`}
  description={`ความหมายไพ่ยิปซี ${card.thName} (${card.name}) แบบไทย พร้อมความหมายตรง กลับหัว ความรัก งานเงิน และมุม Western สำหรับอ่านไพ่ให้เข้าใจง่าย`}
  lang="th"
  locale="th"
  page="tarotMeanings"
  bodyClass="tarot-page"
  canonicalPath={`/tarot/meanings/${card.slug}/`}
  image={card.image}
  imageAlt={`${card.thName} ${card.name}`}
  breadcrumbs={[
    { label: "หน้าแรก", href: "/" },
    { label: "ความหมายไพ่ยิปซี 78 ใบ", href: "/tarot/meanings/" },
    { label: card.thName, href: `/tarot/meanings/${card.slug}/` },
  ]}
>
  <main>
    <section class="tarot-meaning-detail">
      <div class="tarot-meaning-card-large">
        <img src={card.image} alt={`${card.thName} ${card.name}`} loading="eager" decoding="async" fetchpriority="high" />
        <strong>{card.name}</strong>
        <span>{card.thName}</span>
      </div>

      <article class="tarot-meaning-copy">
        <nav class="tarot-breadcrumb" aria-label="breadcrumb">
          <a href="../../../">หน้าแรก</a>
          <span>/</span>
          <a href="../">ความหมายไพ่ยิปซี</a>
          <span>/</span>
          <span>{card.thName}</span>
        </nav>
        <p class="section-kicker">{group?.title || "Tarot Meaning"}</p>
        <h1>{card.thName}</h1>
        <p class="tarot-result-name">{card.name}</p>
        <p class="tarot-meaning-lead">{card.overview}</p>

        <div class="tarot-meaning-tags">
          {card.keywords.map((keyword) => <span>{keyword}</span>)}
        </div>

        <dl class="tarot-reading-list">
          <div>
            <dt>ความหมายโดยรวม</dt>
            <dd>{card.upright}</dd>
          </div>
          <div>
            <dt>เมื่อไพ่กลับหัว</dt>
            <dd>{card.reversed}</dd>
          </div>
          <div>
            <dt>ความรักและความสัมพันธ์</dt>
            <dd>{card.love}</dd>
          </div>
          <div>
            <dt>การงาน การเงิน และชีวิตประจำวัน</dt>
            <dd>{card.workMoney}</dd>
          </div>
          {card.health && (
            <div>
              <dt>สุขภาพและพลังชีวิต</dt>
              <dd>{card.health}</dd>
            </div>
          )}
          <div>
            <dt>มุม Western ที่เสริมการอ่าน</dt>
            <dd>{card.western}</dd>
          </div>
        </dl>

        {(card.keywordsReversed?.length > 0 || card.symbolism?.length > 0 || card.closingSummary) && (
          <dl class="tarot-reading-list compact">
            {card.keywordsReversed?.length > 0 && (
              <div>
                <dt>คำสำคัญเมื่อกลับหัว</dt>
                <dd>{card.keywordsReversed.join(" · ")}</dd>
              </div>
            )}
            {card.symbolism?.length > 0 && (
              <div>
                <dt>สัญลักษณ์บนหน้าไพ่</dt>
                <dd>
                  <ul>
                    {card.symbolism.map((item) => (
                      <li>
                        <strong>{item.symbol}</strong>: {item.meaning}
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            )}
            {card.closingSummary && (
              <div>
                <dt>สรุปใจความ</dt>
                <dd>{card.closingSummary}</dd>
              </div>
            )}
          </dl>
        )}

        {(relatedCards.length > 0 || card.reflectionQuestions?.length > 0) && (
          <dl class="tarot-reading-list compact">
            {relatedCards.length > 0 && (
              <div>
                <dt>ไพ่ที่สัมพันธ์กัน</dt>
                <dd>
                  <ul>
                    {relatedCards.map((item) => (
                      <li>
                        {item.href ? <a href={item.href}>{item.label}</a> : <strong>{item.label}</strong>}:{" "}
                        {item.relationship}
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            )}
            {card.reflectionQuestions?.length > 0 && (
              <div>
                <dt>คำถามทบทวนตัวเอง</dt>
                <dd>
                  <ul>
                    {card.reflectionQuestions.map((question) => <li>{question}</li>)}
                  </ul>
                </dd>
              </div>
            )}
          </dl>
        )}

        <div class="tarot-result-actions">
          <a class="secondary-action" href={`/tarot/meanings/${previousCard.slug}/`}>ไพ่ก่อนหน้า</a>
          <a class="primary-action" href="/tarot/meanings/">กลับไปรายการ 78 ใบ</a>
          <a class="secondary-action" href={`/tarot/meanings/${nextCard.slug}/`}>ไพ่ถัดไป</a>
        </div>
      </article>
    </section>
  </main>
</BaseLayout>
