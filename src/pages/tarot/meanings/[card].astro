---
import ToolsLayout from "../../../layouts/ToolsLayout.astro";
import { renderIcon } from "../../../lib/ui-markup.js";
import { getTarotCardById } from "../../../scripts/tarot-data.js";
import { tarotMeaningCards, tarotMeaningGroups } from "../../../data/tarot-meanings.js";

export function getStaticPaths() {
  return tarotMeaningCards.map((card) => ({
    params: { card: card.slug },
    props: { card },
  }));
}

const { card } = Astro.props;
const currentIndex = tarotMeaningCards.findIndex((item) => item.slug === card.slug);
const previousCard = tarotMeaningCards[(currentIndex - 1 + tarotMeaningCards.length) % tarotMeaningCards.length];
const nextCard = tarotMeaningCards[(currentIndex + 1) % tarotMeaningCards.length];
const group = tarotMeaningGroups.find((item) => item.id === card.group);
const relatedCards = (card.relatedCards || []).map((relatedCard) => {
  const related = tarotMeaningCards.find((item) => item.slug === relatedCard.card_id);
  return {
    ...relatedCard,
    label: related ? `${related.thName} (${related.name})` : relatedCard.card_id,
    href: related ? `/tarot/meanings/${related.slug}/` : "",
  };
});
const groupLabel = group?.id === "major" ? "ไพ่ชุดใหญ่ (Major Arcana)" : `${group?.thTitle} (${group?.title})`;
const advice = "advice" in card ? card.advice : getTarotCardById(card.slug)?.advice;
const caution = "caution" in card ? card.caution : "";
const number = "number" in card ? card.number : null;
const astrology = "astrology" in card ? card.astrology || card.rulingPlanet : "";
const keywords = "keywordsUpright" in card ? card.keywordsUpright : card.keywords;
const uprightDetails = "uprightDetails" in card ? card.uprightDetails : null;
const topics = [
  ...(uprightDetails?.career || uprightDetails?.finance ? [
    { label: "การงาน", text: uprightDetails.career },
    { label: "การเงิน", text: uprightDetails.finance },
  ] : [{ label: "การงานและการเงิน", text: card.workMoney }]),
  { label: "ความรัก", text: card.love },
  { label: "สุขภาพและพลังชีวิต", text: card.health },
].filter(topic => topic.text);
---

<ToolsLayout
  title={`${card.thName} ${card.name} ความหมายไพ่ยิปซี | มงคลเวลา`}
  description={`ความหมายไพ่ยิปซี ${card.thName} (${card.name}) แบบไทย พร้อมความหมายตรง กลับหัว ความรัก งานเงิน และมุม Western สำหรับอ่านไพ่ให้เข้าใจง่าย`}
  lang="th"
  locale="th"
  page="tarotMeanings"
  bodyClass="tarot-page tarot-card-detail-page"
  canonicalPath={`/tarot/meanings/${card.slug}/`}
  image={card.image}
  imageAlt={`${card.thName} ${card.name}`}
  breadcrumbs={[
    { label: "หน้าแรก", href: "/" },
    { label: "ความหมายไพ่ยิปซี 78 ใบ", href: "/tarot/meanings/" },
    { label: card.thName, href: `/tarot/meanings/${card.slug}/` },
  ]}
>
  <main data-meaning-detail>
    <div class="tarot-detail-navigation">
      <nav class="tools-breadcrumb" aria-label="เส้นทางนำทาง">
        <a href="/">หน้าแรก</a><span aria-hidden="true">/</span><a href="/tarot/daily/">ไพ่ยิปซี</a><span aria-hidden="true">/</span>
        <a href="/tarot/meanings/" data-meaning-context-link>ความหมายไพ่</a><span aria-hidden="true">/</span><span aria-current="page">{card.name}</span>
      </nav>
      <nav class="tarot-card-pagination" aria-label="เลือกไพ่ใบอื่น">
        <a href={`/tarot/meanings/${previousCard.slug}/`} data-meaning-context-link rel="prev"><Fragment set:html={renderIcon("arrow-left")} />ไพ่ก่อนหน้า</a>
        <a href={`/tarot/meanings/${nextCard.slug}/`} data-meaning-context-link rel="next">ไพ่ถัดไป<Fragment set:html={renderIcon("arrow-right")} /></a>
      </nav>
    </div>
    <section class="tarot-meaning-detail" aria-labelledby="tarot-card-title">
      <figure class="tarot-meaning-card-large">
        <div class="tarot-detail-image"><img src={card.image} alt={`${card.thName} ${card.name}`} width="340" height="560" loading="eager" decoding="async" fetchpriority="high" /></div>
        <figcaption><h1 id="tarot-card-title">{card.name}</h1><p>{number != null ? `${number} ` : ""}{card.thName}</p></figcaption>
      </figure>
      <article class="tarot-meaning-copy">
        <dl class="tarot-card-facts">
          <div><dt>หมวดไพ่</dt><dd><a href={`/tarot/meanings/?group=${card.group}`}>{groupLabel}</a></dd></div>
          {card.element && <div><dt>ธาตุ</dt><dd>{card.element}</dd></div>}
          {astrology && <div><dt>ดาวเคราะห์ / ราศี</dt><dd>{astrology}</dd></div>}
          <div><dt>คีย์เวิร์ด</dt><dd>{keywords.join(" · ")}</dd></div>
        </dl>
        <section class="tarot-card-prose"><h2>ความหมายโดยรวม</h2><p>{card.upright}</p></section>
        {advice && <section class="tarot-card-prose"><h2>คำแนะนำ</h2><p>{advice}</p></section>}
        <section class="tarot-card-topics" aria-labelledby="tarot-topics-title">
          <h2 id="tarot-topics-title">ในด้านต่าง ๆ</h2>
          <div class="tarot-detail-disclosures">{topics.map(topic => <details><summary>{topic.label}<Fragment set:html={renderIcon("chevron-down")} /></summary><p>{topic.text}</p></details>)}</div>
        </section>
        <details class="tarot-detail-more">
          <summary>เมื่อไพ่กลับหัว และความหมายเพิ่มเติม<Fragment set:html={renderIcon("chevron-down")} /></summary>
          <div class="tarot-detail-expanded">
            <section><h2>เรื่องราวของไพ่</h2><p>{card.overview}</p></section>
            <section><h2>เมื่อไพ่กลับหัว</h2><p>{card.reversed}</p>
              {card.keywordsReversed?.length > 0 && <p><strong>คำสำคัญเมื่อกลับหัว: </strong>{card.keywordsReversed.join(" · ")}</p>}
            </section>
            <section><h2>มุม Western ที่เสริมการอ่าน</h2><p>{card.western}</p></section>
            {caution && <section><h2>ข้อควรระวัง</h2><p>{caution}</p></section>}
            {card.symbolism?.length > 0 && <section><h2>สัญลักษณ์บนหน้าไพ่</h2><ul>{card.symbolism.map(item => <li><strong>{item.symbol}</strong>: {item.meaning}</li>)}</ul></section>}
            {card.closingSummary && <section><h2>สรุปใจความ</h2><p>{card.closingSummary}</p></section>}
            {relatedCards.length > 0 && <section><h2>ไพ่ที่สัมพันธ์กัน</h2><ul>{relatedCards.map(item => <li>{item.href ? <a href={item.href}>{item.label}</a> : <strong>{item.label}</strong>}: {item.relationship}</li>)}</ul></section>}
            {card.reflectionQuestions?.length > 0 && <section><h2>คำถามทบทวนตัวเอง</h2><ul>{card.reflectionQuestions.map(question => <li>{question}</li>)}</ul></section>}
          </div>
        </details>
        <div class="tarot-detail-actions">
          <a class="primary-action" href="/tarot/meanings/" data-meaning-context-link><Fragment set:html={renderIcon("arrow-left")} />กลับไปหน้ารายการ</a>
          <a class="secondary-action" href={`/tarot/meanings/${nextCard.slug}/`} data-meaning-context-link>ไพ่ถัดไป<Fragment set:html={renderIcon("arrow-right")} /></a>
        </div>
      </article>
    </section>
  </main>
  <script>import "../../../scripts/tarot-library.js";</script>
</ToolsLayout>
