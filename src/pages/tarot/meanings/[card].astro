---
import { contentBinding } from "../../../lib/content-bindings.js";
import { sitePlaceholderImage } from "../../../lib/image-placeholder.js";
import ToolsLayout from "../../../layouts/ToolsLayout.astro";
import { renderIcon } from "../../../lib/ui-markup.js";
import { getTarotCardById } from "../../../scripts/tarot-data.js";
import { tarotMeaningCards, tarotMeaningGroups } from "../../../data/tarot-meanings.js";

export function getStaticPaths() {
  return tarotMeaningCards.map((card) => ({
    params: { card: card.slug },
    props: { card },
  }));
}

const { card } = Astro.props as { card: (typeof tarotMeaningCards)[number] };
const currentIndex = tarotMeaningCards.findIndex((item) => item.slug === card.slug);
const previousCard = tarotMeaningCards[(currentIndex - 1 + tarotMeaningCards.length) % tarotMeaningCards.length];
const nextCard = tarotMeaningCards[(currentIndex + 1) % tarotMeaningCards.length];
const group = tarotMeaningGroups.find((item) => item.id === card.group);
const relatedCards = (card.relatedCards || []).map((relatedCard) => {
  const related = tarotMeaningCards.find((item) => item.slug === relatedCard.card_id);
  return {
    ...relatedCard,
    label: related ? `${related.thName} (${related.name})` : relatedCard.card_id,
    href: related ? `/tarot/meanings/${related.slug}/` : "",
  };
});
const groupLabel = group?.id === "major" ? "ไพ่ชุดใหญ่ (Major Arcana)" : `${group?.thTitle} (${group?.title})`;
const advice = "advice" in card ? card.advice : getTarotCardById(card.slug)?.advice;
const caution = "caution" in card ? card.caution : "";
const number = "number" in card ? card.number : null;
const astrology = "astrology" in card ? card.astrology || card.rulingPlanet : "";
const keywords = "keywordsUpright" in card ? card.keywordsUpright : card.keywords;
const uprightDetails = "uprightDetails" in card ? card.uprightDetails : null;
const topics = [
  ...(uprightDetails?.career || uprightDetails?.finance ? [
    { path: "uprightDetails/career", label: "การงาน", text: uprightDetails.career },
    { path: "uprightDetails/finance", label: "การเงิน", text: uprightDetails.finance },
  ] : [{ path: "workMoney", label: "การงานและการเงิน", text: card.workMoney }]),
  { path: "love", label: "ความรัก", text: card.love },
  { path: "health", label: "สุขภาพและพลังชีวิต", text: card.health },
].filter(topic => topic.text);
---

<ToolsLayout
  title={`${card.thName} ${card.name} ความหมายไพ่ยิปซี | มงคลเวลา`}
  description={`ความหมายไพ่ยิปซี ${card.thName} (${card.name}) แบบไทย พร้อมความหมายตรง กลับหัว ความรัก งานเงิน และมุม Western สำหรับอ่านไพ่ให้เข้าใจง่าย`}
  lang="th"
  locale="th"
  page="tarotMeanings"
  bodyClass="tarot-page tarot-card-detail-page"
  canonicalPath={`/tarot/meanings/${card.slug}/`}
  image={card.image}
  imageAlt={`${card.thName} ${card.name}`}
  breadcrumbs={[
    { label: "หน้าแรก", href: "/" },
    { label: "ความหมายไพ่ยิปซี 78 ใบ", href: "/tarot/meanings/" },
    { label: card.thName, href: `/tarot/meanings/${card.slug}/` },
  ]}
>
  <main data-meaning-detail>
    <div class="tarot-detail-navigation">
      <nav class="tools-breadcrumb" aria-label="เส้นทางนำทาง">
        <a data-cms-field="55ff47f2-1" href="/">หน้าแรก</a><span aria-hidden="true">/</span><a data-cms-field="55ff47f2-2" href="/tarot/daily/">ไพ่ยิปซี</a><span aria-hidden="true">/</span>
        <a data-cms-field="55ff47f2-3" href="/tarot/meanings/" data-meaning-context-link>ความหมายไพ่</a><span aria-hidden="true">/</span><span data-cms-field="55ff47f2-4" {...contentBinding("tarot.tarotMeaningCards", card.slug, "name")} aria-current="page">{card.name}</span>
      </nav>
      <nav class="tarot-card-pagination" aria-label="เลือกไพ่ใบอื่น">
        <a data-cms-field="55ff47f2-5" href={`/tarot/meanings/${previousCard.slug}/`} data-meaning-context-link rel="prev"><Fragment set:html={renderIcon("arrow-left")} />ไพ่ก่อนหน้า</a>
        <a data-cms-field="55ff47f2-6" href={`/tarot/meanings/${nextCard.slug}/`} data-meaning-context-link rel="next">ไพ่ถัดไป<Fragment set:html={renderIcon("arrow-right")} /></a>
      </nav>
    </div>
    <section class="tarot-meaning-detail" aria-labelledby="tarot-card-title">
      <figure class="tarot-meaning-card-large">
        <div class="tarot-detail-image"><img data-cms-field="55ff47f2-7" {...contentBinding("tarot.tarotMeaningCards", card.slug, "image", { attr: "src" })} src={card.image || sitePlaceholderImage} data-fallback-src={sitePlaceholderImage} alt={`${card.thName} ${card.name}`} width="340" height="560" loading="eager" decoding="async" fetchpriority="high" /></div>
        <figcaption><h1 data-cms-field="55ff47f2-8" {...contentBinding("tarot.tarotMeaningCards", card.slug, "name")} id="tarot-card-title">{card.name}</h1><p data-cms-field="55ff47f2-9" {...contentBinding("tarot.tarotMeaningCards", card.slug, "thName", { prefix: number != null ? `${number} ` : "" })}>{number != null ? `${number} ` : ""}{card.thName}</p></figcaption>
      </figure>
      <article class="tarot-meaning-copy">
        <dl class="tarot-card-facts">
          <div><dt data-cms-field="55ff47f2-10">หมวดไพ่</dt><dd><a data-cms-field="55ff47f2-11" href={`/tarot/meanings/?group=${card.group}`}>{groupLabel}</a></dd></div>
          {card.element && <div><dt data-cms-field="55ff47f2-12">ธาตุ</dt><dd data-cms-field="55ff47f2-13">{card.element}</dd></div>}
          {astrology && <div><dt data-cms-field="55ff47f2-14">ดาวเคราะห์ / ราศี</dt><dd data-cms-field="55ff47f2-15" {...contentBinding("tarot.tarotMeaningCards", card.slug, "astrology" in card && card.astrology ? "astrology" : "rulingPlanet")}>{astrology}</dd></div>}
          <div><dt data-cms-field="55ff47f2-16">คีย์เวิร์ด</dt><dd data-cms-field="55ff47f2-17" {...contentBinding("tarot.tarotMeaningCards", card.slug, "keywordsUpright" in card ? "keywordsUpright" : "keywords", { join: " · ", seed: keywords })}>{keywords.join(" · ")}</dd></div>
        </dl>
        <section class="tarot-card-prose"><h2 data-cms-field="55ff47f2-18">ความหมายโดยรวม</h2><p data-cms-field="55ff47f2-19" {...contentBinding("tarot.tarotMeaningCards", card.slug, "upright")}>{card.upright}</p></section>
        {advice && <section class="tarot-card-prose"><h2 data-cms-field="55ff47f2-20">คำแนะนำ</h2><p data-cms-field="55ff47f2-21">{advice}</p></section>}
        <section class="tarot-card-topics" aria-labelledby="tarot-topics-title">
          <h2 data-cms-field="55ff47f2-22" id="tarot-topics-title">ในด้านต่าง ๆ</h2>
          <div class="tarot-detail-disclosures">{topics.map(topic => <details><summary data-cms-field="55ff47f2-23">{topic.label}<Fragment set:html={renderIcon("chevron-down")} /></summary><p data-cms-field="55ff47f2-24" {...contentBinding("tarot.tarotMeaningCards", card.slug, topic.path)}>{topic.text}</p></details>)}</div>
        </section>
        <details class="tarot-detail-more">
          <summary data-cms-field="55ff47f2-25">เมื่อไพ่กลับหัว และความหมายเพิ่มเติม<Fragment set:html={renderIcon("chevron-down")} /></summary>
          <div class="tarot-detail-expanded">
            <section><h2 data-cms-field="55ff47f2-26">เรื่องราวของไพ่</h2><p data-cms-field="55ff47f2-27" {...contentBinding("tarot.tarotMeaningCards", card.slug, "overview")}>{card.overview}</p></section>
            <section><h2 data-cms-field="55ff47f2-28">เมื่อไพ่กลับหัว</h2><p data-cms-field="55ff47f2-29" {...contentBinding("tarot.tarotMeaningCards", card.slug, "reversed")}>{card.reversed}</p>
              {card.keywordsReversed?.length > 0 && <p data-cms-field="55ff47f2-30"><strong data-cms-field="55ff47f2-31">คำสำคัญเมื่อกลับหัว: </strong><span {...contentBinding("tarot.tarotMeaningCards", card.slug, "keywordsReversed", { join: " · ", seed: card.keywordsReversed })}>{card.keywordsReversed.join(" · ")}</span></p>}
            </section>
            <section><h2 data-cms-field="55ff47f2-32">มุม Western ที่เสริมการอ่าน</h2><p data-cms-field="55ff47f2-33" {...contentBinding("tarot.tarotMeaningCards", card.slug, "western")}>{card.western}</p></section>
            {caution && <section><h2 data-cms-field="55ff47f2-34">ข้อควรระวัง</h2><p data-cms-field="55ff47f2-35" {...contentBinding("tarot.tarotMeaningCards", card.slug, "caution")}>{caution}</p></section>}
            {card.symbolism?.length > 0 && <section><h2 data-cms-field="55ff47f2-36">สัญลักษณ์บนหน้าไพ่</h2><ul>{card.symbolism.map((item, i) => <li data-cms-field="55ff47f2-37"><strong data-cms-field="55ff47f2-38" {...contentBinding("tarot.tarotMeaningCards", card.slug, `symbolism/${i}/symbol`)}>{item.symbol}</strong>: <span {...contentBinding("tarot.tarotMeaningCards", card.slug, `symbolism/${i}/meaning`)}>{item.meaning}</span></li>)}</ul></section>}
            {card.closingSummary && <section><h2 data-cms-field="55ff47f2-39">สรุปใจความ</h2><p data-cms-field="55ff47f2-40" {...contentBinding("tarot.tarotMeaningCards", card.slug, "closingSummary")}>{card.closingSummary}</p></section>}
            {relatedCards.length > 0 && <section><h2 data-cms-field="55ff47f2-41">ไพ่ที่สัมพันธ์กัน</h2><ul>{relatedCards.map((item, i) => <li data-cms-field="55ff47f2-42">{item.href ? <a data-cms-field="55ff47f2-43" href={item.href}>{item.label}</a> : <strong data-cms-field="55ff47f2-44">{item.label}</strong>}: <span {...contentBinding("tarot.tarotMeaningCards", card.slug, `relatedCards/${i}/relationship`)}>{item.relationship}</span></li>)}</ul></section>}
            {card.reflectionQuestions?.length > 0 && <section><h2 data-cms-field="55ff47f2-45">คำถามทบทวนตัวเอง</h2><ul>{card.reflectionQuestions.map((question, i) => <li data-cms-field="55ff47f2-46" {...contentBinding("tarot.tarotMeaningCards", card.slug, `reflectionQuestions/${i}`)}>{question}</li>)}</ul></section>}
          </div>
        </details>
        <div class="tarot-detail-actions">
          <a data-cms-field="55ff47f2-47" class="primary-action" href="/tarot/meanings/" data-meaning-context-link><Fragment set:html={renderIcon("arrow-left")} />กลับไปหน้ารายการ</a>
          <a data-cms-field="55ff47f2-48" class="secondary-action" href={`/tarot/meanings/${nextCard.slug}/`} data-meaning-context-link>ไพ่ถัดไป<Fragment set:html={renderIcon("arrow-right")} /></a>
        </div>
      </article>
    </section>
  </main>
  <script>import "../../../scripts/tarot-library.js";</script>
</ToolsLayout>
