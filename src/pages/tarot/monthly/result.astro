---
import ToolsLayout from "../../../layouts/ToolsLayout.astro";
import ToolsHero from "../../../components/ToolsHero.astro";
---

<ToolsLayout
  title="ผลคำทำนายไพ่ยิปซีรายเดือน | มงคลเวลา"
  description="ผลคำทำนายไพ่ยิปซีรายเดือนแบบ 10 ใบ พร้อมตำแหน่ง ความหมาย คำแนะนำ และบทสรุปของเดือน"
  lang="th"
  locale="th"
  page="tarotMonthly"
  bodyClass="tarot-page tarot-result-page"
  canonicalPath="/tarot/monthly/result/"
  robots="noindex, follow"
>
  <main>
<ToolsHero ornamentSrc="/assets/images/life-graph-watercolor.webp" title="คำทำนายไพ่ยิปซีรายเดือน" kicker="Tarot Reading" lead="อ่านคำทำนายเป็นแนวทางประกอบการตัดสินใจ ไม่ใช่การรับรองผลลัพธ์ล่วงหน้า" breadcrumbs={[{label:"หน้าแรก",href:"/"},{label:"ไพ่ยิปซีรายเดือน",href:"/tarot/monthly/"},{label:"ผลคำทำนาย"}]} />
    <section
      class="tarot-result-shell tarot-spread-result"
      data-tarot-spread-result
      data-spread-type="monthly"
      data-storage-key="monkolMonthlyTarot"
    >
      <div class="tarot-result-copy">
        <p class="section-kicker">Monthly Tarot</p>
        <h2>กำลังเปิดคำทำนาย</h2>
        <p>โปรดรอสักครู่...</p>
      </div>
    </section>

    <section class="tarot-related tools-section">
      <p class="section-kicker">หลังอ่านคำทำนาย</p>
      <h2>เลือกหนึ่งเรื่องที่ทำได้จริงในเดือนนี้</h2>
      <p>
        คำทำนายรายเดือนจะมีพลังที่สุดเมื่อใช้วางแผนทีละก้าว
        หยิบคำเตือนที่สำคัญที่สุดหนึ่งข้อ แล้วเปลี่ยนเป็นการลงมือที่ชัดเจน
      </p>
    </section>
  </main>

  <script>
    import "../../../scripts/tarot-spread-result.js";
  </script>
</ToolsLayout>
