---
import ToolsLayout from "../../../layouts/ToolsLayout.astro";
import ToolsHero from "../../../components/ToolsHero.astro";
import TarotDraw from "../../../components/tarot/TarotDraw.astro";
---

<ToolsLayout
  title="อ่านไพ่ยิปซีรายเดือน | มงคลเวลา"
  description="อ่านไพ่ยิปซีรายเดือนแบบ Celtic Cross เลือกไพ่ 10 ใบเพื่ออ่านภาพรวมเดือน ความท้าทาย โอกาส และบทสรุปของเดือน"
  lang="th"
  locale="th"
  page="tarotMonthly"
  bodyClass="tarot-page"
>
  <main id="monthly-tarot">
    <ToolsHero ornamentSrc="/assets/images/life-graph-watercolor.webp" quote="ทุกไพ่มีคำตอบ เพียงคุณเปิดใจ" title="อ่านไพ่ยิปซีรายเดือน" kicker="Monthly Tarot" lead="เลือกไพ่ 10 ใบเพื่ออ่านภาพรวมเดือนแบบ Celtic Cross ทั้งสิ่งท้าทาย โอกาส และแนวทางที่ควรใส่ใจ" breadcrumbs={[{label:"หน้าแรก",href:"/"},{label:"ไพ่ยิปซีรายเดือน"}]} />

    <TarotDraw spreadType="monthly" requiredCount={10} deckCount={78} storageKey="monkolMonthlyTarot"
      intentionCopy="การอ่านรายเดือนเหมาะกับการมองภาพรวม ให้รับคำทำนายเป็นแผนที่สำหรับทบทวนและจัดลำดับชีวิตในเดือนนี้"
      warning="เลือกให้ครบ 10 ใบตามลำดับที่ใจสะดุด ไม่ใช้ไพ่ตัดสินเรื่องเร่งด่วนเพียงอย่างเดียว" />

    <section class="tarot-note tools-section">
      <p data-cms-field="07cad1f1-1" class="section-kicker">แนวคิดของเรา</p>
      <h2 data-cms-field="07cad1f1-2">อ่านเดือนทั้งเดือนด้วยสติ ไม่ใช่เร่งคำตอบให้ชีวิต</h2>
      <p data-cms-field="07cad1f1-3">
        ไพ่รายเดือนช่วยชี้ประเด็นที่ควรสังเกตและเตรียมใจ
        ผลลัพธ์ที่ดีเกิดจากการนำคำแนะนำไปใช้ร่วมกับข้อมูลจริงและการตัดสินใจของตัวเราเอง
      </p>
    </section>
  </main>

</ToolsLayout>
