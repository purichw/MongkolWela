---
import ToolsLayout from "../../../layouts/ToolsLayout.astro";
import ToolsHero from "../../../components/ToolsHero.astro";
import TarotDraw from "../../../components/tarot/TarotDraw.astro";

const seoBreadcrumbs = [
  { label: "หน้าแรก", href: "/" },
  { label: "ไพ่ยิปซีรายวัน", href: "/tarot/daily/" },
];
---

<ToolsLayout
  title="อ่านไพ่ยิปซีรายวัน | มงคลเวลา"
  description="อ่านไพ่ยิปซีรายวันแบบโต้ตอบ สับไพ่ ตัดไพ่ เลือกไพ่ 1 ใบ แล้วรับคำทำนายพร้อมคำแนะนำ สีและเวลามงคล"
  lang="th"
  locale="th"
  page="tarotDaily"
  bodyClass="tarot-page"
  canonicalPath="/tarot/daily/"
  breadcrumbs={seoBreadcrumbs}
>
  <main id="daily-tarot">
    <ToolsHero ornamentSrc="/assets/images/life-graph-watercolor.webp" quote="ทุกไพ่มีคำตอบ เพียงคุณเปิดใจ" title="อ่านไพ่ยิปซีรายวัน" kicker="Daily Tarot" lead="ตั้งจิต สับไพ่ แล้วเลือกไพ่ 1 ใบ เพื่ออ่านคำทำนายประจำวัน พร้อมคำแนะนำ ข้อควรระวัง สีและเวลามงคล" breadcrumbs={[{label:"หน้าแรก",href:"/"},{label:"ไพ่ยิปซีรายวัน"}]} />

    <TarotDraw spreadType="daily" requiredCount={1} deckCount={78} storageKey="monkolDailyTarot"
      intentionCopy="โปรดใช้ไพ่ด้วยสติและความเคารพ ไม่ต้องถามซ้ำเพื่อเอาคำตอบที่ถูกใจ ให้ไพ่เป็นพื้นที่ทบทวนใจของคุณ"
      warning="ไม่ควรถามเรื่องเดิมซ้ำหลายครั้งในวันเดียว" />

    <section class="tarot-note tools-section">
      <p data-cms-field="ed421aaf-1" class="section-kicker">แนวคิดของเรา</p>
      <h2 data-cms-field="ed421aaf-2">ไพ่เป็นพื้นที่สนทนากับใจ ไม่ใช่คำสั่งตายตัว</h2>
      <p data-cms-field="ed421aaf-3">
        ภาพไพ่ Rider-Waite-Smith โดย Pamela Colman Smith เป็นสัญลักษณ์ให้เราทบทวนใจ
        อ่านคำทำนายร่วมกับข้อมูลจริงและวิจารณญาณ การตัดสินใจยังเป็นของคุณเสมอ
      </p>
    </section>
  </main>

</ToolsLayout>
