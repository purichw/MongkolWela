---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const mainContent = "<main id=\"daily-tarot\">\n      <section class=\"tarot-hero\">\n        <div>\n          <nav class=\"tarot-breadcrumb\" aria-label=\"breadcrumb\">\n            <a href=\"../../\">หน้าแรก</a>\n            <span>/</span>\n            <span>ไพ่ยิปซีรายวัน</span>\n          </nav>\n          <p class=\"section-kicker\">Daily Tarot</p>\n          <h1>ดูดวงไพ่ยิปซีรายวัน</h1>\n          <p class=\"tarot-hero-copy\">\n            ตั้งจิตให้สงบ สับไพ่หรือตัดไพ่ตามความรู้สึก แล้วเลือกไพ่ 1 ใบ\n            เพื่ออ่านคำทำนายประจำวัน พร้อมคำแนะนำ ข้อควรระวัง สีและเวลามงคล\n          </p>\n        </div>\n\n        <aside class=\"tarot-ritual-panel\" aria-label=\"ขั้นตอนการดูไพ่\">\n          <ol>\n            <li><span>1</span>หายใจเข้าออกลึก ๆ แล้วตั้งคำถามในใจ</li>\n            <li><span>2</span>สับไพ่หรือตัดไพ่เพื่อเปลี่ยนจังหวะพลังงาน</li>\n            <li><span>3</span>เลือกไพ่ที่เรียกสายตาหรือใจของคุณ 1 ใบ</li>\n            <li><span>4</span>กดทำนายเพื่อเปิดคำพยากรณ์</li>\n          </ol>\n        </aside>\n      </section>\n\n      <section class=\"tarot-oracle\">\n        <aside class=\"tarot-intention\">\n          <p class=\"section-kicker\">ตั้งจิต</p>\n          <h2>ก่อนเลือกไพ่</h2>\n          <p>\n            โปรดใช้ไพ่ด้วยความเคารพ ไม่ต้องถามซ้ำเพื่อเอาคำตอบที่ถูกใจ\n            คำทำนายเป็นกระจกให้ทบทวน ไม่ใช่นายเหนือชีวิต\n          </p>\n          <div class=\"tarot-warning\">ไม่ควรดูไพ่รายวันเกินวันละครั้ง</div>\n        </aside>\n\n        <form class=\"tarot-deck-stage\" data-tarot-form>\n          <div class=\"tarot-deck-head\">\n            <div>\n              <p class=\"section-kicker\">สำรับ 78 ใบ</p>\n              <h2>เลือกไพ่ 1 ใบ แล้วกดทำนาย</h2>\n              <p class=\"tarot-status\" data-tarot-status aria-live=\"polite\"></p>\n            </div>\n            <div class=\"tarot-deck-actions\">\n              <button class=\"tarot-control\" type=\"button\" data-tarot-shuffle>สับไพ่</button>\n              <button class=\"tarot-control\" type=\"button\" data-tarot-cut>ตัดไพ่</button>\n              <button class=\"tarot-read-button btn-disable\" type=\"submit\" data-tarot-read disabled>\n                ทำนาย\n              </button>\n            </div>\n          </div>\n\n          <input type=\"hidden\" data-tarot-selected name=\"tarot_card_selected\">\n          <input type=\"hidden\" data-tarot-count name=\"tarot_card_count\" value=\"0\">\n          <div class=\"tarot-deck-grid\" data-tarot-deck aria-label=\"สำรับไพ่ยิปซี 78 ใบ\"></div>\n        </form>\n      </section>\n\n      <section class=\"tarot-note\">\n        <p class=\"section-kicker\">แนวคิดของเรา</p>\n        <h2>ไพ่เป็นพื้นที่สนทนากับใจ ไม่ใช่คำสั่งตายตัว</h2>\n        <p>\n          ไพ่แต่ละใบถูกออกแบบเป็นศิลปะเชิงสัญลักษณ์ของมงคลเวลาเอง\n          ไม่อ้างอิงแอปภายนอกและไม่ใช้ภาพไพ่ลิขสิทธิ์จากสำรับอื่น\n          เพื่อให้ประสบการณ์ดูร่วมสมัย แต่ยังสงบ ขลัง และเคารพธรรมเนียมการพยากรณ์\n        </p>\n      </section>\n    </main>";
const extraScripts = ["/assets/js/tarot-daily.js"];
---

<BaseLayout
  title="ดูดวงไพ่ยิปซีรายวัน | มงคลเวลา"
  description="ดูดวงไพ่ยิปซีรายวันแบบโต้ตอบ สับไพ่ ตัดไพ่ เลือกไพ่ 1 ใบ แล้วรับคำทำนายพร้อมคำแนะนำ สีและเวลามงคล"
  lang="th"
  locale="th"
  page="tarotDaily"
  bodyClass="tarot-page"
  extraScripts={extraScripts}
>
  <Fragment set:html={mainContent} />
</BaseLayout>
