---
import ToolsLayout from "../../../layouts/ToolsLayout.astro";
import ToolsHero from "../../../components/ToolsHero.astro";


---

<ToolsLayout
  title="คำทำนายไพ่ยิปซีรายวัน | มงคลเวลา"
  description="ผลคำทำนายไพ่ยิปซีรายวัน พร้อมธีม คำแปลความ คำแนะนำ ข้อควรระวัง สีและเวลามงคล"
  lang="th"
  locale="th"
  page="tarotResult"
  bodyClass="tarot-page tarot-result-page"
  canonicalPath="/tarot/daily/result/"
  robots="noindex, follow"
>
  <main>
<ToolsHero ornamentSrc="/assets/images/life-graph-watercolor.webp" title="คำทำนายไพ่ยิปซีรายวัน" kicker="Tarot Reading" lead="อ่านคำทำนายเป็นแนวทางประกอบการตัดสินใจ ไม่ใช่การรับรองผลลัพธ์ล่วงหน้า" breadcrumbs={[{label:"หน้าแรก",href:"/"},{label:"ไพ่ยิปซีรายวัน",href:"/tarot/daily/"},{label:"ผลคำทำนาย"}]} />
      <section class="tarot-result-shell" data-tarot-result>
        <div class="tarot-result-copy">
          <p data-cms-field="7801fb96-1" class="section-kicker">Daily Tarot</p>
          <h2 data-cms-field="7801fb96-2">กำลังเปิดคำทำนาย</h2>
          <p data-cms-field="7801fb96-3">โปรดรอสักครู่...</p>
        </div>
      </section>

      <section class="tarot-related tools-section">
        <p data-cms-field="7801fb96-4" class="section-kicker">หลังอ่านคำทำนาย</p>
        <h2 data-cms-field="7801fb96-5">ใช้ไพ่เป็นแสงไฟเล็ก ๆ ไม่ใช่กรงขังใจ</h2>
        <p data-cms-field="7801fb96-6">
          หากไพ่เตือนเรื่องใด ให้รับไว้ด้วยความไม่ประมาท
          หากไพ่ให้กำลังใจ ให้ใช้เป็นแรงตั้งต้นทำสิ่งดีในวันนี้
        </p>
      </section>
    </main>

  <script>
    import "../../../scripts/tarot-result.js";
  </script>
</ToolsLayout>
