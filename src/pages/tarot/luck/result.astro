---
import ToolsLayout from "../../../layouts/ToolsLayout.astro";
import ToolsHero from "../../../components/ToolsHero.astro";
---

<ToolsLayout
  title="ผลไพ่ยิปซีด้านโชคลาภ | มงคลเวลา"
  description="ผลคำทำนายไพ่ยิปซีโชคลาภจาก Major Arcana พร้อมจังหวะ โอกาส คำแนะนำ และข้อควรระวัง"
  lang="th"
  locale="th"
  page="tarotLuck"
  bodyClass="tarot-page tarot-result-page"
  canonicalPath="/tarot/luck/result/"
  robots="noindex, follow"
>
  <main>
<ToolsHero title="คำทำนายไพ่ยิปซีด้านโชคลาภ" kicker="Tarot Reading" lead="อ่านคำทำนายเป็นแนวทางประกอบการตัดสินใจ ไม่ใช่การรับรองผลลัพธ์ล่วงหน้า" breadcrumbs={[{label:"หน้าแรก",href:"/"},{label:"ไพ่ยิปซีด้านโชคลาภ",href:"/tarot/luck/"},{label:"ผลคำทำนาย"}]} />
    <section
      class="tarot-result-shell"
      data-tarot-spread-result
      data-spread-type="luck"
      data-storage-key="monkolLuckTarot"
    >
      <div class="tarot-result-copy">
        <p class="section-kicker">ไพ่ยิปซีด้านโชคลาภ</p>
        <h2>กำลังเปิดคำทำนาย</h2>
        <p>โปรดรอสักครู่...</p>
      </div>
    </section>

    <section class="tarot-related tools-section">
      <p class="section-kicker">หลังอ่านคำทำนาย</p>
      <h2>ใช้โอกาสด้วยสติและมีขอบเขต</h2>
      <p>
        หากไพ่ส่งเสริม ให้กำหนดขอบเขตที่ชัดก่อนเริ่ม
        หากไพ่เตือน ให้พักจังหวะไว้ก่อน เพราะการไม่ฝืนก็เป็นโชคอย่างหนึ่ง
      </p>
    </section>
  </main>

  <script>
    import "../../../scripts/tarot-spread-result.js";
  </script>
</ToolsLayout>
