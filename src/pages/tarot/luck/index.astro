---
import ToolsLayout from "../../../layouts/ToolsLayout.astro";
import ToolsHero from "../../../components/ToolsHero.astro";
import TarotDraw from "../../../components/tarot/TarotDraw.astro";
---

<ToolsLayout
  title="ไพ่ยิปซีด้านโชคลาภ | มงคลเวลา"
  description="ดูไพ่ยิปซีด้านโชคลาภ เลือกไพ่ Major Arcana 1 ใบเพื่ออ่านจังหวะ โอกาส และข้อควรระวังอย่างมีขอบเขต"
  lang="th"
  locale="th"
  page="tarotLuck"
  bodyClass="tarot-page"
>
  <main id="luck-tarot">
    <ToolsHero ornamentSrc="/assets/images/life-graph-watercolor.webp" quote="ทุกไพ่มีคำตอบ เพียงคุณเปิดใจ" title="ไพ่ยิปซีด้านโชคลาภ" kicker="Luck Tarot" lead="เลือกไพ่ Major Arcana 1 ใบเพื่อทบทวนจังหวะและโอกาส พร้อมข้อควรระวังในการตัดสินใจอย่างมีขอบเขต" breadcrumbs={[{label:"หน้าแรก",href:"/"},{label:"ไพ่ยิปซีด้านโชคลาภ"}]} />

    <TarotDraw spreadType="luck" requiredCount={1} deckCount={22} storageKey="monkolLuckTarot"
      intentionCopy="อ่านจังหวะและแนวโน้มเชิงสัญลักษณ์ ไม่ใช่การรับประกันผลลัพธ์ ควรกำหนดขอบเขตและพิจารณาข้อมูลจริงเสมอ"
      warning="ไม่ควรใช้คำทำนายแทนข้อมูลจริงหรือการตัดสินใจทางการเงิน" />

    <section class="tarot-note tools-section">
      <p data-cms-field="ced376b7-1" class="section-kicker">แนวคิดของเรา</p>
      <h2 data-cms-field="ced376b7-2">โชคที่ดีควรเดินคู่กับขอบเขต</h2>
      <p data-cms-field="ced376b7-3">
        ไพ่โชคลาภออกแบบให้ช่วยทบทวนใจและพิจารณาจังหวะ ไม่ใช่กระตุ้นให้ตัดสินใจเกินขอบเขต
        หากคำทำนายเปิดทาง ให้ใช้เป็นกำลังใจอย่างพอดี หากคำทำนายเตือน ให้พักและทบทวนก่อน
      </p>
    </section>
  </main>

</ToolsLayout>
