---
import ToolsLayout from "../../../layouts/ToolsLayout.astro";
import ToolsHero from "../../../components/ToolsHero.astro";
---

<ToolsLayout
  title="ไพ่ยิปซีด้านโชคลาภ | มงคลเวลา"
  description="ดูไพ่ยิปซีด้านโชคลาภ เลือกไพ่ Major Arcana 1 ใบเพื่ออ่านจังหวะ โอกาส และข้อควรระวังอย่างมีขอบเขต"
  lang="th"
  locale="th"
  page="tarotLuck"
  bodyClass="tarot-page"
>
  <main id="luck-tarot">
    <ToolsHero title="ไพ่ยิปซีด้านโชคลาภ" kicker="Luck Tarot" lead="เลือกไพ่ Major Arcana 1 ใบเพื่อทบทวนจังหวะและโอกาส พร้อมข้อควรระวังในการตัดสินใจอย่างมีขอบเขต" breadcrumbs={[{label:"หน้าแรก",href:"/"},{label:"ไพ่ยิปซีด้านโชคลาภ"}]} />

    <section class="tarot-oracle tools-workspace">
      <aside class="tarot-intention tools-panel">
        <p class="section-kicker">ตั้งจิต</p>
        <h2>ก่อนเลือกไพ่</h2>
        <p>
          หน้านี้อ่านจังหวะและแนวโน้มเชิงสัญลักษณ์เท่านั้น
          ไม่ใช่การรับประกันผลลัพธ์ ควรกำหนดขอบเขตและพิจารณาข้อมูลจริงเสมอ
        </p>
        <div class="tarot-warning">ไม่ควรใช้คำทำนายแทนข้อมูลจริงหรือการตัดสินใจทางการเงิน</div>
      <aside class="tarot-ritual-panel" aria-label="ขั้นตอนการดูไพ่โชคลาภ">
        <ol>
          <li><span>1</span>ตั้งคำถามให้ชัดว่าต้องการพิจารณาเรื่องใด</li>
          <li><span>2</span>สับไพ่หรือตัดไพ่ก่อนเลือก</li>
          <li><span>3</span>เลือกไพ่ Major Arcana ที่รู้สึกสะดุดใจ 1 ใบ</li>
          <li><span>4</span>อ่านผลด้วยสติและกำหนดขอบเขตของตัวเอง</li>
        </ol>
      </aside></aside>

      <form
        class="tarot-deck-stage tools-panel"
        data-tarot-spread-form
        data-spread-type="luck"
        data-required-count="1"
        data-storage-key="monkolLuckTarot"
      >
        <div class="tarot-deck-head">
          <div>
            <p class="section-kicker">Major Arcana 22 ใบ</p>
            <h2>เลือกไพ่ 1 ใบ แล้วกดเปิดคำทำนาย</h2>
            <p class="tarot-status" data-tarot-status aria-live="polite"></p>
          </div>
          <div class="tarot-deck-actions">
            <button class="tarot-control" type="button" data-tarot-shuffle>สับไพ่</button>
            <button class="tarot-control" type="button" data-tarot-cut>ตัดไพ่</button>
            <button class="tarot-read-button btn-disable" type="submit" data-tarot-read disabled>
              เปิดคำทำนาย
            </button>
          </div>
        </div>

        <input type="hidden" data-tarot-selected name="tarot_cards_selected" />
        <input type="hidden" data-tarot-count name="tarot_card_count" value="0" />
        <div class="tarot-deck-grid tarot-deck-grid-compact" data-tarot-deck aria-label="สำรับไพ่ Major Arcana 22 ใบ"></div>
      </form>
    </section>

    <section class="tarot-note tools-section">
      <p class="section-kicker">แนวคิดของเรา</p>
      <h2>โชคที่ดีควรเดินคู่กับขอบเขต</h2>
      <p>
        ไพ่โชคลาภออกแบบให้ช่วยทบทวนใจและพิจารณาจังหวะ ไม่ใช่กระตุ้นให้ตัดสินใจเกินขอบเขต
        หากคำทำนายเปิดทาง ให้ใช้เป็นกำลังใจอย่างพอดี หากคำทำนายเตือน ให้พักและทบทวนก่อน
      </p>
    </section>
  </main>

  <script>
    import "../../../scripts/tarot-spread.js";
  </script>
</ToolsLayout>
