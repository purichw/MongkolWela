---
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const extraScripts = ["/assets/js/temple-directory.js"];
---

<BaseLayout
  title="All Temples in Thailand | Mongkol Wela"
  description="Search the Thailand temple registry from the attached data file by temple name, temple type, sect, province, district, subdistrict, postal code, and Wisungkhamsima status."
  lang="en"
  locale="en"
  page="templesThailand"
  bodyClass="temple-directory-page"
  extraScripts={extraScripts}
>
  <main class="temple-directory" data-temple-directory data-locale="en">
    <section class="temple-directory-head">
      <nav class="temple-breadcrumb" aria-label="breadcrumb">
        <a href="../../../">Home</a>
        <span>/</span>
        <span>Auspicious Temples</span>
      </nav>
      <p class="section-kicker">Temple Registry</p>
      <h1>All Temples in Thailand</h1>
      <p>Search the attached temple registry file. The table uses columns A-M only, with Wisungkhamsima status kept for filtering.</p>
    </section>

    <section class="temple-search-panel" aria-label="Search temples in Thailand">
      <form class="temple-search-form" data-temple-form>
        <label class="temple-field temple-field-wide">
          <span>Temple name</span>
          <input type="search" name="name" placeholder="Search by temple name" autocomplete="off" data-temple-name />
        </label>

        <label class="temple-field">
          <span>Temple type</span>
          <select name="type" data-temple-type></select>
        </label>

        <label class="temple-field">
          <span>Sect</span>
          <select name="sect" data-temple-sect></select>
        </label>

        <label class="temple-field">
          <span>Province</span>
          <select name="province" data-temple-province></select>
        </label>

        <label class="temple-field">
          <span>District</span>
          <select name="district" data-temple-district></select>
        </label>

        <label class="temple-field">
          <span>Subdistrict</span>
          <select name="subdistrict" data-temple-subdistrict></select>
        </label>

        <label class="temple-field">
          <span>Postal code</span>
          <input type="search" name="postalCode" inputmode="numeric" placeholder="e.g. 10150" autocomplete="off" data-temple-postal />
        </label>

        <label class="temple-field">
          <span>Wisungkhamsima</span>
          <select name="wisung" data-temple-wisung>
            <option value="">-- All --</option>
            <option value="ไม่ได้รับ">Not received</option>
            <option value="ได้รับ">Received</option>
          </select>
        </label>

        <div class="temple-actions">
          <button class="temple-search-button" type="submit">Search</button>
          <button class="temple-clear-button" type="button" data-temple-clear>Clear</button>
        </div>
      </form>
    </section>

    <section class="temple-results" aria-live="polite">
      <div class="temple-results-head">
        <div>
          <p class="section-kicker">Results</p>
          <h2 data-temple-count>Loading temple data</h2>
        </div>
        <p data-temple-source>Data source: Report_Temple 2.numbers</p>
      </div>

      <div class="temple-table-wrap">
        <table class="temple-table">
          <thead data-temple-table-head></thead>
          <tbody data-temple-table-body>
            <tr>
              <td>Loading data</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="temple-pagination" data-temple-pagination></div>
    </section>
  </main>
</BaseLayout>
