---
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const mainContent = `<main id="daily-tarot">
  <section class="tarot-hero">
    <div>
      <nav class="tarot-breadcrumb" aria-label="breadcrumb"><a href="../../">Home</a><span>/</span><span>Daily Tarot</span></nav>
      <p class="section-kicker">Daily Tarot</p>
      <h1>Daily Tarot Reading</h1>
      <p class="tarot-hero-copy">Settle your mind, shuffle or cut the deck, then choose one card for daily guidance, advice, caution, auspicious color, and timing.</p>
    </div>
    <aside class="tarot-ritual-panel" aria-label="Tarot steps">
      <ol><li><span>1</span>Breathe slowly and hold one question in mind</li><li><span>2</span>Shuffle or cut the deck to shift the rhythm</li><li><span>3</span>Choose one card that calls to your attention</li><li><span>4</span>Press read to open the guidance</li></ol>
    </aside>
  </section>
  <section class="tarot-oracle">
    <aside class="tarot-intention">
      <p class="section-kicker">Intention</p><h2>Before choosing a card</h2>
      <p>Use the card respectfully. A reading is a mirror for reflection, not an order over your life.</p>
      <div class="tarot-warning">Daily tarot is best drawn once per day.</div>
    </aside>
    <form class="tarot-deck-stage" data-tarot-form>
      <div class="tarot-deck-head">
        <div><p class="section-kicker">78-card deck</p><h2>Choose one card, then press read</h2><p class="tarot-status" data-tarot-status aria-live="polite"></p></div>
        <div class="tarot-deck-actions"><button class="tarot-control" type="button" data-tarot-shuffle>Shuffle</button><button class="tarot-control" type="button" data-tarot-cut>Cut</button><button class="tarot-read-button btn-disable" type="submit" data-tarot-read disabled>Read</button></div>
      </div>
      <input type="hidden" data-tarot-selected name="tarot_card_selected"><input type="hidden" data-tarot-count name="tarot_card_count" value="0">
      <div class="tarot-deck-grid" data-tarot-deck aria-label="78-card tarot deck"></div>
    </form>
  </section>
</main>`;
const extraScripts = ["/assets/js/tarot-daily.js"];
---

<BaseLayout
  title="Daily Tarot Reading | Mongkol Wela"
  description="Interactive daily tarot: shuffle, cut, choose one card, and receive a daily reading."
  lang="en"
  locale="en"
  page="tarotDaily"
  bodyClass="tarot-page"
  extraScripts={extraScripts}
>
  <Fragment set:html={mainContent} />
</BaseLayout>
