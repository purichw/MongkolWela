---
import BaseLayout from "../../layouts/BaseLayout.astro";

const mainContent = "<main>\n      <section class=\"hero\" aria-labelledby=\"hero-title\">\n        <div class=\"hero-carousel\" data-carousel>\n          <div class=\"hero-slide is-active\">\n            <img src=\"../assets/images/hero-jtha-98.jpg\" alt=\"\">\n          </div>\n          <div class=\"hero-slide\">\n            <img src=\"../assets/images/hero-jtha-83.jpg\" alt=\"\">\n          </div>\n          <div class=\"hero-slide\">\n            <img src=\"../assets/images/hero-jtha-80.jpg\" alt=\"\">\n          </div>\n          <div class=\"hero-slide\">\n            <img src=\"../assets/images/hero-temple-red.jpg\" alt=\"\">\n          </div>\n          <div class=\"hero-slide\">\n            <img src=\"../assets/images/hero-thai-astrology.jpg\" alt=\"\">\n          </div>\n        </div>\n        <div class=\"hero-shade\"></div>\n        <div class=\"hero-content\">\n          <p class=\"eyebrow\">Life calendar • Auspicious timing • Divination</p>\n          <h1 id=\"hero-title\">Mongkol Wela</h1>\n          <p class=\"hero-copy\">\n            A spiritual guide to Thai calendars, auspicious names, numerology, tarot,\n            prayers, and astrology for decisions that call for timing, meaning, and grace.\n          </p>\n\n          <form class=\"hero-search\" action=\"#\" role=\"search\">\n            <label class=\"sr-only\" for=\"site-search\">Search</label>\n            <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n              <path d=\"m21 21-4.3-4.3m2.3-5.2a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z\"></path>\n            </svg>\n            <input id=\"site-search\" name=\"q\" type=\"search\" placeholder=\"Search: wedding dates, baby names, tarot, Chinese calendar\">\n            <button type=\"submit\">Search</button>\n          </form>\n\n          <div class=\"hero-links\" aria-label=\"Shortcuts\">\n            <a href=\"/en/#today\">Daily horoscope</a>\n            <a href=\"/en/#calendar\">Monthly auspicious dates</a>\n            <a href=\"/en/#names\">Auspicious names</a>\n            <a href=\"/en/#rituals\">Travel prayers</a>\n          </div>\n        </div>\n        <div class=\"hero-controls\" aria-label=\"Homepage images\">\n          <button class=\"hero-arrow\" type=\"button\" data-carousel-prev aria-label=\"Previous image\">\n            <span aria-hidden=\"true\">‹</span>\n          </button>\n          <div class=\"hero-dots\" aria-label=\"Choose image\">\n            <button class=\"is-active\" type=\"button\" data-carousel-dot aria-label=\"Image 1\" aria-pressed=\"true\"></button>\n            <button type=\"button\" data-carousel-dot aria-label=\"Image 2\" aria-pressed=\"false\"></button>\n            <button type=\"button\" data-carousel-dot aria-label=\"Image 3\" aria-pressed=\"false\"></button>\n            <button type=\"button\" data-carousel-dot aria-label=\"Image 4\" aria-pressed=\"false\"></button>\n            <button type=\"button\" data-carousel-dot aria-label=\"Image 5\" aria-pressed=\"false\"></button>\n          </div>\n          <button class=\"hero-arrow\" type=\"button\" data-carousel-next aria-label=\"Next image\">\n            <span aria-hidden=\"true\">›</span>\n          </button>\n        </div>\n      </section>\n\n      <section class=\"today-panel\" id=\"today\" aria-labelledby=\"today-title\">\n        <div>\n          <p class=\"section-kicker\">Today</p>\n          <h2 id=\"today-title\">Daily Auspicious Rhythm</h2>\n        </div>\n        <div class=\"today-grid\">\n          <article>\n            <span>Lunar day</span>\n            <strong>Waxing 5th</strong>\n            <p>Month 7, Year of the Horse</p>\n          </article>\n          <article>\n            <span>Supportive color</span>\n            <strong>Jade green</strong>\n            <p>Work, negotiation, new beginnings</p>\n          </article>\n          <article>\n            <span>Intention</span>\n            <strong>Metta prayer</strong>\n            <p>Before important meetings or delicate conversations</p>\n          </article>\n          <article>\n            <span>Simple timing</span>\n            <strong>09:19 - 10:36</strong>\n            <p>Good for documents and formal requests</p>\n          </article>\n        </div>\n      </section>\n\n      <section class=\"section-shell\" id=\"horoscope\">\n        <div class=\"section-heading\">\n          <p class=\"section-kicker\">Main Topics</p>\n          <h2>Choose What You Want to Know</h2>\n        </div>\n\n        <div class=\"category-grid\">\n          <a class=\"category-card\" href=\"/en/tarot/daily/\">\n            <span class=\"category-symbol\">☉</span>\n            <strong>Horoscope and Astrology</strong>\n            <p>Life graph, Thai numerology, natal readings, transits, love, work, and money.</p>\n          </a>\n          <a class=\"category-card\" href=\"/en/calendar/\">\n            <span class=\"category-symbol\">☾</span>\n            <strong>Auspicious Dates and Calendars</strong>\n            <p>Thai calendar, Buddhist holy days, car blessing, wedding dates, good and avoided days.</p>\n          </a>\n          <a class=\"category-card\" href=\"/en/#names\">\n            <span class=\"category-symbol\">๙</span>\n            <strong>Names and Numbers</strong>\n            <p>Baby names, name analysis, phone numbers, license plates, and life numerology.</p>\n          </a>\n          <a class=\"category-card\" href=\"/en/#\">\n            <span class=\"category-symbol\">✦</span>\n            <strong>Divination</strong>\n            <p>Tarot, fortune sticks, dice, dream interpretation, and lucky numbers.</p>\n          </a>\n          <a class=\"category-card\" href=\"/en/#rituals\">\n            <span class=\"category-symbol\">✺</span>\n            <strong>Prayers and Rituals</strong>\n            <p>Buddhist chants, metta prayers, remedy rituals, and birthday Buddha devotion.</p>\n          </a>\n          <a class=\"category-card\" href=\"/en/#learn\">\n            <span class=\"category-symbol\">北</span>\n            <strong>Chinese and Eastern Traditions</strong>\n            <p>Chinese calendar, zodiac animals, elements, feng shui, and traditional festivals.</p>\n          </a>\n        </div>\n      </section>\n\n      <section class=\"feature-band\" id=\"calendar\" aria-labelledby=\"calendar-title\">\n        <div class=\"feature-copy\">\n          <p class=\"section-kicker\">Auspicious Calendar</p>\n          <h2 id=\"calendar-title\">Start with the Day, Then Read Deeper</h2>\n          <p>\n            Check Thai lunar dates, Buddhist holy days, traditional timing notes, and monthly guidance\n            before choosing moments for ceremonies, travel, negotiations, or meaningful new starts.\n          </p>\n          <div class=\"feature-actions\">\n            <a class=\"primary-action\" href=\"/en/calendar/\">Open Thai calendar</a>\n            <a class=\"secondary-action\" href=\"/en/#\">View monthly dates</a>\n          </div>\n        </div>\n        <div class=\"calendar-preview\" aria-label=\"Calendar preview\">\n          <div class=\"calendar-title\">\n            <span>June 2026</span>\n            <strong>Friday</strong>\n          </div>\n          <div class=\"calendar-days\">\n            <span>1</span><span>2</span><span>3</span><span>4</span><b>5</b><span>6</span><span>7</span>\n            <span>8</span><span>9</span><span>10</span><span>11</span><span>12</span><span>13</span><span>14</span>\n            <span>15</span><span>16</span><i>17</i><span>18</span><span>19</span><span>20</span><span>21</span>\n          </div>\n          <dl>\n            <div><dt>Holy day</dt><dd>Jun 17</dd></div>\n            <div><dt>Favored</dt><dd>Negotiation</dd></div>\n            <div><dt>Avoid</dt><dd>Rushed signing</dd></div>\n          </dl>\n        </div>\n      </section>\n\n      <section class=\"section-shell\" id=\"names\">\n        <div class=\"section-heading\">\n          <p class=\"section-kicker\">Popular Tools</p>\n          <h2>Tools People Return To</h2>\n        </div>\n\n        <div class=\"tool-grid\">\n          <article class=\"tool-card\">\n            <span>01</span>\n            <h3>Auspicious Names</h3>\n            <p>Find names by birth day, gender, family name, Thai naming rules, numerology, and meaning.</p>\n            <a href=\"/en/#\">Start search</a>\n          </article>\n          <article class=\"tool-card\">\n            <span>02</span>\n            <h3>Daily Tarot</h3>\n            <p>Draw one card for guidance on the heart, work, money, and relationships.</p>\n            <a href=\"/en/tarot/daily/\">Draw a card</a>\n          </article>\n          <article class=\"tool-card\">\n            <span>03</span>\n            <h3>Phone Number Reading</h3>\n            <p>Read totals, repeating pairs, strengths, and fit with the owner.</p>\n            <a href=\"/en/#\">Check number</a>\n          </article>\n          <article class=\"tool-card\">\n            <span>04</span>\n            <h3>Dream Meaning</h3>\n            <p>Search symbols, omens, and lucky numbers connected with a dream.</p>\n            <a href=\"/en/#\">Search dream</a>\n          </article>\n        </div>\n      </section>\n\n      <section class=\"tradition-section\" id=\"rituals\" aria-labelledby=\"rituals-title\">\n        <img src=\"../assets/images/chinese-incense-card.jpg\" alt=\"Hanging incense coils inside a Chinese temple\">\n        <div>\n          <p class=\"section-kicker\">Tradition and Ritual</p>\n          <h2 id=\"rituals-title\">A Home for Prayers, Omens, and Cultural Practice</h2>\n          <p>\n            Collect Buddhist chants, mantras, lucky colors, year-clash guidance, offerings,\n            and Thai-Chinese customs with respectful explanations for daily practice.\n          </p>\n          <div class=\"ritual-list\">\n            <a href=\"/en/#\">Morning and evening chants</a>\n            <a href=\"/en/#\">Metta prayers</a>\n            <a href=\"/en/#\">Self-guided remedy rituals</a>\n            <a href=\"/en/#\">Year clash and Chinese calendar</a>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"learn-strip\" id=\"learn\">\n        <p>Knowledge Library</p>\n        <a href=\"/en/#\">What is an ascendant?</a>\n        <a href=\"/en/#\">Counting days in Thai astrology</a>\n        <a href=\"/en/#\">Upper and lower auspicious timing</a>\n        <a href=\"/en/#\">Thai naming rules</a>\n        <a href=\"/en/#\">Chinese calendar basics</a>\n      </section>\n    </main>";
const extraScripts = [] as string[];
---

<BaseLayout
  title="Mongkol Wela | Thai Astrology, Auspicious Dates, Names, and Rituals"
  description="English homepage for Mongkol Wela, a Thai-first astrology, auspicious calendar, naming, numerology, tarot, prayer, and spiritual knowledge platform."
  lang="en"
  locale="en"
  page="home"
  bodyClass=""
  extraScripts={extraScripts}
>
  <Fragment set:html={mainContent} />
</BaseLayout>
