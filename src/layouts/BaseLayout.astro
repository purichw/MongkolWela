---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LoadingScreen from "../components/LoadingScreen.astro";

interface Props {
  title: string;
  description?: string;
  lang?: "th";
  locale?: "th";
  page?: string;
  bodyClass?: string;
  extraScripts?: string[];
}

const {
  title,
  description,
  lang = "th",
  locale = lang,
  page = "home",
  bodyClass = "",
  extraScripts = [],
} = Astro.props as Props;

const assetVersion = "20260607-11";
const versionedAsset = (src: string) => `${src}${src.includes("?") ? "&" : "?"}v=${assetVersion}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      try {
        if (window.sessionStorage.getItem("mongkolwela.loader.v2.seen") !== "1") {
          document.documentElement.classList.add("is-loading");
        }
      } catch {
        document.documentElement.classList.add("is-loading");
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href={versionedAsset("/styles.css")} />
  </head>
  <body class={bodyClass}>
    <LoadingScreen />
    <div class="scroll-progress" data-scroll-progress aria-hidden="true">
      <span data-scroll-progress-bar></span>
    </div>
    <Header locale={locale} page={page} />
    <slot />
    <Footer locale={locale} page={page} />

    <script is:inline type="module" src={versionedAsset("/script.js")}></script>
    {extraScripts.map((src: string) => <script is:inline type="module" src={versionedAsset(src)}></script>)}
  </body>
</html>
