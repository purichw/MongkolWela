---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LoadingScreen from "../components/LoadingScreen.astro";

interface Props {
  title: string;
  description?: string;
  lang?: "th" | "en";
  locale?: "th" | "en";
  page?: string;
  bodyClass?: string;
  extraScripts?: string[];
}

const {
  title,
  description,
  lang = "th",
  locale = lang,
  page = "home",
  bodyClass = "",
  extraScripts = [],
} = Astro.props as Props;

const assetVersion = "20260606-4";
const versionedAsset = (src: string) => `${src}${src.includes("?") ? "&" : "?"}v=${assetVersion}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      document.documentElement.classList.add("is-loading");
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href={versionedAsset("/styles.css")} />
  </head>
  <body class={bodyClass}>
    <LoadingScreen />
    <Header locale={locale} page={page} />
    <slot />
    <Footer locale={locale} page={page} />

    <script is:inline type="module" src={versionedAsset("/script.js")}></script>
    {extraScripts.map((src: string) => <script is:inline type="module" src={versionedAsset(src)}></script>)}
  </body>
</html>
