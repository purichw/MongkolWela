---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LoadingScreen from "../components/LoadingScreen.astro";
import PageEntrance from "../components/PageEntrance.astro";
import { brandAssets } from "../config/site.js";
import { stylesForPath } from "../config/styles.js";
import {
  SEO_DEFAULT_IMAGE,
  SEO_DEFAULT_IMAGE_HEIGHT,
  SEO_DEFAULT_IMAGE_WIDTH,
  SEO_SITE_NAME,
  absoluteUrl,
  canonicalUrl,
  cleanDescription,
  createBreadcrumbJsonLd,
  createOrganizationJsonLd,
  createWebPageJsonLd,
  createWebSiteJsonLd,
  normalizeBreadcrumbs,
  toJsonLdGraph,
} from "../lib/seo.js";

interface Props {
  title: string;
  description?: string;
  lang?: "th";
  locale?: "th";
  page?: string;
  bodyClass?: string;
  canonicalPath?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  robots?: string;
  pageType?: string;
  analytics?: boolean;
  breadcrumbs?: { label: string; href?: string }[];
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

type BreadcrumbItem = { label: string; href?: string };

const {
  title,
  description,
  lang = "th",
  locale = lang,
  page = "home",
  bodyClass = "",
  canonicalPath,
  image = SEO_DEFAULT_IMAGE,
  imageAlt = SEO_SITE_NAME,
  imageWidth = SEO_DEFAULT_IMAGE_WIDTH,
  imageHeight = SEO_DEFAULT_IMAGE_HEIGHT,
  robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
  pageType = "website",
  analytics = true,
  breadcrumbs = [],
  structuredData = [],
} = Astro.props as Props;

const pagePath = canonicalPath || Astro.url.pathname;
const pageUrl = canonicalUrl(pagePath);
const seoDescription = cleanDescription(description);
const seoImage = absoluteUrl(image);
const normalizedBreadcrumbs = normalizeBreadcrumbs(breadcrumbs) as BreadcrumbItem[];
const breadcrumbJsonLd = createBreadcrumbJsonLd(normalizedBreadcrumbs, pageUrl);
const pageJsonLd = createWebPageJsonLd({
  title,
  description: seoDescription,
  url: pageUrl,
  image: seoImage,
  breadcrumbs: normalizedBreadcrumbs,
});
const jsonLd = toJsonLdGraph([
  createOrganizationJsonLd(),
  createWebSiteJsonLd(),
  pageJsonLd,
  breadcrumbJsonLd,
  structuredData,
]);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={seoDescription} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:site_name" content={SEO_SITE_NAME} />
    <meta property="og:locale" content="th_TH" />
    <meta property="og:type" content={pageType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={seoImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={seoImage} />
    <meta name="theme-color" content="#9e2b24" />
    <meta name="application-name" content={SEO_SITE_NAME} />
    <meta name="apple-mobile-web-app-title" content={SEO_SITE_NAME} />
    <PageEntrance />
    <script is:inline>
      document.documentElement.classList.add("cms-navigation-pending");
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" type={brandAssets.favicon.type} sizes={brandAssets.favicon.sizes} href={brandAssets.favicon.src} />
    <link rel="icon" type={brandAssets.favicon192.type} sizes={brandAssets.favicon192.sizes} href={brandAssets.favicon192.src} />
    <link rel="apple-touch-icon" sizes={brandAssets.appleTouchIcon.sizes} href={brandAssets.appleTouchIcon.src} />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans+Thai:wght@400;500;600;700&family=Noto+Sans+Thai:wght@300;400;500;600;700;800;900&family=Prompt:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    {stylesForPath(Astro.url.pathname, page).map((src: string) => <link rel="stylesheet" href={src} />)}
    <script is:inline type="application/ld+json" set:html={jsonLd}></script>
  </head>
  <body class={bodyClass} data-cms-page={page} data-analytics-disabled={analytics ? undefined : "true"}>
    <LoadingScreen />
    <div class="scroll-progress" data-scroll-progress aria-hidden="true">
      <span data-scroll-progress-bar></span>
    </div>
    <Header locale={locale} page={page} />
    <slot />
    <Footer locale={locale} page={page} />

    <script>
      import "../scripts/site.js";
      import "../scripts/cms-runtime.js";
    </script>
    {analytics && <script is:inline>
      (() => {
        const host = window.location.hostname;
        const isVercelHost = host === "mongkolwela.vercel.app" || host.endsWith(".vercel.app");
        if (!isVercelHost) return;

        const injectScript = (src) => {
          const script = document.createElement("script");
          script.defer = true;
          script.src = src;
          document.head.appendChild(script);
        };

        injectScript("https://va.vercel-scripts.com/v1/script.js");
        injectScript("/_vercel/speed-insights/script.js");
      })();
    </script>}
  </body>
</html>
